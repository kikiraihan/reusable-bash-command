# command untuk buat branch baru dari base branch, opsional merge & push
# Fungsi GFB (Git Feature Branch)
# contoh penggunaan:
# gfb master fitur-keren
# gfb -p develop fitur-keren
# gfb -pm dev_sprint_9a dev-cfl-13/@   → "@" = nama branch aktif saat ini (seperti di git)
#                                         jadi dev-cfl-13/@ → dev-cfl-13/<branch-aktif>,
#                                         lalu branch aktif di-merge ke branch baru
# gfb -pmy dev_sprint_9a dev-cfl-13/@  → sama, tanpa konfirmasi
# gfb -n dev_sprint_9a dev-cfl-13/@    → dry-run, hanya tampilkan rencana
# Cara lama ("." dan --merge) masih jalan, tapi akan muncul tips cara barunya.
_gfb_usage() {
  echo "Gunakan: gfb [-p] [-m] [-y] [-n] <base-branch> <nama-branch-baru>"
  echo ""
  echo "  -p   push ke origin + set upstream"
  echo "  -m   merge branch aktif ke branch baru (hanya bersama placeholder @)"
  echo "  -y   tanpa konfirmasi"
  echo "  -n   dry-run, hanya tampilkan rencana"
  echo "  -h   bantuan ini"
  echo "  (flag bisa digabung: -pm, -pmy)"
  echo ""
  echo "  @ = nama branch aktif saat ini. Bisa dipakai sebagai base, nama, atau prefix/@"
  echo ""
  echo "Contoh:"
  echo "  gfb master fitur-login"
  echo "  gfb -p develop fitur-api"
  echo "  gfb -pm dev_sprint_9a dev-cfl-13/@     (dev-cfl-13/<branch-aktif> + merge branch aktif)"
  echo "  gfb -n  dev_sprint_9a dev-cfl-13/@     (lihat rencana saja)"
}

gfb() {
  local push_to_origin=false
  local auto_merge=false
  local assume_yes=false
  local dry_run=false
  local base_branch=""
  local branch_name=""
  local -a legacy_hints=()
  local -a extra_args=()
  local i c

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfb_usage; return 0 ;;
      --push) push_to_origin=true ;;
      --merge) auto_merge=true; legacy_hints+=("--merge → -m (bisa digabung: -pm)") ;;
      --yes) assume_yes=true ;;
      --dry-run) dry_run=true ;;
      --*) echo "❌ Flag tidak dikenal: $1"; echo ""; _gfb_usage; return 1 ;;
      -?*)
        # flag pendek, bisa digabung (mis. -pmy)
        for (( i = 2; i <= ${#1}; i++ )); do
          c=${1[i]}
          case $c in
            p) push_to_origin=true ;;
            m) auto_merge=true ;;
            y) assume_yes=true ;;
            n) dry_run=true ;;
            h) _gfb_usage; return 0 ;;
            *) echo "❌ Flag tidak dikenal: -$c (dari $1)"; echo ""; _gfb_usage; return 1 ;;
          esac
        done
        ;;
      *)
        if [ -z "$base_branch" ]; then
          base_branch="$1"
        elif [ -z "$branch_name" ]; then
          branch_name="$1"
        else
          extra_args+=("$1")
        fi
        ;;
    esac
    shift
  done

  if (( ${#extra_args} )); then
    echo "❌ Argumen berlebih: ${extra_args[*]}"
    echo ""
    _gfb_usage
    return 1
  fi

  if [ -z "$base_branch" ] || [ -z "$branch_name" ]; then
    echo "❌ Base branch dan nama branch baru wajib diisi."
    echo ""
    _gfb_usage
    return 1
  fi

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "❌ Bukan di dalam git repository."
    return 1
  fi

  local current_branch
  current_branch=$(git rev-parse --abbrev-ref HEAD)

  # "@" (atau "." cara lama) = branch aktif saat ini
  local used_placeholder=false
  if [[ "$base_branch" == "@" || "$base_branch" == "." ]]; then
    [ "$base_branch" = "." ] && legacy_hints+=("base \".\" → \"@\"")
    base_branch="$current_branch"
    used_placeholder=true
  fi

  local placeholder_in_name=false
  case $branch_name in
    @|.)
      [ "$branch_name" = "." ] && legacy_hints+=("\".\" → \"@\"")
      branch_name="$current_branch"
      placeholder_in_name=true
      ;;
    */@|*/.)
      [[ "$branch_name" == */. ]] && legacy_hints+=("\"${branch_name}\" → \"${branch_name%.}@\"")
      branch_name="${branch_name%?}$current_branch"
      placeholder_in_name=true
      ;;
  esac
  [ "$placeholder_in_name" = true ] && used_placeholder=true

  # Tips kalau masih pakai cara lama (tetap dijalankan)
  if (( ${#legacy_hints} )); then
    echo "💡 Tips: kamu memakai cara lama. Cara baru:"
    local h
    for h in "${legacy_hints[@]}"; do echo "     $h"; done
    local new_cmd="gfb -"
    [ "$push_to_origin" = true ] && new_cmd+="p"
    [ "$auto_merge" = true ] && new_cmd+="m"
    [ "$assume_yes" = true ] && new_cmd+="y"
    [ "$dry_run" = true ] && new_cmd+="n"
    [ "$new_cmd" = "gfb -" ] && new_cmd="gfb"
    echo "   Contoh: $new_cmd <base> <prefix>/@"
    echo ""
  fi

  if [[ "$used_placeholder" = true && "$current_branch" = "HEAD" ]]; then
    echo "❌ Sedang detached HEAD, placeholder @ tidak bisa dipakai."
    return 1
  fi

  if [[ "$auto_merge" = true && "$placeholder_in_name" != true ]]; then
    echo "❌ -m hanya bisa dipakai bersama placeholder @ di nama branch (mis. prefix/@)."
    echo "   Tanpa @, tidak ada branch yang bisa di-merge."
    return 1
  fi

  if ! git check-ref-format --branch "$branch_name" >/dev/null 2>&1; then
    echo "❌ Nama branch tidak valid: $branch_name"
    return 1
  fi

  if git show-ref --verify --quiet "refs/heads/$branch_name"; then
    echo "❌ Branch '$branch_name' sudah ada secara lokal."
    return 1
  fi

  # Rencana
  local merge_desc="tidak"
  if [ "$placeholder_in_name" = true ]; then
    if [ "$auto_merge" = true ]; then
      merge_desc="$current_branch → $branch_name"
    else
      merge_desc="tidak (tambah -m untuk merge $current_branch)"
    fi
  fi
  echo "📋 Rencana:"
  echo "   base  : $base_branch (pull dari origin)"
  echo "   baru  : $branch_name"
  echo "   merge : $merge_desc"
  echo "   push  : $([ "$push_to_origin" = true ] && echo ya || echo "tidak (tambah -p untuk push)")"

  if [ "$dry_run" = true ]; then
    echo "🧪 Dry-run, tidak ada yang dijalankan."
    return 0
  fi

  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "❌ Ada uncommitted changes di '$current_branch'. Commit atau stash dulu."
    return 1
  fi

  # Konfirmasi hanya kalau memakai placeholder (nama hasil turunan), kecuali -y
  if [[ "$used_placeholder" = true && "$assume_yes" != true ]]; then
    local confirm
    read "confirm?Lanjut? [Y/n]: "
    if [[ "$confirm" == [nN]* ]]; then
      echo "❌ Dibatalkan."
      return 1
    fi
  fi

  echo "🔄 Pulling newest $base_branch..."
  if ! { git checkout "$base_branch" && git pull origin "$base_branch"; }; then
    echo "⚠️  Gagal update $base_branch."
    return 1
  fi

  echo "🌿 Membuat branch: $branch_name dari $base_branch"
  if ! git checkout -b "$branch_name"; then
    echo "❌ Gagal membuat branch $branch_name."
    return 1
  fi

  if [ "$auto_merge" = true ]; then
    echo "🔀 Merge '$current_branch' ke '$branch_name'..."
    if ! git merge "$current_branch"; then
      echo "⚠️  Ada conflict saat merge. Selesaikan manual lalu commit."
      [ "$push_to_origin" = true ] && echo "   Push dibatalkan. Setelah selesai: git push -u origin $branch_name"
      return 1
    fi
  fi

  if [ "$push_to_origin" = true ]; then
    echo "🚀 Push dan set upstream..."
    if ! git push -u origin "$branch_name"; then
      echo "❌ Push gagal. Coba lagi: git push -u origin $branch_name"
      return 1
    fi
    echo "✅ Berhasil dibuat dan di-push!"
  else
    echo "📍 Branch dibuat secara lokal."
    echo "Gunakan: git push -u origin $branch_name"
  fi
}

# Tab completion: base branch dari daftar branch lokal
_gfb_branches() {
  local -a branches
  branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
  _describe 'branch' branches
}
_gfb() {
  _arguments -s \
    '-p[push ke origin]' '-m[merge branch aktif]' '-y[tanpa konfirmasi]' \
    '-n[dry-run]' '-h[bantuan]' \
    '1:base branch:_gfb_branches' \
    '2:nama branch baru:'
}
(( $+functions[compdef] )) && compdef _gfb gfb

# Git Feature Branch Cleaner
# Menghapus branch yang sudah merged ke base branch
# Aman: ignore branch penting + bisa pilih branch
#
# contoh:
# gfbclean master
#
# contoh dengan filter:
# gfbclean master -f kiki
#
# contoh input pilihan:
# 1 3 5
# 1,3,5
# all
#
# output:
# 🗑 Branch yang bisa dihapus:
# [1] feature/login
# [2] feature/payment
# [3] bugfix/token
# Pilih nomor branch (contoh: 1 3 atau 1,3) atau ketik 'all' untuk semua:
gfbclean() {
  local base_branch=""
  local filter=""

  # parse arg
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -f|--filter)
        filter="$2"
        shift
        ;;
      *)
        base_branch="$1"
        ;;
    esac
    shift
  done

  # "." berarti merefer ke branch aktif saat ini
  [ "$base_branch" = "." ] && base_branch=$(git rev-parse --abbrev-ref HEAD)

  if [ -z "$base_branch" ]; then
    echo "❌ Gunakan: gfbclean <base-branch> [-f keyword]"
    return 1
  fi

  local original_branch=$(git rev-parse --abbrev-ref HEAD)

  # Tangkap Ctrl+C: balik ke branch semula sebelum exit
  trap "echo ''; echo '🔙 Kembali ke branch: $original_branch'; git checkout \"$original_branch\"; trap - INT; return 1" INT

  echo "🔄 Pulling newest $base_branch..."
  git checkout "$base_branch" && git pull origin "$base_branch" || { trap - INT; return 1; }

  echo "🔍 Mencari branch yang sudah merged ke $base_branch..."
  local branches
  branches=$(git branch --merged "$base_branch" \
    | sed 's/^[* ]*//' \
    | grep -vE '^(master|main|develop|staging|production)$')

  if [ -n "$filter" ]; then
    branches=$(echo "$branches" | grep "$filter")
  fi

  if [ -z "$branches" ]; then
    echo "✅ Tidak ada branch yang cocok untuk dibersihkan."
    trap - INT
    return 0
  fi

  echo ""
  echo "🗑 Branch yang bisa dihapus:"
  local i=1
  declare -a branch_list
  while read -r branch; do
    echo "[$i] $branch"
    branch_list[$i]="$branch"
    ((i++))
  done <<< "$branches"

  echo ""
  read "selection?Pilih nomor branch (contoh: 1,3 atau 1,3,5) atau ketik 'all' untuk semua: "

  # ubah koma jadi spasi lalu split ke array (zsh-safe)
  local selection_clean=$(echo "$selection" | tr ',' ' ')
  local -a nums
  read -A nums <<< "$selection_clean"

  local -a selected_branches
  if [[ "$selection" == "all" ]]; then
    selected_branches=("${branch_list[@]}")
  else
    for num in "${nums[@]}"; do
      [[ "$num" =~ ^[0-9]+$ ]] && selected_branches+=("${branch_list[$num]}")
    done
  fi

  echo ""
  echo "Branch yang akan dihapus:"
  for b in "${selected_branches[@]}"; do
    [ -z "$b" ] && continue
    echo "- $b"
  done

  echo ""
  read "confirm?Lanjutkan hapus branch di atas? (y/N): "
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "❌ Dibatalkan."
    trap - INT
    return 0
  fi

  for branch in "${selected_branches[@]}"; do
    [ -z "$branch" ] && continue
    echo "➡️ Hapus local: $branch"
    git branch -d "$branch"
    echo "➡️ Hapus origin: $branch"
    git push origin --delete "$branch"
  done

  echo "✅ Selesai membersihkan branch."
  echo ""
  echo "🔙 Kembali ke branch: $original_branch"
  git checkout "$original_branch"
  trap - INT  # reset trap setelah selesai normal
}

# Git Feature Branch Checker
# Menampilkan branch yang BELUM merged ke base branch
# Aman: ignore branch penting
#
# contoh:
# gfbcheck master
#
# contoh dengan filter:
# gfbcheck master -f kiki
#
# output:
# 🌿 Branch yang belum merged ke master:
# [1] feature/login
# [2] feature/payment
# [3] bugfix/token
gfbcheck() {
  local base_branch=""
  local filter=""

  # parse arg
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -f|--filter)
        filter="$2"
        shift
        ;;
      *)
        base_branch="$1"
        ;;
    esac
    shift
  done

  # "." berarti merefer ke branch aktif saat ini
  [ "$base_branch" = "." ] && base_branch=$(git rev-parse --abbrev-ref HEAD)

  if [ -z "$base_branch" ]; then
    echo "❌ Gunakan: gfbcheck <base-branch> [-f keyword]"
    return 1
  fi

  local original_branch=$(git rev-parse --abbrev-ref HEAD)

  echo "🔄 Pulling newest $base_branch..."
  git checkout "$base_branch" && git pull origin "$base_branch" || return 1

  echo "🔍 Mencari branch yang belum merged ke $base_branch..."
  local branches
  branches=$(git branch --no-merged "$base_branch" \
    | sed 's/^[* ]*//' \
    | grep -vE '^(master|main|develop|staging|production)$')

  if [ -n "$filter" ]; then
    branches=$(echo "$branches" | grep "$filter")
  fi

  if [ -z "$branches" ]; then
    echo "✅ Semua branch sudah merged ke $base_branch."
    return 0
  fi

  echo ""
  echo "🌿 Branch yang belum merged ke $base_branch:"
  local i=1
  while read -r branch; do
    echo "[$i] $branch"
    ((i++))
  done <<< "$branches"

  echo ""
  echo "Total: $((i-1)) branch"
  echo ""
  echo "🔙 Kembali ke branch: $original_branch"
  git checkout "$original_branch"
}

# gfblog master                        → compare master vs current branch
# gfblog master feature/login          → compare master vs feature/login
gfblog() {
  local base_branch="${1:-master}"
  local target_branch="${2:-$(git rev-parse --abbrev-ref HEAD)}"

  # "." berarti merefer ke branch aktif saat ini
  [ "$base_branch" = "." ] && base_branch=$(git rev-parse --abbrev-ref HEAD)
  [ "$target_branch" = "." ] && target_branch=$(git rev-parse --abbrev-ref HEAD)

  if [ "$target_branch" = "$base_branch" ]; then
    echo "⚠️  Target branch sama dengan base branch ($base_branch)."
    return 1
  fi

  local commits=$(git log "$base_branch".."$target_branch" --oneline --no-decorate)

  if [ -z "$commits" ]; then
    echo "✅ Tidak ada commit baru dibanding $base_branch."
    return 0
  fi

  echo ""
  echo "🌿 Target branch : $target_branch"
  echo "📌 Base branch   : $base_branch"
  echo ""
  echo "📋 Commit yang belum ada di $base_branch:"
  echo "$commits" | while read -r line; do
    echo "  - $line"
  done
  echo ""
  echo "Total: $(echo "$commits" | wc -l | tr -d ' ') commit"
}

# Git Feature Branch Find Commit
# Mencari commit hash ada di branch mana saja
# Opsional: -r untuk cek remote branches juga
#
# contoh:
# gfbfind 56c97cde945a078ee1525a20acc9ea0927c5580b
# gfbfind 56c97cde -r
# gfbfind 56c97cde -f feature
gfbfind() {
  local commit_hash=""
  local include_remote=false
  local filter=""

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -r|--remote) include_remote=true ;;
      -f|--filter)
        filter="$2"
        shift
        ;;
      *)
        if [ -z "$commit_hash" ]; then
          commit_hash="$1"
        fi
        ;;
    esac
    shift
  done

  # Validasi input
  if [ -z "$commit_hash" ]; then
    echo "❌ Gunakan: gfbfind <commit-hash> [-r] [-f keyword]"
    echo "Contoh:"
    echo "  gfbfind 56c97cde"
    echo "  gfbfind 56c97cde945a078ee1525a20acc9ea0927c5580b -r"
    echo "  gfbfind 56c97cde -f feature"
    return 1
  fi

  # Validasi commit hash exist
  if ! git cat-file -e "$commit_hash^{commit}" 2>/dev/null; then
    echo "❌ Commit '$commit_hash' tidak ditemukan di repo ini."
    return 1
  fi

  local short_hash=$(git rev-parse --short "$commit_hash")
  local commit_msg=$(git log -1 --pretty=format:"%s" "$commit_hash")

  echo ""
  echo "🔍 Mencari commit: $short_hash"
  echo "📝 Pesan        : $commit_msg"
  echo ""

  # Tentukan flag: local saja atau termasuk remote
  local branch_flag=""
  if [ "$include_remote" = true ]; then
    echo "🌐 Mode: local + remote branches"
    branch_flag="-a"  # all: local + remote
  else
    echo "💻 Mode: local branches saja (gunakan -r untuk remote)"
    branch_flag=""    # default: local only
  fi
  echo ""

  # Cari branch yang mengandung commit ini
  local found_branches
  found_branches=$(git branch $branch_flag --contains "$commit_hash" \
    | sed 's/^[* ]*//' \
    | sed 's|^remotes/||')  # rapikan prefix remotes/

  if [ -n "$filter" ]; then
    found_branches=$(echo "$found_branches" | grep "$filter")
  fi

  if [ -z "$found_branches" ]; then
    echo "⚠️  Commit tidak ditemukan di branch manapun."
    return 0
  fi

  local count=$(echo "$found_branches" | wc -l | tr -d ' ')

  echo "✅ Ditemukan di $count branch:"
  echo ""
  local i=1
  while read -r branch; do
    [ -z "$branch" ] && continue
    echo "  [$i] $branch"
    ((i++))
  done <<< "$found_branches"
  echo ""
}

# Git Feature Branch List
# Menampilkan list branch yang mengandung keyword tertentu,
# diurutkan dari yang terakhir digunakan (checkout / commit terbaru di atas)
# Opsional: -r untuk include remote branches juga
#
# contoh:
# gfbls kiki
# gfbls kiki -r
gfbls() {
  local keyword=""
  local include_remote=false

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -r|--remote) include_remote=true ;;
      *)
        if [ -z "$keyword" ]; then
          keyword="$1"
        fi
        ;;
    esac
    shift
  done

  # Jika tidak ada keyword, tampil semua branch
  # keyword kosong = grep akan match semua baris

  # Ambil local branches
  local local_branches
  local_branches=$(git branch \
    | sed 's/^[* ]*//' \
    | grep "$keyword")

  # Ambil remote branches (selalu, untuk keperluan cek & mode -r)
  local remote_branches
  remote_branches=$(git branch -r \
    | sed 's/^[* ]*//' \
    | sed 's/^origin\///' \
    | grep -v 'HEAD' \
    | grep "$keyword")

  # Tentukan sumber data sesuai mode
  local all_branches
  if [ "$include_remote" = true ]; then
    all_branches=$(printf "%s\n%s\n" "$local_branches" "$remote_branches" \
      | grep -v '^$' | sort -u)
  else
    all_branches="$local_branches"
  fi

  if [ -z "$all_branches" ]; then
    echo "⚠️  Tidak ada branch yang mengandung keyword: '$keyword'"
    return 0
  fi

  local keyword_label="${keyword:-semua}"
  local count=$(echo "$all_branches" | grep -c .)
  local mode="local"
  [ "$include_remote" = true ] && mode="local + remote"

  echo ""
  echo "🔍 Keyword  : $keyword_label"
  echo "🌐 Mode     : $mode"
  echo "📋 Ditemukan: $count branch"
  echo ""

  # Fetch dulu supaya info remote fresh
  echo "🔄 Fetching origin..."
  git fetch --quiet 2>/dev/null

  # Waktu checkout terakhir per branch dari reflog HEAD (baris pertama = terbaru)
  local checkout_times
  checkout_times=$(git reflog show HEAD --date=unix --format='%gd %gs' 2>/dev/null \
    | awk '/checkout: moving from/ && !seen[$NF]++ {sub(/.*@\{/, "", $1); sub(/\}.*/, "", $1); print $1, $NF}')
  local current_branch=$(git branch --show-current 2>/dev/null)

  # Hitung waktu terakhir digunakan tiap branch, lalu urutkan terbaru di atas
  # last used = max(checkout terakhir, update ref terakhir di reflog, commit terakhir)
  local now=$(date +%s)
  local sorted_branches
  sorted_branches=$(while read -r branch; do
    [ -z "$branch" ] && continue
    local ts=0
    if [ "$branch" = "$current_branch" ]; then
      ts=$(( now + 1 ))  # branch aktif selalu paling atas
    elif git show-ref --verify --quiet "refs/heads/$branch"; then
      local t_checkout=$(echo "$checkout_times" | awk -v b="$branch" '$2 == b {print $1; exit}')
      local t_reflog=$(git reflog show "refs/heads/$branch" -1 --date=unix --format='%gd' 2>/dev/null | sed -n 's/.*@{\([0-9]*\)}$/\1/p')
      local t_commit=$(git log -1 --format='%ct' "refs/heads/$branch" 2>/dev/null)
      for t in $t_checkout $t_reflog $t_commit; do
        [ "$t" -gt "$ts" ] 2>/dev/null && ts=$t
      done
    else
      ts=$(git log -1 --format='%ct' "refs/remotes/origin/$branch" 2>/dev/null)
    fi
    printf "%s\t%s\n" "${ts:-0}" "$branch"
  done <<< "$all_branches" | sort -t $'\t' -k1,1nr)

  # Awal hari ini (00:00) untuk menentukan "kemarin"
  local today_start=$(( now - 10#$(date +%H) * 3600 - 10#$(date +%M) * 60 - 10#$(date +%S) ))

  local i=1
  while IFS=$'\t' read -r ts branch; do
    [ -z "$branch" ] && continue

    # Format waktu relatif
    local when=""
    local diff=$(( now - ts ))
    if [ "$branch" = "$current_branch" ]; then
      when="sedang aktif"
    elif [ "$ts" -le 0 ] 2>/dev/null; then
      when="tidak diketahui"
    elif [ "$diff" -lt 60 ]; then
      when="baru saja"
    elif [ "$diff" -lt 3600 ]; then
      when="$(( diff / 60 )) menit yang lalu"
    elif [ "$ts" -ge "$today_start" ]; then
      when="$(( diff / 3600 )) jam yang lalu"
    elif [ "$ts" -ge $(( today_start - 86400 )) ]; then
      when="kemarin $(date -d "@$ts" +%H:%M 2>/dev/null || date -r "$ts" +%H:%M)"
    elif [ "$ts" -ge $(( today_start - 6 * 86400 )) ]; then
      when="$(( (today_start - ts) / 86400 + 1 )) hari yang lalu"
    else
      when=$(date -d "@$ts" '+%d %b %Y' 2>/dev/null || date -r "$ts" '+%d %b %Y')
    fi

    local has_local=false
    local has_remote=false
    echo "$local_branches"  | grep -qx "$branch" && has_local=true
    echo "$remote_branches" | grep -qx "$branch" && has_remote=true

    if $has_local && $has_remote; then
      # Hitung ahead/behind
      local ahead=$(git rev-list --count "origin/$branch".."$branch" 2>/dev/null)
      local behind=$(git rev-list --count "$branch".."origin/$branch" 2>/dev/null)
      local sync_info=""
      [ "$ahead" -gt 0 ] 2>/dev/null  && sync_info+=" ↑${ahead}"
      [ "$behind" -gt 0 ] 2>/dev/null && sync_info+=" ↓${behind}"
      [ -z "$sync_info" ] && sync_info=" ✓"
      echo "  [$i] $branch$sync_info  🕒 $when"
      echo "       └─ origin/$branch"
    elif $has_local; then
      echo "  [$i] $branch  (local only — belum pernah push)  🕒 $when"
    else
      echo "  [$i] origin/$branch  (remote only — belum di-fetch lokal)  🕒 $when"
    fi
    ((i++))
  done <<< "$sorted_branches"
  echo ""
  echo "  ↑ = commit lokal belum di-push   ↓ = commit remote belum di-pull   ✓ = sinkron"
  echo "  🕒 = terakhir digunakan (checkout / commit terakhir), terbaru di atas"
  echo ""
}

