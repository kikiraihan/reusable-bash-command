import sys, json
try:
  d = json.loads(sys.argv[2])
except Exception:
  print('❌ Response bukan JSON:', sys.argv[2][:300], file=sys.stderr); sys.exit(1)
err = d.get('error')
if err:
  msg = err.get('message', err) if isinstance(err, dict) else err
