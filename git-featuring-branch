gfbpr() {
  local base_branch="master"
  local target_branch=$(git rev-parse --abbrev-ref HEAD)
  local provider="groq"  # default provider
  local model=""         # kosong = pakai default per provider

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -p|--provider)
        provider="$2"
        shift
        ;;
      -m|--model)
        model="$2"
        shift
        ;;
      *)
        # "." berarti merefer ke branch aktif saat ini
        local arg="$1"
        [ "$arg" = "." ] && arg=$(git rev-parse --abbrev-ref HEAD)
        if [[ "$arg" != -* ]] && git rev-parse --verify "$arg" &>/dev/null; then
          if [[ "$arg" == "master" || "$arg" == "main" || "$arg" == "develop" ]]; then
            base_branch="$arg"
          else
            target_branch="$arg"
          fi
        fi
        ;;
    esac
    shift
  done

  # Set default model per provider
  if [ -z "$model" ]; then
    case "$provider" in
      groq)   model="openai/gpt-oss-120b" ;;
      gemini) model="gemini-2.0-flash" ;;
      *)
        echo "❌ Provider tidak dikenal: '$provider'. Pilih: groq / gemini"
