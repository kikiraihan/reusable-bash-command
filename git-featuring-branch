  _gfb_sec "Argumen"
  _gfb_opt "<base-branch>" "branch pembanding (@ = branch aktif)"
  _gfb_sec "Opsi"
  _gfb_opt "-f, --filter" "hanya branch yang mengandung keyword"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfbcheck master"
  _gfb_ex "gfbcheck develop -f bugfix" "hanya yang mengandung 'bugfix'"
