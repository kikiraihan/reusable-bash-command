# setup AI provider untuk gfbpr
# Groq  → daftar gratis di https://console.groq.com
# Gemini → daftar gratis di https://aistudio.google.com/apikey
export GROQ_API_KEY="***"
export GEMINI_API_KEY="***"

# ════════════════════════════════════════════════════════════════════
# GFB — Git Feature Branch Toolkit
#   gfbmain             → ringkasan semua perintah
#   gfbmain help <cmd>  → bantuan detail (sama dengan <cmd> -h)
#   @ (atau ".")     → nama branch aktif saat ini
# ════════════════════════════════════════════════════════════════════

# ── UI helpers ──────────────────────────────────────────────────────
# Satu gaya untuk semua perintah gfb*:
#   ◆ judul   › langkah   ✔ sukses   ▲ peringatan   ✖ error   ℹ info   ? pertanyaan
#   Simbol di kolom 2, isi/detail di kolom 4, label key-value redup & rata kiri.
# Warna otomatis mati kalau output bukan terminal atau NO_COLOR di-set
# (GFB_FORCE_COLOR=1 untuk memaksa, dipakai mode watch gfbstatus).
_gfb_color_on() { [[ -z "$NO_COLOR" ]] && [[ -t 1 || -n "$GFB_FORCE_COLOR" ]]; }

# Isi variabel warna milik pemanggil (pemanggil: local B D N G R Y C M; _gfb_pal)
_gfb_pal() {
  if _gfb_color_on; then
    _GFB_AFTER_HEAD=''
    B=$'\e[1m' D=$'\e[2m' N=$'\e[0m' G=$'\e[32m' R=$'\e[31m' Y=$'\e[33m' C=$'\e[36m' M=$'\e[35m'
  else
    _GFB_AFTER_HEAD=''
    B='' D='' N='' G='' R='' Y='' C='' M=''
  fi
}

# _GFB_AFTER_HEAD: section tepat setelah judul tidak perlu baris kosong lagi
_gfb_head()   { local B D N G R Y C M; _gfb_pal; print; print -r -- "  ${C}◆${N} ${B}$1${N}${2:+  ${D}$2${N}}"; print; _GFB_AFTER_HEAD=1; }
_gfb_sec()    { local B D N G R Y C M after=$_GFB_AFTER_HEAD; _gfb_pal; [ -z "$after" ] && print; print -r -- "  ${B}$1${N}${2:+  ${D}$2${N}}"; }
_gfb_kv()     { local B D N G R Y C M; _gfb_pal; printf "    ${D}%-9s${N} %s\n" "$1" "$2"; }
_gfb_step()   { local B D N G R Y C M; _gfb_pal; print -r -- "  ${C}›${N} $*"; }
_gfb_ok()     { local B D N G R Y C M; _gfb_pal; print -r -- "  ${G}✔${N} $*"; }
_gfb_warn()   { local B D N G R Y C M; _gfb_pal; print -r -- "  ${Y}▲${N} $*"; }
_gfb_err()    { local B D N G R Y C M; _gfb_pal; print -r -- "  ${R}✖${N} $*" >&2; }
_gfb_info()   { local B D N G R Y C M; _gfb_pal; print -r -- "  ${C}ℹ${N} $*"; }
_gfb_text()   { print -r -- "    $*"; }
_gfb_note()   { local B D N G R Y C M; _gfb_pal; print -r -- "    ${D}$*${N}"; }
_gfb_item()   { local B D N G R Y C M; _gfb_pal; printf "    ${D}%3s${N}  %s\n" "$1" "$2"; }
_gfb_bullet() { local B D N G R Y C M; _gfb_pal; print -r -- "    ${D}•${N} $*"; }
_gfb_hint()   { local B D N G R Y C M; _gfb_pal; print -r -- "    ${D}→${N} ${C}$1${N}${2:+  ${D}$2${N}}"; }
_gfb_rule()   { local B D N G R Y C M; _gfb_pal; print -r -- "  ${D}────────────────────────────────────────────────────────${N}"; }

# Error argumen + arahkan ke bantuan: _gfb_bad <perintah> <pesan>
_gfb_bad() { _gfb_err "$2"; _gfb_note "Lihat bantuan: $1 -h" >&2; }

# Hapus 1 baris terakhir (untuk menghapus baris "› Generating…")
_gfb_unwait() { [[ -t 1 ]] && printf '\e[1A\e[2K'; }

# _gfb_confirm "pertanyaan" [y|n]  → return 0 kalau jawab ya (default n)
_gfb_confirm() {
  local B D N G R Y C M; _gfb_pal
  local def=${2:-n} ans hint="[y/N]"
  [ "$def" = y ] && hint="[Y/n]"
  print
  read "ans?  ${M}?${N} ${B}$1${N} ${D}$hint${N} "
  [ -z "$ans" ] && ans=$def
  [[ "$ans" == [yY]* ]]
}

# _gfb_ask <nama-var> "pertanyaan" [petunjuk]  → jawaban disimpan ke <nama-var>
_gfb_ask() {
  local B D N G R Y C M; _gfb_pal
  print
  read "$1?  ${M}?${N} ${B}$2${N}${3:+ ${D}$3${N}} "
}

_gfb_copy() { printf '%s' "$1" | pbcopy && _gfb_ok "Sudah di-copy ke clipboard."; }

# Bantuan: _gfb_use "<pemakaian>", _gfb_opt "<flag>" "<arti>", _gfb_ex "<contoh>" ["<arti>"]
_gfb_use() { local B D N G R Y C M; _gfb_pal; print -r -- "    ${B}$*${N}"; }
_gfb_opt() { local B D N G R Y C M; _gfb_pal; printf "    ${C}%-20s${N} %s\n" "$1" "$2"; }
_gfb_ex() {
  local B D N G R Y C M; _gfb_pal
  if [ -z "$2" ]; then
    print -r -- "    $1"
  elif (( ${#1} <= 40 )); then
    printf "    %-40s ${D}%s${N}\n" "$1" "$2"
  else
    print -r -- "    $1"
    printf "    %-40s ${D}%s${N}\n" "" "$2"
  fi
}

# ── Git helpers ─────────────────────────────────────────────────────
GFB_PROTECTED='^(master|main|develop|staging|production)$'

_gfb_repo() { git rev-parse --git-dir >/dev/null 2>&1 && return 0; _gfb_err "Bukan di dalam git repository."; return 1; }
_gfb_cur()  { git rev-parse --abbrev-ref HEAD 2>/dev/null; }
# "@" atau "." (cara lama) = branch aktif saat ini
_gfb_ref()  { if [[ "$1" == "@" || "$1" == "." ]]; then _gfb_cur; else print -r -- "$1"; fi; }

# Daftar commit rapi: "hash  pesan · waktu · author", argumen diteruskan ke git log
_gfb_commits() {
  local B D N G R Y C M; _gfb_pal
  git log --no-decorate --format="    ${Y}%h${N}  %s ${D}· %cr · %an${N}" "$@" 2>/dev/null
}

# Cetak hasil "git diff --name-status" berwarna + ringkasan per status
_gfb_ns_list() {
  local B D N G R Y C M; _gfb_pal
  local -a rows=(${(f)1}) parts=()
  local -A cnt label
  label=(M diubah A baru D dihapus R rename C copy T tipe U conflict)
  local row st f color
  for row in "${rows[@]}"; do
    st=${row[1]}
    f=${row#*$'\t'}
    f=${f//$'\t'/ → }
    case $st in
      A) color=$G ;; D) color=$R ;; R|C) color=$C ;; M) color=$Y ;; *) color=$D ;;
    esac
    cnt[$st]=$(( ${cnt[$st]:-0} + 1 ))
    print -r -- "    ${color}${st}${N}  $f"
  done
  for st in M A D R C T U; do
    (( ${cnt[$st]:-0} )) && parts+=("${cnt[$st]} ${label[$st]}")
  done
  print
  print -r -- "    ${D}${#rows} file · ${(j: · :)parts}${N}"
}

# Ubah selisih detik jadi teks relatif, mis. "3 jam lalu"
_gfb_ago() {
  local s=$1
  if   (( s < 60 ));    then echo "baru saja"
  elif (( s < 3600 ));  then echo "$(( s / 60 )) menit lalu"
  elif (( s < 86400 )); then echo "$(( s / 3600 )) jam lalu"
  else                       echo "$(( s / 86400 )) hari lalu"
  fi
}

# ── AI helpers (Groq / Gemini) ──────────────────────────────────────
# Model default per provider
_gfb_ai_model() {
  case "$1" in
    groq)   print -r -- "openai/gpt-oss-120b" ;;
    gemini) print -r -- "gemini-2.0-flash" ;;
    *) _gfb_err "Provider tidak dikenal: '$1'. Pilih: groq / gemini"; return 1 ;;
  esac
}

# Cek API key provider; _gfb_ai_key <provider> [quiet]
_gfb_ai_key() {
  local var url sample
  case "$1" in
    groq)   var=GROQ_API_KEY;   url=https://console.groq.com;           sample=gsk_xxxxxx ;;
    gemini) var=GEMINI_API_KEY; url=https://aistudio.google.com/apikey; sample=AIza_xxxxxx ;;
    *) return 1 ;;
  esac
  [ -n "${(P)var}" ] && return 0
  [ "$2" = quiet ] && return 1
  _gfb_err "$var belum di-set."
  _gfb_note "Daftar gratis di $url, lalu:" >&2
  _gfb_note "export $var=\"$sample\"" >&2
  return 1
}

# Kirim prompt ke provider AI, cetak hasilnya. Return 1 kalau error.
# _gfb_ai_generate <provider> <model> <prompt> [temperature]
_gfb_ai_generate() {
  local provider="$1" model="$2" prompt="$3" temp="${4:-0.2}"
  local json_payload response out

  if [ "$provider" = "groq" ]; then
    json_payload=$(python3 -c "
import sys, json
print(json.dumps({
    'model': sys.argv[2],
    'messages': [{'role': 'user', 'content': sys.argv[1]}],
    'temperature': float(sys.argv[3])
}))
" "$prompt" "$model" "$temp" 2>/dev/null)

    # curl yang kirim (urllib diblokir Cloudflare 403)
    response=$(curl -s https://api.groq.com/openai/v1/chat/completions \
      -H "Authorization: Bearer $GROQ_API_KEY" \
      -H "Content-Type: application/json" \
      -d "$json_payload")
  else
    json_payload=$(python3 -c "
import sys, json
print(json.dumps({
    'contents': [{'parts': [{'text': sys.argv[1]}]}],
    'generationConfig': {'temperature': float(sys.argv[2])}
}))
" "$prompt" "$temp" 2>/dev/null)

    response=$(curl -s "https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=$GEMINI_API_KEY" \
      -H "Content-Type: application/json" \
      -d "$json_payload")
  fi

  # Ambil teks hasil (hapus code fence kalau model membungkus pakai ```)
  out=$(python3 -c "
import sys, json
try:
  d = json.loads(sys.argv[2])
except Exception:
  print('Response bukan JSON:', sys.argv[2][:300]); sys.exit(1)
err = d.get('error')
if err:
  msg = err.get('message', err) if isinstance(err, dict) else err
  print('API error:', msg); sys.exit(1)
try:
  if sys.argv[1] == 'groq':
    text = d['choices'][0]['message']['content']
  else:
    text = d['candidates'][0]['content']['parts'][0]['text']
except Exception as e:
  print('Parse error:', e); sys.exit(1)
lines = [l.rstrip() for l in text.strip().splitlines() if not l.strip().startswith('\`\`\`')]
print('\n'.join(lines).strip())
" "$provider" "$response") || { _gfb_err "$out"; return 1; }
  print -r -- "$out"
}

# ════════════════════════════════════════════════════════════════════
# gfb — buat branch baru dari base branch, opsional merge & push
#   gfb master fitur-keren
#   gfb -p develop fitur-keren
#   gfb -pm dev_sprint_9a dev-cfl-13/@   → @ = branch aktif, lalu branch aktif di-merge
#   gfb -pmy dev_sprint_9a dev-cfl-13/@  → sama, tanpa konfirmasi
#   gfb -n dev_sprint_9a dev-cfl-13/@    → dry-run, hanya tampilkan rencana
# Kalau branch tujuan sudah ada (lokal/origin) → ditawarkan replace:
# hapus branch lama lalu buat ulang. Cara lama ("." dan --merge) masih jalan.
# ════════════════════════════════════════════════════════════════════
_gfb_usage() {
  _gfb_head "gfb" "buat branch baru dari base branch"
  _gfb_sec "Untuk apa"
  _gfb_text "Membuat branch baru dari base branch yang sudah di-pull terbaru."
  _gfb_text "Bisa sekaligus merge branch aktif ke branch baru (mis. branch fix-conflict"
  _gfb_text "per sprint) dan push ke origin. Kalau branch sudah ada, ditawarkan replace."
  _gfb_sec "Pemakaian"
  _gfb_use "gfb [-p] [-m] [-y] [-n] <base-branch> <nama-branch-baru>"
  _gfb_sec "Argumen"
  _gfb_opt "<base-branch>" "branch asal, di-pull dulu dari origin (@ = branch aktif)"
  _gfb_opt "<nama-branch-baru>" "nama branch baru; prefix/@ → prefix/<branch-aktif>"
  _gfb_sec "Opsi"
  _gfb_opt "-p" "push ke origin + set upstream"
  _gfb_opt "-m" "merge branch aktif ke branch baru (wajib pakai @ di nama)"
  _gfb_opt "-y" "tanpa konfirmasi (replace tetap ditanya)"
  _gfb_opt "-n" "dry-run, hanya tampilkan rencana"
  _gfb_opt "-h" "bantuan ini"
  _gfb_note "flag bisa digabung: -pm, -pmy"
  _gfb_sec "Placeholder"
  _gfb_opt "@" "nama branch aktif — bisa sebagai base, nama, atau prefix/@"
  _gfb_sec "Contoh"
  _gfb_ex "gfb master fitur-login" "branch lokal saja"
  _gfb_ex "gfb -p develop fitur-api" "buat + push"
  _gfb_ex "gfb -pm dev_sprint_9a dev-cfl-13/@" "dev-cfl-13/<aktif> + merge branch aktif"
  _gfb_ex "gfb -n dev_sprint_9a dev-cfl-13/@" "lihat rencana saja"
  _gfb_sec "Branch sudah ada?"
  _gfb_note "Ditawarkan replace: hapus branch lama (lokal + origin) lalu buat ulang."
  print
}

gfb() {
  local push_to_origin=false auto_merge=false assume_yes=false dry_run=false
  local base_branch="" branch_name=""
  local -a legacy_hints=() extra_args=()
  local i c

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfb_usage; return 0 ;;
      --push) push_to_origin=true ;;
      --merge) auto_merge=true; legacy_hints+=("--merge → -m (bisa digabung: -pm)") ;;
      --yes) assume_yes=true ;;
      --dry-run) dry_run=true ;;
      --*) _gfb_bad gfb "Flag tidak dikenal: $1"; return 1 ;;
      -?*)
        # flag pendek, bisa digabung (mis. -pmy)
        for (( i = 2; i <= ${#1}; i++ )); do
          c=${1[i]}
          case $c in
            p) push_to_origin=true ;;
            m) auto_merge=true ;;
            y) assume_yes=true ;;
            n) dry_run=true ;;
            h) _gfb_usage; return 0 ;;
            *) _gfb_bad gfb "Flag tidak dikenal: -$c (dari $1)"; return 1 ;;
          esac
        done
        ;;
      *)
        if [ -z "$base_branch" ]; then
          base_branch="$1"
        elif [ -z "$branch_name" ]; then
          branch_name="$1"
        else
          extra_args+=("$1")
        fi
        ;;
    esac
    shift
  done

  if (( ${#extra_args} )); then
    _gfb_bad gfb "Argumen berlebih: ${extra_args[*]}"
    return 1
  fi
  if [ -z "$base_branch" ] || [ -z "$branch_name" ]; then
    _gfb_bad gfb "Base branch dan nama branch baru wajib diisi."
    return 1
  fi
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local current_branch=$(_gfb_cur)

  # "@" (atau "." cara lama) = branch aktif saat ini
  local used_placeholder=false
  if [[ "$base_branch" == "@" || "$base_branch" == "." ]]; then
    [ "$base_branch" = "." ] && legacy_hints+=("base \".\" → \"@\"")
    base_branch="$current_branch"
    used_placeholder=true
  fi

  local placeholder_in_name=false
  case $branch_name in
    @|.)
      [ "$branch_name" = "." ] && legacy_hints+=("\".\" → \"@\"")
      branch_name="$current_branch"
      placeholder_in_name=true
      ;;
    */@|*/.)
      [[ "$branch_name" == */. ]] && legacy_hints+=("\"${branch_name}\" → \"${branch_name%.}@\"")
      branch_name="${branch_name%?}$current_branch"
      placeholder_in_name=true
      ;;
  esac
  [ "$placeholder_in_name" = true ] && used_placeholder=true

  # Tips kalau masih pakai cara lama (tetap dijalankan)
  if (( ${#legacy_hints} )); then
    local new_cmd="gfb -" h
    [ "$push_to_origin" = true ] && new_cmd+="p"
    [ "$auto_merge" = true ] && new_cmd+="m"
    [ "$assume_yes" = true ] && new_cmd+="y"
    [ "$dry_run" = true ] && new_cmd+="n"
    [ "$new_cmd" = "gfb -" ] && new_cmd="gfb"
    print
    _gfb_info "Kamu memakai cara lama (tetap dijalankan). Cara baru:"
    for h in "${legacy_hints[@]}"; do _gfb_note "$h"; done
    _gfb_note "contoh: $new_cmd <base> <prefix>/@"
  fi

  if [[ "$used_placeholder" = true && "$current_branch" = "HEAD" ]]; then
    _gfb_err "Sedang detached HEAD, placeholder @ tidak bisa dipakai."
    return 1
  fi
  if [[ "$auto_merge" = true && "$placeholder_in_name" != true ]]; then
    _gfb_err "-m hanya bisa dipakai bersama placeholder @ di nama branch (mis. prefix/@)."
    _gfb_note "Tanpa @, tidak ada branch yang bisa di-merge." >&2
    return 1
  fi
  if ! git check-ref-format --branch "$branch_name" >/dev/null 2>&1; then
    _gfb_err "Nama branch tidak valid: $branch_name"
    return 1
  fi

  # Branch sudah ada (lokal / origin) → tawarkan replace: hapus lalu buat ulang
  local exists_local=false exists_remote=false replace_existing=false existing_where=""
  git show-ref --verify --quiet "refs/heads/$branch_name" && exists_local=true
  git ls-remote --exit-code --heads origin "$branch_name" >/dev/null 2>&1 && exists_remote=true
  if [[ "$exists_local" = true || "$exists_remote" = true ]]; then
    if [[ "$branch_name" = "$current_branch" || "$branch_name" = "$base_branch" ]]; then
      _gfb_err "Branch '$branch_name' sudah ada dan sedang dipakai (aktif/base), tidak bisa di-replace."
      return 1
    fi
    [ "$exists_local" = true ] && existing_where="lokal"
    [ "$exists_remote" = true ] && existing_where="${existing_where:+$existing_where + }origin"
    replace_existing=true
  fi

  # ── Rencana ──
  local merge_desc="${D}tidak${N}"
  if [ "$placeholder_in_name" = true ]; then
    if [ "$auto_merge" = true ]; then
      merge_desc="$current_branch ${D}→ branch baru${N}"
    else
      merge_desc="${D}tidak — tambah -m untuk merge $current_branch${N}"
    fi
  fi

  _gfb_head "gfb" "buat branch baru"
  _gfb_kv "base" "$base_branch  ${D}(pull dari origin)${N}"
  _gfb_kv "branch" "${B}$branch_name${N}"
  _gfb_kv "merge" "$merge_desc"
  _gfb_kv "push" "$([ "$push_to_origin" = true ] && echo "ya" || echo "${D}tidak — tambah -p untuk push${N}")"

  if [ "$replace_existing" = true ]; then
    print
    _gfb_warn "Branch ini sudah ada ${D}($existing_where)${N}"
    [ "$exists_local" = true ] && _gfb_note "commit terakhir: $(git log -1 --format='%h %s · %cr' "$branch_name")"
    _gfb_note "replace = hapus branch lama ($existing_where), lalu buat ulang dari $base_branch"
  fi

  if [ "$dry_run" = true ]; then
    print
    _gfb_info "Dry-run — tidak ada yang dijalankan."
    print
    return 0
  fi

  if ! git diff --quiet || ! git diff --cached --quiet; then
    print
    _gfb_err "Ada uncommitted changes di '$current_branch'. Commit atau stash dulu."
    return 1
  fi

  # Replace selalu minta konfirmasi (walau -y), karena menghapus branch.
  # Selain itu konfirmasi hanya kalau memakai placeholder (nama hasil turunan), kecuali -y.
  if [ "$replace_existing" = true ]; then
    if ! _gfb_confirm "Hapus branch lama ($existing_where) lalu buat ulang?" n; then
      _gfb_info "Dibatalkan."
      return 1
    fi
  elif [[ "$used_placeholder" = true && "$assume_yes" != true ]]; then
    if ! _gfb_confirm "Lanjut?" y; then
      _gfb_info "Dibatalkan."
      return 1
    fi
  fi

  print
  _gfb_step "Pull $base_branch"
  if ! { git checkout -q "$base_branch" && git pull -q origin "$base_branch"; }; then
    _gfb_err "Gagal update $base_branch."
    return 1
  fi

  if [ "$replace_existing" = true ]; then
    if [ "$exists_local" = true ]; then
      _gfb_step "Hapus branch lama ${D}(lokal)${N}"
      if ! git branch -q -D "$branch_name"; then
        _gfb_err "Gagal menghapus branch lokal $branch_name."
        return 1
      fi
    fi
    if [ "$exists_remote" = true ]; then
      _gfb_step "Hapus branch lama ${D}(origin)${N}"
      if ! git push -q origin --delete "$branch_name"; then
        _gfb_err "Gagal menghapus branch di origin (branch lokal sudah terhapus)."
        return 1
      fi
    fi
  fi

  _gfb_step "Buat branch $branch_name"
  if ! git checkout -q -b "$branch_name"; then
    _gfb_err "Gagal membuat branch $branch_name."
    return 1
  fi

  if [ "$auto_merge" = true ]; then
    _gfb_step "Merge $current_branch"
    if ! git merge "$current_branch"; then
      print
      _gfb_warn "Ada conflict saat merge. Selesaikan manual lalu commit."
      [ "$push_to_origin" = true ] && _gfb_hint "git push -u origin $branch_name" "push setelah selesai"
      print
      return 1
    fi
  fi

  if [ "$push_to_origin" = true ]; then
    _gfb_step "Push ke origin"
    if ! git push -q -u origin "$branch_name"; then
      _gfb_err "Push gagal."
      _gfb_hint "git push -u origin $branch_name" "coba lagi"
      return 1
    fi
    print
    _gfb_ok "Branch ${B}$branch_name${N} siap dan sudah di-push."
  else
    print
    _gfb_ok "Branch ${B}$branch_name${N} dibuat secara lokal."
    _gfb_hint "git push -u origin $branch_name" "untuk push"
  fi
  print
}

# Tab completion: base branch dari daftar branch lokal
_gfb_branches() {
  local -a branches
  branches=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
  _describe 'branch' branches
}
_gfb() {
  _arguments -s \
    '-p[push ke origin]' '-m[merge branch aktif]' '-y[tanpa konfirmasi]' \
    '-n[dry-run]' '-h[bantuan]' \
    '1:base branch:_gfb_branches' \
    '2:nama branch baru:'
}
(( $+functions[compdef] )) && compdef _gfb gfb

# ════════════════════════════════════════════════════════════════════
# gfbclean — hapus branch yang sudah merged ke base branch (lokal + origin)
# Aman: branch penting & branch aktif dilewati, bisa pilih nomor / all.
#   gfbclean master
#   gfbclean master -f kiki
# ════════════════════════════════════════════════════════════════════
_gfbclean_usage() {
  _gfb_head "gfbclean" "hapus branch yang sudah merged ke base"
  _gfb_sec "Untuk apa"
  _gfb_text "Bersih-bersih branch lama: cari branch yang sudah merged ke base,"
  _gfb_text "pilih mana yang mau dihapus, lalu hapus di lokal dan origin sekaligus."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbclean <base-branch> [-f keyword]"
  _gfb_sec "Argumen"
  _gfb_opt "<base-branch>" "branch tujuan merge yang dicek (@ = branch aktif)"
  _gfb_sec "Opsi"
  _gfb_opt "-f, --filter" "hanya branch yang mengandung keyword"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfbclean master"
  _gfb_ex "gfbclean master -f kiki" "hanya yang mengandung 'kiki'"
  _gfb_sec "Catatan"
  _gfb_note "Pilihan: 1 3 / 1,3 / all. Dihapus di lokal + origin."
  _gfb_note "master, main, develop, staging, production & branch aktif selalu dilewati."
  print
}

gfbclean() {
  local base_branch="" filter=""

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbclean_usage; return 0 ;;
      -f|--filter) filter="$2"; shift ;;
      -*) _gfb_bad gfbclean "Flag tidak dikenal: $1"; return 1 ;;
      *) base_branch="$1" ;;
    esac
    shift
  done

  base_branch=$(_gfb_ref "$base_branch")
  if [ -z "$base_branch" ]; then
    _gfb_bad gfbclean "Base branch wajib diisi."
    return 1
  fi
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local original_branch=$(_gfb_cur)

  # Ctrl+C: balik ke branch semula sebelum keluar
  trap "print; _gfb_info 'Dibatalkan, kembali ke $original_branch'; git checkout -q \"$original_branch\"; trap - INT; return 1" INT

  _gfb_head "gfbclean" "hapus branch yang sudah merged ke $base_branch"
  _gfb_step "Pull $base_branch"
  if ! { git checkout -q "$base_branch" && git pull -q origin "$base_branch"; }; then
    _gfb_err "Gagal update $base_branch."
    git checkout -q "$original_branch"
    trap - INT
    return 1
  fi

  local branches
  branches=$(git branch --merged "$base_branch" --format='%(refname:short)' \
    | grep -vE "$GFB_PROTECTED" \
    | grep -vxF -e "$base_branch" -e "$original_branch")
  [ -n "$filter" ] && branches=$(print -r -- "$branches" | grep -- "$filter")

  if [ -z "$branches" ]; then
    print
    _gfb_ok "Tidak ada branch merged${filter:+ yang cocok dengan '$filter'} untuk dibersihkan."
    print
    _gfb_step "Kembali ke $original_branch"
    git checkout -q "$original_branch"
    trap - INT
    print
    return 0
  fi

  local -a branch_list=(${(f)branches})
  _gfb_sec "Sudah merged ke $base_branch" "${#branch_list} branch"
  local i
  for (( i = 1; i <= ${#branch_list}; i++ )); do
    _gfb_item $i "${branch_list[i]}  ${D}· $(git log -1 --format=%cr "${branch_list[i]}")${N}"
  done

  local selection
  _gfb_ask selection "Pilih nomor" "(1 3 / 1,3 / all, Enter = batal)"

  local -a selected_branches=() nums=()
  if [[ "$selection" == "all" ]]; then
    selected_branches=("${branch_list[@]}")
  else
    nums=(${=${selection//,/ }})
    local num
    for num in "${nums[@]}"; do
      if [[ "$num" == <-> ]] && (( num >= 1 && num <= ${#branch_list} )); then
        selected_branches+=("${branch_list[num]}")
      else
        _gfb_warn "Nomor '$num' tidak valid, dilewati."
      fi
    done
  fi

  if (( ${#selected_branches} == 0 )); then
    _gfb_info "Tidak ada yang dipilih. Dibatalkan."
    print
    _gfb_step "Kembali ke $original_branch"
    git checkout -q "$original_branch"
    trap - INT
    print
    return 0
  fi

  _gfb_sec "Akan dihapus" "${#selected_branches} branch · lokal + origin"
  local b
  for b in "${selected_branches[@]}"; do
    if git show-ref --verify --quiet "refs/remotes/origin/$b"; then
      _gfb_bullet "$b"
    else
      _gfb_bullet "$b  ${D}(tidak ada di origin)${N}"
    fi
  done

  if ! _gfb_confirm "Lanjut hapus branch di atas?" n; then
    _gfb_info "Dibatalkan."
  else
    print
    local done_count=0 has_remote
    for b in "${selected_branches[@]}"; do
      has_remote=false
      git show-ref --verify --quiet "refs/remotes/origin/$b" && has_remote=true
      if ! git branch -q -d "$b" 2>/dev/null; then
        _gfb_warn "$b ${D}— gagal hapus lokal (pakai gfbdel untuk paksa)${N}"
        continue
      fi
      if [ "$has_remote" = true ] && ! git push -q origin --delete "$b" 2>/dev/null; then
        _gfb_warn "$b ${D}— lokal terhapus, origin gagal${N}"
        continue
      fi
      _gfb_ok "$b"
      (( done_count++ ))
    done
    print
    _gfb_ok "${B}$done_count dari ${#selected_branches} branch dihapus.${N}"
  fi

  print
  _gfb_step "Kembali ke $original_branch"
  git checkout -q "$original_branch"
  trap - INT
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbcheck — tampilkan branch yang BELUM merged ke base branch
#   gfbcheck master
#   gfbcheck master -f kiki
# ════════════════════════════════════════════════════════════════════
_gfbcheck_usage() {
  _gfb_head "gfbcheck" "branch yang belum merged ke base"
  _gfb_sec "Untuk apa"
  _gfb_text "Lihat branch mana saja yang BELUM masuk ke base, beserta jumlah commit"
  _gfb_text "yang belum merged — berguna sebelum rilis atau sebelum bersih-bersih."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbcheck <base-branch> [-f keyword]"
  _gfb_sec "Argumen"
  _gfb_opt "<base-branch>" "branch pembanding (@ = branch aktif)"
  _gfb_sec "Opsi"
  _gfb_opt "-f, --filter" "hanya branch yang mengandung keyword"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfbcheck master"
  _gfb_ex "gfbcheck develop -f bugfix" "hanya yang mengandung 'bugfix'"
  print
}

gfbcheck() {
  local base_branch="" filter=""

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbcheck_usage; return 0 ;;
      -f|--filter) filter="$2"; shift ;;
      -*) _gfb_bad gfbcheck "Flag tidak dikenal: $1"; return 1 ;;
      *) base_branch="$1" ;;
    esac
    shift
  done

  base_branch=$(_gfb_ref "$base_branch")
  if [ -z "$base_branch" ]; then
    _gfb_bad gfbcheck "Base branch wajib diisi."
    return 1
  fi
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local original_branch=$(_gfb_cur)

  _gfb_head "gfbcheck" "branch yang belum merged ke $base_branch"
  _gfb_step "Pull $base_branch"
  if ! { git checkout -q "$base_branch" && git pull -q origin "$base_branch"; }; then
    _gfb_err "Gagal update $base_branch."
    git checkout -q "$original_branch"
    return 1
  fi

  local branches
  branches=$(git branch --no-merged "$base_branch" --format='%(refname:short)' | grep -vE "$GFB_PROTECTED")
  [ -n "$filter" ] && branches=$(print -r -- "$branches" | grep -- "$filter")

  if [ -z "$branches" ]; then
    print
    _gfb_ok "Semua branch${filter:+ yang cocok dengan '$filter'} sudah merged ke $base_branch."
  else
    local -a list=(${(f)branches})
    _gfb_sec "Belum merged" "${#list} branch"
    local i ahead
    for (( i = 1; i <= ${#list}; i++ )); do
      ahead=$(git rev-list --count "$base_branch..${list[i]}" 2>/dev/null)
      _gfb_item $i "${list[i]}  ${Y}$ahead commit${N} ${D}· $(git log -1 --format='%cr · %an' "${list[i]}")${N}"
    done
  fi

  print
  _gfb_step "Kembali ke $original_branch"
  git checkout -q "$original_branch"
  print
}

# ════════════════════════════════════════════════════════════════════
# gfblog — commit di target branch yang belum ada di base
#   gfblog master                 → master vs branch aktif
#   gfblog master feature/login   → master vs feature/login
# ════════════════════════════════════════════════════════════════════
_gfblog_usage() {
  _gfb_head "gfblog" "commit yang belum ada di base"
  _gfb_sec "Untuk apa"
  _gfb_text "Lihat commit di branch kamu yang belum ada di base,"
  _gfb_text "mis. untuk cek isi PR sebelum dibuat."
  _gfb_sec "Pemakaian"
  _gfb_use "gfblog [base-branch] [target-branch]"
  _gfb_note "default: base = master, target = branch aktif (@)"
  _gfb_sec "Argumen"
  _gfb_opt "[base-branch]" "pembanding, default master"
  _gfb_opt "[target-branch]" "branch yang dicek, default branch aktif (@)"
  _gfb_sec "Contoh"
  _gfb_ex "gfblog master" "master vs branch aktif"
  _gfb_ex "gfblog master feature/login" "master vs feature/login"
  print
}

gfblog() {
  [[ "$1" == -h || "$1" == --help ]] && { _gfblog_usage; return 0; }
  _gfb_repo || return 1

  local base_branch=$(_gfb_ref "${1:-master}")
  local target_branch=$(_gfb_ref "${2:-@}")
  local ref
  for ref in "$base_branch" "$target_branch"; do
    if ! git rev-parse --verify -q "$ref^{commit}" >/dev/null; then
      _gfb_err "Branch '$ref' tidak ditemukan."
      return 1
    fi
  done
  if [ "$target_branch" = "$base_branch" ]; then
    _gfb_warn "Target branch sama dengan base branch ($base_branch)."
    return 1
  fi

  local count=$(git rev-list --count "$base_branch..$target_branch")

  _gfb_head "gfblog" "commit yang belum ada di base"
  _gfb_kv "target" "$target_branch"
  _gfb_kv "base" "$base_branch"

  if (( count == 0 )); then
    print
    _gfb_ok "Tidak ada commit baru dibanding $base_branch."
  else
    _gfb_sec "Commit" "$count"
    _gfb_commits "$base_branch..$target_branch"
  fi
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbfind — cari commit ada di branch mana saja
#   gfbfind 56c97cde
#   gfbfind 56c97cde -r            → termasuk remote
#   gfbfind 56c97cde -f feature    → filter nama branch
# ════════════════════════════════════════════════════════════════════
_gfbfind_usage() {
  _gfb_head "gfbfind" "cari commit ada di branch mana saja"
  _gfb_sec "Untuk apa"
  _gfb_text "Cari tahu sebuah commit sudah masuk ke branch mana saja,"
  _gfb_text "mis. untuk cek apakah sebuah fix sudah ada di develop / master."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbfind <commit-hash> [-r] [-f keyword]"
  _gfb_sec "Argumen"
  _gfb_opt "<commit-hash>" "short atau full hash"
  _gfb_sec "Opsi"
  _gfb_opt "-r, --remote" "termasuk remote branch"
  _gfb_opt "-f, --filter" "filter nama branch"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfbfind 56c97cde" "cari di branch lokal"
  _gfb_ex "gfbfind 56c97cde -r" "termasuk remote"
  _gfb_ex "gfbfind 56c97cde -r -f feature" "+ filter nama branch"
  print
}

gfbfind() {
  local commit_hash="" include_remote=false filter=""

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbfind_usage; return 0 ;;
      -r|--remote) include_remote=true ;;
      -f|--filter) filter="$2"; shift ;;
      -*) _gfb_bad gfbfind "Flag tidak dikenal: $1"; return 1 ;;
      *) [ -z "$commit_hash" ] && commit_hash="$1" ;;
    esac
    shift
  done

  if [ -z "$commit_hash" ]; then
    _gfb_bad gfbfind "Commit hash wajib diisi."
    return 1
  fi
  _gfb_repo || return 1
  if ! git cat-file -e "$commit_hash^{commit}" 2>/dev/null; then
    _gfb_err "Commit '$commit_hash' tidak ditemukan di repo ini."
    return 1
  fi

  local B D N G R Y C M; _gfb_pal

  _gfb_head "gfbfind" "cari commit ada di branch mana saja"
  _gfb_kv "commit" "$(git log -1 --format="${Y}%h${N} %s ${D}· %cr · %an${N}" "$commit_hash")"
  if [ "$include_remote" = true ]; then
    _gfb_kv "mode" "lokal + remote"
  else
    _gfb_kv "mode" "lokal ${D}(tambah -r untuk remote)${N}"
  fi
  [ -n "$filter" ] && _gfb_kv "filter" "$filter"

  local -a flag=()
  [ "$include_remote" = true ] && flag=(-a)
  local found
  found=$(git branch "${flag[@]}" --contains "$commit_hash" --format='%(refname:short)' | grep -v '/HEAD$')
  [ -n "$filter" ] && found=$(print -r -- "$found" | grep -- "$filter")

  if [ -z "$found" ]; then
    print
    _gfb_warn "Commit tidak ditemukan di branch manapun."
    print
    return 0
  fi

  local -a list=(${(f)found})
  _gfb_sec "Ditemukan di" "${#list} branch"
  local i
  for (( i = 1; i <= ${#list}; i++ )); do
    _gfb_item $i "${list[i]}"
  done
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbls — daftar branch (opsional keyword), urut dari yang terakhir dipakai
#   gfbls kiki
#   gfbls kiki -r    → termasuk remote
# ════════════════════════════════════════════════════════════════════
_gfbls_usage() {
  _gfb_head "gfbls" "daftar branch, urut terakhir dipakai"
  _gfb_sec "Untuk apa"
  _gfb_text "Daftar branch diurutkan dari yang terakhir dipakai (checkout/commit),"
  _gfb_text "lengkap dengan status sinkron ke origin dan kapan terakhir dipakai."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbls [keyword] [-r]"
  _gfb_sec "Argumen"
  _gfb_opt "[keyword]" "bagian nama branch; kosong = semua branch"
  _gfb_sec "Opsi"
  _gfb_opt "-r, --remote" "termasuk remote branch"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfbls" "semua branch lokal"
  _gfb_ex "gfbls kiki" "yang mengandung 'kiki'"
  _gfb_ex "gfbls feature -r" "termasuk remote"
  print
}

gfbls() {
  local keyword="" include_remote=false

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbls_usage; return 0 ;;
      -r|--remote) include_remote=true ;;
      -*) _gfb_bad gfbls "Flag tidak dikenal: $1"; return 1 ;;
      *) [ -z "$keyword" ] && keyword="$1" ;;
    esac
    shift
  done
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal

  _gfb_head "gfbls" "branch, urut terakhir dipakai"

  # Fetch dulu supaya info remote fresh
  _gfb_step "Fetch origin"
  git fetch --quiet 2>/dev/null
  _gfb_unwait

  # keyword kosong = grep match semua baris
  local local_branches remote_branches all_branches
  local_branches=$(git branch --format='%(refname:short)' | grep -- "$keyword")
  remote_branches=$(git branch -r --format='%(refname:short)' \
    | grep -v '/HEAD$' | sed 's|^origin/||' | grep -- "$keyword")

  if [ "$include_remote" = true ]; then
    all_branches=$(printf "%s\n%s\n" "$local_branches" "$remote_branches" | grep -v '^$' | sort -u)
  else
    all_branches="$local_branches"
  fi

  _gfb_kv "keyword" "${keyword:-${D}semua${N}}"
  _gfb_kv "mode" "$([ "$include_remote" = true ] && echo "lokal + remote" || echo "lokal ${D}(tambah -r untuk remote)${N}")"

  if [ -z "$all_branches" ]; then
    print
    _gfb_warn "Tidak ada branch${keyword:+ yang mengandung '$keyword'}."
    print
    return 0
  fi

  # Waktu checkout terakhir per branch dari reflog HEAD (baris pertama = terbaru)
  local checkout_times
  checkout_times=$(git reflog show HEAD --date=unix --format='%gd %gs' 2>/dev/null \
    | awk '/checkout: moving from/ && !seen[$NF]++ {sub(/.*@\{/, "", $1); sub(/\}.*/, "", $1); print $1, $NF}')
  local current_branch=$(git branch --show-current 2>/dev/null)

  # last used = max(checkout terakhir, update ref terakhir di reflog, commit terakhir)
  local now=$(date +%s)
  local sorted_branches
  sorted_branches=$(while read -r branch; do
    [ -z "$branch" ] && continue
    local ts=0
    if [ "$branch" = "$current_branch" ]; then
      ts=$(( now + 1 ))  # branch aktif selalu paling atas
    elif git show-ref --verify --quiet "refs/heads/$branch"; then
      local t_checkout=$(echo "$checkout_times" | awk -v b="$branch" '$2 == b {print $1; exit}')
      local t_reflog=$(git reflog show "refs/heads/$branch" -1 --date=unix --format='%gd' 2>/dev/null | sed -n 's/.*@{\([0-9]*\)}$/\1/p')
      local t_commit=$(git log -1 --format='%ct' "refs/heads/$branch" 2>/dev/null)
      for t in $t_checkout $t_reflog $t_commit; do
        [ "$t" -gt "$ts" ] 2>/dev/null && ts=$t
      done
    else
      ts=$(git log -1 --format='%ct' "refs/remotes/origin/$branch" 2>/dev/null)
    fi
    printf "%s\t%s\n" "${ts:-0}" "$branch"
  done <<< "$all_branches" | sort -t $'\t' -k1,1nr)

  # Awal hari ini (00:00) untuk menentukan "kemarin"
  local today_start=$(( now - 10#$(date +%H) * 3600 - 10#$(date +%M) * 60 - 10#$(date +%S) ))

  # Kumpulkan baris dulu supaya kolom bisa rata
  local -a names=() syncs=() sync_colors=() whens=() marks=()
  local name_w=0 ts branch has_local has_remote name sync sync_color
  while IFS=$'\t' read -r ts branch; do
    [ -z "$branch" ] && continue

    local when="" diff=$(( now - ts ))
    if [ "$branch" = "$current_branch" ]; then
      when="sedang aktif"
    elif [ "$ts" -le 0 ] 2>/dev/null; then
      when="tidak diketahui"
    elif [ "$diff" -lt 60 ]; then
      when="baru saja"
    elif [ "$diff" -lt 3600 ]; then
      when="$(( diff / 60 )) menit lalu"
    elif [ "$ts" -ge "$today_start" ]; then
      when="$(( diff / 3600 )) jam lalu"
    elif [ "$ts" -ge $(( today_start - 86400 )) ]; then
      when="kemarin $(date -r "$ts" +%H:%M)"
    elif [ "$ts" -ge $(( today_start - 6 * 86400 )) ]; then
      when="$(( (today_start - ts) / 86400 + 1 )) hari lalu"
    else
      when=$(date -r "$ts" '+%d %b %Y')
    fi

    has_local=false has_remote=false name="$branch"
    print -r -- "$local_branches"  | grep -qxF -- "$branch" && has_local=true
    print -r -- "$remote_branches" | grep -qxF -- "$branch" && has_remote=true

    if $has_local && $has_remote; then
      local ahead=$(git rev-list --count "origin/$branch..$branch" 2>/dev/null)
      local behind=$(git rev-list --count "$branch..origin/$branch" 2>/dev/null)
      sync=""
      (( ahead > 0 ))  && sync+="↑$ahead "
      (( behind > 0 )) && sync+="↓$behind"
      if [ -z "$sync" ]; then sync="✓ sinkron"; sync_color=$G; else sync_color=$Y; fi
    elif $has_local; then
      sync="lokal saja"; sync_color=$D
    else
      sync="remote saja"; sync_color=$C; name="origin/$branch"
    fi

    names+=("$name"); syncs+=("${sync% }"); sync_colors+=("$sync_color"); whens+=("$when")
    if [ "$branch" = "$current_branch" ]; then marks+=("${G}●${N}"); else marks+=(" "); fi
    (( ${#name} > name_w )) && name_w=${#name}
  done <<< "$sorted_branches"

  (( name_w > 50 )) && name_w=50  # nama yang lebih panjang dibiarkan melewati kolom
  _gfb_kv "total" "${#names} branch"
  print

  local i
  for (( i = 1; i <= ${#names}; i++ )); do
    printf "    ${D}%3d${N} %s %-${name_w}s  %s  ${D}%s${N}\n" \
      $i "${marks[i]}" "${names[i]}" "${sync_colors[i]}${(r:11:)syncs[i]}${N}" "${whens[i]}"
  done

  print
  _gfb_note "● aktif   ↑ belum di-push   ↓ belum di-pull   ✓ sinkron   urut: terakhir dipakai"
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbpr — generate PR title & description dari commit log via AI
# Requires: GROQ_API_KEY atau GEMINI_API_KEY
#   gfbpr master                              → groq, branch aktif vs master
#   gfbpr master kiki/feat/SP-829             → branch spesifik
#   gfbpr master -p gemini                    → pakai Gemini
#   gfbpr master -p groq -m llama3-8b-8192    → pilih model manual
#
# Model Groq gratis:
#   openai/gpt-oss-120b      → default
#   qwen/qwen3.8-27b         → chat gpt bagus
#   llama-3.3-70b-versatile  → kualitas terbaik
#   llama3-8b-8192           → lebih cepat, ringan
#   gemma2-9b-it             → Google Gemma
#   qwen-qwq-32b             → Qwen reasoning
#   mistral-saba-24b         → Mistral
# Model Gemini gratis:
#   gemini-2.0-flash         → default, cepat & gratis 1500 req/hari
#   gemini-1.5-pro           → lebih powerful
# ════════════════════════════════════════════════════════════════════
_gfbpr_usage() {
  _gfb_head "gfbpr" "generate judul & deskripsi PR via AI"
  _gfb_sec "Untuk apa"
  _gfb_text "Generate judul & deskripsi PR (Summary, Changes, Impact, Testing)"
  _gfb_text "dari daftar commit branch kamu memakai AI, lalu bisa di-copy ke clipboard."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbpr [base-branch] [target-branch] [-p provider] [-m model]"
  _gfb_note "default: base = master, target = branch aktif, provider = groq"
  _gfb_note "base dikenali dari nama master / main / develop, sisanya dianggap target"
  _gfb_sec "Argumen"
  _gfb_opt "[base-branch]" "master / main / develop, default master"
