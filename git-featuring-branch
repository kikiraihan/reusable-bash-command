# ════════════════════════════════════════════════════════════════════
# gfbclean — hapus branch yang sudah merged ke base branch (lokal + origin)
# Aman: branch penting & branch aktif dilewati, bisa pilih nomor / all.
#   gfbclean master
#   gfbclean master -f kiki
# ════════════════════════════════════════════════════════════════════
_gfbclean_usage() {
  _gfb_head "gfbclean" "hapus branch yang sudah merged ke base"
  _gfb_sec "Untuk apa"
  _gfb_text "Bersih-bersih branch lama: cari branch yang sudah merged ke base,"
  _gfb_text "pilih mana yang mau dihapus, lalu hapus di lokal dan origin sekaligus."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbclean <base-branch> [-f keyword]"
  _gfb_sec "Argumen"
  _gfb_opt "<base-branch>" "branch tujuan merge yang dicek (@ = branch aktif)"
  _gfb_sec "Opsi"
  _gfb_opt "-f, --filter" "hanya branch yang mengandung keyword"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfbclean master"
  _gfb_ex "gfbclean master -f kiki" "hanya yang mengandung 'kiki'"
  _gfb_sec "Catatan"
  _gfb_note "Pilihan: 1 3 / 1,3 / all. Dihapus di lokal + origin."
  _gfb_note "master, main, develop, staging, production & branch aktif selalu dilewati."
  print
}

gfbclean() {
  local base_branch="" filter=""

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbclean_usage; return 0 ;;
      -f|--filter) filter="$2"; shift ;;
      -*) _gfb_bad gfbclean "Flag tidak dikenal: $1"; return 1 ;;
      *) base_branch="$1" ;;
    esac
    shift
  done

  base_branch=$(_gfb_ref "$base_branch")
  if [ -z "$base_branch" ]; then
    _gfb_bad gfbclean "Base branch wajib diisi."
    return 1
  fi
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local original_branch=$(_gfb_cur)

  # Ctrl+C: balik ke branch semula sebelum keluar
  trap "print; _gfb_info 'Dibatalkan, kembali ke $original_branch'; git checkout -q \"$original_branch\"; trap - INT; return 1" INT

  _gfb_head "gfbclean" "hapus branch yang sudah merged ke $base_branch"
  _gfb_step "Pull $base_branch"
  if ! { git checkout -q "$base_branch" && git pull -q origin "$base_branch"; }; then
    _gfb_err "Gagal update $base_branch."
    git checkout -q "$original_branch"
    trap - INT
    return 1
  fi

  local branches
  branches=$(git branch --merged "$base_branch" --format='%(refname:short)' \
    | grep -vE "$GFB_PROTECTED" \
    | grep -vxF -e "$base_branch" -e "$original_branch")
  [ -n "$filter" ] && branches=$(print -r -- "$branches" | grep -- "$filter")

  # Branch yang masih terbuka di worktree tidak bisa dihapus → dilewati
  local -a wt_path wt_branch wt_head wt_flag; _gfbwt_load
  local wt_brs=${(F)${wt_branch:#}} wt_skipped=""
  if [[ -n "$wt_brs" && -n "$branches" ]]; then
    wt_skipped=$(print -r -- "$branches" | grep -xF -- "$wt_brs")
    branches=$(print -r -- "$branches" | grep -vxF -- "$wt_brs")
  fi
  if [ -n "$wt_skipped" ]; then
    local -a wt_sk=(${(f)wt_skipped})
    _gfb_info "${#wt_sk} branch merged dilewati karena masih terbuka di worktree."
    _gfb_hint "gfbwt clean $base_branch -b" "hapus worktree + branch-nya"
  fi

  if [ -z "$branches" ]; then
    print
    _gfb_ok "Tidak ada branch merged${filter:+ yang cocok dengan '$filter'} untuk dibersihkan."
    print
    _gfb_step "Kembali ke $original_branch"
    git checkout -q "$original_branch"
    trap - INT
    print
    return 0
  fi

  local -a branch_list=(${(f)branches})
  _gfb_sec "Sudah merged ke $base_branch" "${#branch_list} branch"
  local i
  for (( i = 1; i <= ${#branch_list}; i++ )); do
    _gfb_item $i "${branch_list[i]}  ${D}· $(git log -1 --format=%cr "${branch_list[i]}")${N}"
  done

  local selection
  _gfb_ask selection "Pilih nomor" "(1 3 / 1,3 / all, Enter = batal)"

  local -a selected_branches=() nums=()
  if [[ "$selection" == "all" ]]; then
    selected_branches=("${branch_list[@]}")
  else
    nums=(${=${selection//,/ }})
    local num
    for num in "${nums[@]}"; do
      if [[ "$num" == <-> ]] && (( num >= 1 && num <= ${#branch_list} )); then
        selected_branches+=("${branch_list[num]}")
      else
        _gfb_warn "Nomor '$num' tidak valid, dilewati."
      fi
    done
  fi

  if (( ${#selected_branches} == 0 )); then
    _gfb_info "Tidak ada yang dipilih. Dibatalkan."
    print
    _gfb_step "Kembali ke $original_branch"
    git checkout -q "$original_branch"
    trap - INT
    print
    return 0
  fi

  _gfb_sec "Akan dihapus" "${#selected_branches} branch · lokal + origin"
  local b
  for b in "${selected_branches[@]}"; do
    if git show-ref --verify --quiet "refs/remotes/origin/$b"; then
      _gfb_bullet "$b"
    else
      _gfb_bullet "$b  ${D}(tidak ada di origin)${N}"
    fi
  done

  if ! _gfb_confirm "Lanjut hapus branch di atas?" n; then
    _gfb_info "Dibatalkan."
  else
    print
    local done_count=0 has_remote
    for b in "${selected_branches[@]}"; do
      has_remote=false
      git show-ref --verify --quiet "refs/remotes/origin/$b" && has_remote=true
      if ! git branch -q -d "$b" 2>/dev/null; then
        _gfb_warn "$b ${D}— gagal hapus lokal (pakai gfbdel untuk paksa)${N}"
        continue
      fi
      if [ "$has_remote" = true ] && ! git push -q origin --delete "$b" 2>/dev/null; then
        _gfb_warn "$b ${D}— lokal terhapus, origin gagal${N}"
        continue
      fi
      _gfb_ok "$b"
      (( done_count++ ))
    done
    print
    _gfb_ok "${B}$done_count dari ${#selected_branches} branch dihapus.${N}"
  fi

  print
  _gfb_step "Kembali ke $original_branch"
  git checkout -q "$original_branch"
  trap - INT
  print
}

