  _gfb_text "diedit dulu) atau sekadar di-copy ke clipboard."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbcm [-a|-c|-n] [-y] [-p provider] [-m model]"
  _gfb_note "sumber: staged kalau ada, selain itu changes (unstaged + untracked)"
  _gfb_note "tanpa flag: setelah message tampil, ditawari commit (N = tidak, lalu copy)"
  _gfb_sec "Opsi"
  _gfb_opt "-p, --provider" "groq (default) atau gemini"
  _gfb_opt "-m, --model" "pilih model manual"
  _gfb_opt "-a, --all" "git add -A dulu, lalu commit dengan message hasil AI"
  _gfb_opt "-c, --commit" "commit yang sudah di-stage dengan message hasil AI"
