lines = [l.rstrip() for l in text.strip().splitlines() if not l.strip().startswith('\`\`\`')]
print('\n'.join(lines).strip())
" "$provider" "$response"
}

gfbcm() {
  local provider="groq"  # default provider
  local model=""         # kosong = pakai default per provider
  local max_diff_chars=12000

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -p|--provider) provider="$2"; shift ;;
      -m|--model) model="$2"; shift ;;
      -h|--help)
        echo "Gunakan: gfbcm [-p provider] [-m model]"
        echo "  Sumber: staged kalau ada, selain itu changes (unstaged + untracked)"
        echo "  -p / --provider  → groq (default) atau gemini"
        echo "  -m / --model     → pilih model manual"
        return 0
        ;;
      *)
        echo "❌ Argumen tidak dikenal: $1 (lihat: gfbcm -h)"
        return 1
        ;;
    esac
    shift
  done

  # Set default model per provider
  if [ -z "$model" ]; then
    case "$provider" in
      groq)   model="openai/gpt-oss-120b" ;;
      gemini) model="gemini-2.0-flash" ;;
      *)
        echo "❌ Provider tidak dikenal: '$provider'. Pilih: groq / gemini"
        return 1
        ;;
    esac
  fi

  # Validasi API key sesuai provider
  if [ "$provider" = "groq" ] && [ -z "$GROQ_API_KEY" ]; then
    echo "❌ GROQ_API_KEY belum di-set."
    echo "Daftar gratis di https://console.groq.com lalu:"
    echo "  export GROQ_API_KEY=\"gsk_xxxxxx\""
    return 1
  fi
  if [ "$provider" = "gemini" ] && [ -z "$GEMINI_API_KEY" ]; then
    echo "❌ GEMINI_API_KEY belum di-set."
    echo "Daftar gratis di https://aistudio.google.com/apikey lalu:"
    echo "  export GEMINI_API_KEY=\"AIza_xxxxxx\""
    return 1
  fi

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "❌ Bukan di dalam git repository."
    return 1
  fi

  # Lock file & file minified tetap muncul di daftar file, tapi isi diff-nya di-skip
  local -a noisy=(':(top,exclude)*.lock' ':(top,exclude)*package-lock.json' ':(top,exclude)*pnpm-lock.yaml'
                  ':(top,exclude)*.min.js' ':(top,exclude)*.min.css')

  # Selalu baca perubahan dari root repo, walau dipanggil dari subfolder
  pushd -q "$(git rev-parse --show-toplevel)" || return 1

  local source_label files diff
  local -a untracked=()
  if ! git diff --cached --quiet; then
    source_label="staged"
    files=$(git diff --cached --name-status)
    diff=$(git diff --cached --no-color -- ":/" "${noisy[@]}")
  else
    source_label="changes (unstaged + untracked)"
    untracked=(${(f)"$(git ls-files --others --exclude-standard)"})
    files=$(git diff --name-status)
    local f
    for f in "${untracked[@]}"; do files+=$'\n'"A	$f (untracked)"; done
    files=${files#$'\n'}
    diff=$(git diff --no-color -- ":/" "${noisy[@]}")
    # Isi file baru (hanya file teks, maksimal 80 baris per file)
    for f in "${untracked[@]}"; do
      [[ -f "$f" ]] && grep -Iq . "$f" 2>/dev/null || continue
      diff+=$'\n'"--- /dev/null"$'\n'"+++ b/$f"$'\n'"$(head -n 80 "$f" | sed 's/^/+/')"
    done
  fi
  popd -q

  if [ -z "$files" ]; then
    echo "✅ Tidak ada perubahan (staged maupun unstaged)."
    return 0
  fi

  local truncated=false
  if (( ${#diff} > max_diff_chars )); then
    diff="${diff[1,$max_diff_chars]}"$'\n'"... (diff dipotong)"
    truncated=true
  fi

  local branch=$(git rev-parse --abbrev-ref HEAD)
  local recent_commits=$(git log -10 --pretty=format:%s 2>/dev/null)
  local file_count=$(echo "$files" | wc -l | tr -d ' ')

  echo ""
  echo "🌿 Branch    : $branch"
  echo "📂 Sumber    : $source_label"
  echo "📋 Total file: $file_count$([ "$truncated" = true ] && echo " (diff dipotong ke $max_diff_chars karakter)")"
  echo "🤖 Provider  : $provider ($model)"
  echo ""
  echo "⏳ Generating commit message..."
  echo ""

  # Buat prompt
  local prompt="You are an assistant that writes git commit messages, like GitHub Copilot's commit message generator.
Analyze the diff below and write ONE commit message describing these changes.
Rules:
- Use Conventional Commits: <type>(<optional scope>): <subject>. Types: feat, fix, refactor, chore, docs, test, style, perf, build, ci.
- Subject line: imperative mood, lowercase after the colon, no trailing period, max 72 characters.
- If the changes contain more than one meaningful change, add a blank line followed by a short body of bullet points (\"- ...\"), one per meaningful change, each max 72 characters.
- If it is a single small change, output only the subject line.
- Describe WHAT changed and WHY when it can be inferred; do not list every file.
- Match the language and style of the recent commits if they are consistent.
- Output ONLY the commit message. No explanation, no quotes, no code fences.

Branch name (may contain a ticket ID or hint of intent): $branch

Recent commits on this branch (for style reference):
$recent_commits

Changed files:
$files

Diff:
$diff"

  local result
  result=$(_gfb_ai_generate "$provider" "$model" "$prompt") || return 1

  echo "$result"
  echo ""

  # Tanya apakah mau copy ke clipboard
  read "copy?📋 Copy ke clipboard? (y/N): "
  if [[ "$copy" == "y" || "$copy" == "Y" ]]; then
    printf '%s' "$result" | pbcopy
    echo "✅ Sudah di-copy ke clipboard!"
  fi
}

# Git Feature Branch Status
# Seperti git status, tapi lebih lengkap:
#   - branch, upstream (ahead/behind), posisi vs base branch, fetch terakhir
#   - operasi yang sedang berjalan (merge/rebase/cherry-pick/revert/bisect)
#   - staged / changes / untracked / conflict + jumlah baris (+/-)
#   - tanda ◐ untuk file yang sebagian di-stage
#   - peringatan file sensitif (.env, *.pem, key, …) / besar di staged & untracked
#   - stash, commit belum di-push / belum di-pull
#   - saran langkah berikutnya
#
# contoh:
# gfbstatus              → base otomatis (master, lalu main)
# gfbstatus -b develop   → bandingkan dengan develop
# gfbstatus -f           → git fetch dulu supaya ahead/behind akurat
# gfbstatus -a           → tampilkan semua file (tanpa dipotong)
# gfbstatus -w           → mode watch, refresh tiap 3 detik (gfbstatus -w 5 → tiap 5 detik)

# Ubah selisih detik jadi teks relatif, mis. "3 jam lalu"
_gfb_ago() {
  local s=$1
  if   (( s < 60 ));    then echo "baru saja"
  elif (( s < 3600 ));  then echo "$(( s / 60 )) menit lalu"
  elif (( s < 86400 )); then echo "$(( s / 3600 )) jam lalu"
  else                       echo "$(( s / 86400 )) hari lalu"
  fi
}

# Cetak daftar file dari "git diff --name-status" + "--numstat" (urutannya sama)
# File yang ada di <partial> (daftar path, per baris) ditandai "◐ sebagian"
# _gfb_status_files <limit> <name-status> <numstat> [partial]
_gfb_status_files() {
  local limit=$1
  local -a ns=(${(f)2}) nums=(${(f)3}) partial=(${(f)4})
  local i st file add del counts color
  local G=$'\e[32m' R=$'\e[31m' Y=$'\e[33m' C=$'\e[36m' D=$'\e[2m' N=$'\e[0m'

  for (( i = 1; i <= ${#ns}; i++ )); do
    if (( limit > 0 && i > limit )); then
      echo "   ${D}… +$(( ${#ns} - limit )) file lainnya (pakai -a untuk semua)${N}"
      break
    fi
    st=${ns[i]%%$'\t'*}
    file=${ns[i]#*$'\t'}
    file=${file//$'\t'/ → }
    case ${st[1]} in
      A) color=$G ;; D) color=$R ;; R|C) color=$C ;; *) color=$Y ;;
    esac
    add=${${nums[i]}%%$'\t'*}
    del=${${nums[i]#*$'\t'}%%$'\t'*}
    if [[ "$add" == "-" ]]; then
      counts="${D}binary${N}"
    else
      counts=""
      (( add > 0 )) && counts+="${G}+$add${N} "
      (( del > 0 )) && counts+="${R}-$del${N}"
    fi
    (( ${partial[(Ie)${ns[i]##*$'\t'}]} )) && counts+=" ${Y}◐ sebagian${N}"
    printf "   %s%-2s%s %-55s %s\n" "$color" "${st[1]}" "$N" "$file" "$counts"
  done
}

# Total +/- dari numstat, hasil: "+X -Y"
_gfb_status_sum() {
  echo "$1" | awk -F'\t' '$1 != "-" { a += $1; d += $2 } END { printf "+%d -%d", a, d }'
}

gfbstatus() {
  local base_branch=""
  local do_fetch=false
  local limit=20
  local watch=0
  local large_mb=5  # file staged/untracked di atas ukuran ini diberi peringatan

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -b|--base) base_branch="$2"; shift ;;
      -f|--fetch) do_fetch=true ;;
      -a|--all) limit=0 ;;
      -w|--watch)
        watch=3
        if [[ "$2" == <-> ]]; then watch=$2; shift; fi
        ;;
      -h|--help)
        echo "Gunakan: gfbstatus [-b base-branch] [-f] [-a] [-w [detik]]"
        echo "  -b / --base   → base branch pembanding (default: master, lalu main)"
        echo "  -f / --fetch  → git fetch dulu supaya ahead/behind akurat"
        echo "  -a / --all    → tampilkan semua file (default maks $limit per bagian)"
        echo "  -w / --watch  → refresh otomatis (default tiap 3 detik), Ctrl+C untuk keluar"
        return 0
        ;;
      *)
        echo "❌ Argumen tidak dikenal: $1 (lihat: gfbstatus -h)"
        return 1
        ;;
    esac
    shift
  done

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "❌ Bukan di dalam git repository."
    return 1
  fi

  local G=$'\e[32m' R=$'\e[31m' Y=$'\e[33m' C=$'\e[36m' B=$'\e[1m' D=$'\e[2m' N=$'\e[0m'

  # Mode watch: jalankan ulang gfbstatus terus-menerus (fetch hanya di putaran pertama)
  if (( watch > 0 )); then
    local -a pass=()
    [ -n "$base_branch" ] && pass+=(-b "$base_branch")
    (( limit == 0 )) && pass+=(-a)
    local out first=true
    while true; do
      if [[ "$first" = true && "$do_fetch" = true ]]; then
        out=$(gfbstatus "${pass[@]}" -f 2>&1)
      else
        out=$(gfbstatus "${pass[@]}" 2>&1)
      fi
      clear
      print -r -- "$out"
      echo "${D}🔁 refresh tiap ${watch} detik • $(date +%H:%M:%S) • Ctrl+C untuk keluar${N}"
      first=false
      sleep $watch || break
    done
    return 0
  fi

  # Selalu baca dari root repo, walau dipanggil dari subfolder
  pushd -q "$(git rev-parse --show-toplevel)" || return 1

  if [ "$do_fetch" = true ]; then
    echo "🔄 Fetching..."
    git fetch --quiet --prune || echo "⚠️  Fetch gagal, data remote mungkin tidak terbaru."
  fi

  local repo=${PWD:t}
  local branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  local upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)
  local -a hints=()

  # ── Header: branch & upstream ─────────────────────────────
  echo ""
  if [ "$branch" = "HEAD" ]; then
    echo "📍 ${B}$repo${N}  •  ${R}detached HEAD${N} di $(git rev-parse --short HEAD)"
    hints+=("Detached HEAD → buat branch: git switch -c <nama-branch>")
  elif [ -n "$upstream" ]; then
    local lr=(${=$(git rev-list --left-right --count "$upstream"...HEAD 2>/dev/null)})
    local behind=${lr[1]:-0} ahead=${lr[2]:-0}
    local sync="${G}✓ sinkron${N}"
    (( ahead > 0 || behind > 0 )) && sync="${G}↑$ahead${N} ${R}↓$behind${N}"
    echo "📍 ${B}$repo${N}  •  🌿 ${B}$branch${N} → $upstream  $sync"
  else
    echo "📍 ${B}$repo${N}  •  🌿 ${B}$branch${N}  ${Y}(belum ada upstream)${N}"
    hints+=("Belum ada upstream → git push -u origin $branch")
  fi

  if git rev-parse --verify -q HEAD >/dev/null; then
    echo "   HEAD  : $(git log -1 --format="${Y}%h${N} %s ${D}(%cr, %an)${N}")"
  else
    echo "   HEAD  : ${D}belum ada commit${N}"
  fi

  # Posisi vs base branch (pakai origin/<base> kalau ada, lebih up to date)
  if [ -z "$base_branch" ]; then
    local cand
    for cand in master main; do
      if git rev-parse --verify -q "$cand" >/dev/null || git rev-parse --verify -q "origin/$cand" >/dev/null; then
        base_branch=$cand; break
      fi
    done
  fi
  if [[ -n "$base_branch" && "$branch" != "$base_branch" ]]; then
    local base_ref=$base_branch
    git rev-parse --verify -q "origin/$base_branch" >/dev/null && base_ref="origin/$base_branch"
    local blr=(${=$(git rev-list --left-right --count "$base_ref"...HEAD 2>/dev/null)})
    if (( ${#blr} == 2 )); then
      echo "   Base  : $base_ref → ${G}$blr[2] commit di depan${N}, ${R}$blr[1] di belakang${N}"
      (( blr[1] > 0 )) && hints+=("Tertinggal $blr[1] commit dari $base_ref → git merge $base_ref (atau rebase)")
    fi
  fi

  local fetch_head=$(git rev-parse --git-path FETCH_HEAD)
  if [ -f "$fetch_head" ]; then
    local since=$(( $(date +%s) - $(stat -f %m "$fetch_head") ))
    echo "   Fetch : $(_gfb_ago $since)"
    (( since > 86400 )) && hints+=("Fetch terakhir sudah lama → gfbstatus -f")
  else
    echo "   Fetch : ${D}belum pernah${N}"
  fi

  # ── Operasi yang sedang berjalan ──────────────────────────
  local op=""
  if   [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
    op="REBASE";      hints+=("Rebase berjalan → git rebase --continue / --abort")
  elif [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
    op="MERGE";       hints+=("Merge berjalan → selesaikan lalu git commit, atau git merge --abort")
  elif [ -f "$(git rev-parse --git-path CHERRY_PICK_HEAD)" ]; then
    op="CHERRY-PICK"; hints+=("Cherry-pick berjalan → git cherry-pick --continue / --abort")
  elif [ -f "$(git rev-parse --git-path REVERT_HEAD)" ]; then
    op="REVERT";      hints+=("Revert berjalan → git revert --continue / --abort")
  elif [ -f "$(git rev-parse --git-path BISECT_LOG)" ]; then
    op="BISECT";      hints+=("Bisect berjalan → git bisect reset kalau sudah selesai")
  fi
  [ -n "$op" ] && echo "" && echo "⚠️  ${R}${B}Sedang $op${N}"

  # ── File ─────────────────────────────────────────────────
  local conflicts=$(git diff --name-only --diff-filter=U 2>/dev/null)
  # File conflict hanya ditampilkan di bagian Conflict, bukan di Staged/Changes
  local -a skip=(":/")
  local cfile
  for cfile in ${(f)conflicts}; do skip+=(":(top,literal,exclude)$cfile"); done
  local staged_ns=$(git diff --cached --name-status -M --diff-filter=ACDMRTX -- "${skip[@]}" 2>/dev/null)
  local staged_num=$(git diff --cached --numstat -M --diff-filter=ACDMRTX -- "${skip[@]}" 2>/dev/null)
  local changes_ns=$(git diff --name-status --diff-filter=ACDMRTX -- "${skip[@]}" 2>/dev/null)
  local changes_num=$(git diff --numstat --diff-filter=ACDMRTX -- "${skip[@]}" 2>/dev/null)
  local untracked=$(git ls-files --others --exclude-standard)

  # File yang sebagian di-stage (ada di Staged sekaligus di Changes)
  local -a unstaged_names=(${(f)"$(git diff --name-only -- "${skip[@]}")"})
  local -a staged_names=(${(f)"$(git diff --cached --name-only -- "${skip[@]}")"})
  local partial=${(F)unstaged_names:*staged_names}

  if [ -n "$conflicts" ]; then
    local -a cf=(${(f)conflicts})
    echo ""
    echo "⚔️  ${R}${B}Conflict (${#cf} file)${N}"
    printf "   ${R}U${N}  %s\n" "${cf[@]}"
    hints+=("Selesaikan conflict → edit file, lalu git add <file>")
  fi

  echo ""
  if [ -n "$staged_ns" ]; then
    local -a sl=(${(f)staged_ns})
    echo "✅ ${G}${B}Staged (${#sl} file, $(_gfb_status_sum "$staged_num"))${N}  ${D}→ akan masuk commit${N}"
    _gfb_status_files $limit "$staged_ns" "$staged_num" "$partial"
    hints+=("Ada yang di-stage → gfbcm untuk generate commit message")
  else
    echo "✅ ${D}Staged: kosong${N}"
  fi

  echo ""
  if [ -n "$changes_ns" ]; then
    local -a cl=(${(f)changes_ns})
    echo "✏️  ${Y}${B}Changes (${#cl} file, $(_gfb_status_sum "$changes_num"))${N}  ${D}→ belum di-stage${N}"
    _gfb_status_files $limit "$changes_ns" "$changes_num" "$partial"
    [ -n "$partial" ] && hints+=("◐ = sebagian di-stage → git add <file> kalau sisa perubahannya juga mau ikut commit")
  else
    echo "✏️  ${D}Changes: kosong${N}"
  fi

  if [ -n "$untracked" ]; then
    local -a ul=(${(f)untracked})
    echo ""
    echo "❓ ${C}${B}Untracked (${#ul} file)${N}  ${D}→ file baru, belum di-track${N}"
    local i
    for (( i = 1; i <= ${#ul}; i++ )); do
      if (( limit > 0 && i > limit )); then
        echo "   ${D}… +$(( ${#ul} - limit )) file lainnya (pakai -a untuk semua)${N}"
        break
      fi
      echo "   ${C}?${N}  ${ul[i]}"
    done
  fi

  if [[ -z "$staged_ns" && ( -n "$changes_ns" || -n "$untracked" ) ]]; then
    hints+=("Belum ada yang di-stage → git add <file> (atau git add -p untuk sebagian)")
  fi

  # ── Peringatan: file sensitif / besar di staged atau untracked ──
  local -a warns=()
  local wfile wbase wsize kind
  local -a staged_files=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRT -- "${skip[@]}")"})
  for wfile in "${staged_files[@]}" ${(f)untracked}; do
    [ -z "$wfile" ] && continue
    kind="staged"
    (( ${staged_files[(Ie)$wfile]} )) || kind="untracked"
    wbase=${wfile:t}
    case $wbase in
      .env.example|.env.sample|.env.template|*.pub) ;;
      .env|.env.*|*.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|id_rsa*|id_ed25519*|id_ecdsa*|credentials*.json|service-account*.json|*.sqlite|*.sqlite3)
        warns+=("${R}🔐 $wfile${N} ${D}($kind)${N} kemungkinan berisi secret")
        ;;
    esac
    if [ -f "$wfile" ]; then
      wsize=$(stat -f %z "$wfile" 2>/dev/null)
      if (( wsize > large_mb * 1024 * 1024 )); then
        warns+=("${Y}🐘 $wfile${N} ${D}($kind)${N} berukuran $(( wsize / 1024 / 1024 )) MB")
      fi
    fi
  done
  if (( ${#warns} )); then
    echo ""
    echo "🚨 ${R}${B}Perhatian (${#warns})${N}"
    printf "   %s\n" "${warns[@]}"
    hints+=("File sensitif/besar → tambahkan ke .gitignore (kalau sudah staged: git restore --staged <file>)")
  fi

  # ── Stash ────────────────────────────────────────────────
  local stash_count=$(git stash list 2>/dev/null | wc -l | tr -d ' ')
  if (( stash_count > 0 )); then
    echo ""
    echo "📦 ${B}Stash ($stash_count)${N}  ${D}terakhir: $(git stash list -1 --format='%gs (%cr)')${N}"
  fi

  # ── Commit belum di-push / belum di-pull ─────────────────
  if [ -n "$upstream" ]; then
    local unpushed=$(git log --format="${Y}%h${N} %s ${D}(%cr)${N}" "$upstream"..HEAD 2>/dev/null)
    local unpulled=$(git log --format="${Y}%h${N} %s ${D}(%cr, %an)${N}" HEAD.."$upstream" 2>/dev/null)
    if [ -n "$unpushed" ]; then
      local -a up=(${(f)unpushed})
      echo ""
      echo "⬆️  ${G}${B}Belum di-push (${#up} commit)${N}"
      printf "   %s\n" "${up[1,10]}"
      (( ${#up} > 10 )) && echo "   ${D}… +$(( ${#up} - 10 )) commit lainnya${N}"
      hints+=("Ada commit belum di-push → git push")
    fi
    if [ -n "$unpulled" ]; then
      local -a dn=(${(f)unpulled})
      echo ""
      echo "⬇️  ${R}${B}Belum di-pull (${#dn} commit)${N}"
      printf "   %s\n" "${dn[1,10]}"
      (( ${#dn} > 10 )) && echo "   ${D}… +$(( ${#dn} - 10 )) commit lainnya${N}"
      hints+=("Ada commit baru di remote → git pull")
    fi
  fi

  popd -q

  # ── Saran ────────────────────────────────────────────────
  echo ""
  if (( ${#hints} )); then
    echo "💡 ${B}Langkah berikut:${N}"
    printf "   • %s\n" "${hints[@]}"
  else
    echo "✨ ${G}Bersih & sinkron, tidak ada yang perlu dilakukan.${N}"
  fi
  echo ""
}

# Git Feature Branch Lark Link
# Generate link Lark (Story & Issue) berdasarkan ID yang terkandung di nama branch
# ID biasanya berupa angka yang menempel di nama branch, misal:
# kiki/feat/split-payment-23729368
#
# Karena satu ID bisa jadi Story (feat) atau Issue (fix), function ini akan
# selalu menampilkan KEDUA kemungkinan link, diurutkan mana yang lebih mungkin
# berdasarkan nama branch (mengandung "fix" → Issue duluan, selain itu → Story duluan).
#
# Base URL Lark diatur lewat variable LARK_STORY_BASE_URL & LARK_ISSUE_BASE_URL
# di dalam function ini, jadi kalau formatnya berubah tinggal ubah di sini saja.
#
# Deteksi ID pakai AI (Groq/Gemini), sama seperti gfbpr.
# Kalau API key belum di-set atau AI tidak menemukan angka, akan fallback ke
# regex sederhana (ambil angka dari nama branch). Kalau tetap tidak ketemu,
# user akan diminta input ID secara manual.
#
# contoh:
# gfblarklink                                  → deteksi ID dari branch aktif
# gfblarklink kiki/feat/split-payment-23729368 → deteksi ID dari branch tertentu
# gfblarklink -i 23687966                      → langsung pakai ID manual
# gfblarklink . -p gemini                      → pakai Gemini untuk deteksi
gfblarklink() {
  # Base URL Lark, ubah di sini kalau formatnya berubah
  local LARK_STORY_BASE_URL="https://project.larksuite.com/spd/story/detail/"
  local LARK_ISSUE_BASE_URL="https://project.larksuite.com/spd/issue/detail/"

  local branch_name=""
  local manual_id=""
  local provider="groq"  # default provider
  local model=""         # kosong = pakai default per provider

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -i|--id)
        manual_id="$2"
        shift
        ;;
      -p|--provider)
        provider="$2"
        shift
        ;;
      -m|--model)
        model="$2"
        shift
        ;;
      *)
        if [ -z "$branch_name" ]; then
          branch_name="$1"
        fi
        ;;
    esac
    shift
  done

  # Default branch = branch aktif saat ini, "." juga berarti branch aktif
  [ -z "$branch_name" ] && branch_name=$(git rev-parse --abbrev-ref HEAD)
  [ "$branch_name" = "." ] && branch_name=$(git rev-parse --abbrev-ref HEAD)

  local prd_id="$manual_id"

  # Kalau user sudah kasih ID manual lewat -i, skip semua deteksi
  if [ -z "$prd_id" ]; then
    echo "🔍 Mencari ID PRD di nama branch: $branch_name"

    # Set default model per provider
    if [ -z "$model" ]; then
      case "$provider" in
        groq)   model="openai/gpt-oss-120b" ;;
        gemini) model="gemini-2.0-flash" ;;
        *)
          echo "❌ Provider tidak dikenal: '$provider'. Pilih: groq / gemini"
          return 1
          ;;
      esac
    fi

    # Cek API key sesuai provider, kalau belum di-set langsung fallback ke regex
    local has_api_key=true
    if [ "$provider" = "groq" ] && [ -z "$GROQ_API_KEY" ]; then
      has_api_key=false
    fi
    if [ "$provider" = "gemini" ] && [ -z "$GEMINI_API_KEY" ]; then
      has_api_key=false
    fi

    if [ "$has_api_key" = true ]; then
      local prompt="Extract the numeric PRD/story ID from this git branch name. The ID is usually a sequence of digits (5 digits or more) embedded somewhere in the branch name. Return ONLY the number, nothing else, no explanation, no punctuation. If there is no clear numeric ID, return exactly: NONE
Branch name: $branch_name"

      local response result

      if [ "$provider" = "groq" ]; then
        local json_payload
        json_payload=$(python3 -c "
import sys, json
print(json.dumps({
    'model': sys.argv[2],
    'messages': [{'role': 'user', 'content': sys.argv[1]}],
    'temperature': 0
}))
" "$prompt" "$model" 2>/dev/null)

        response=$(curl -s https://api.groq.com/openai/v1/chat/completions \
          -H "Authorization: Bearer $GROQ_API_KEY" \
          -H "Content-Type: application/json" \
          -d "$json_payload")

        result=$(python3 -c "
import sys, json
try:
  d = json.loads(sys.argv[1])
  print(d['choices'][0]['message']['content'].strip())
except Exception:
  print('NONE')
" "$response" 2>/dev/null)

      elif [ "$provider" = "gemini" ]; then
        local json_payload
        json_payload=$(python3 -c "
import sys, json
print(json.dumps({
    'contents': [{'parts': [{'text': sys.argv[1]}]}],
    'generationConfig': {'temperature': 0}
}))
" "$prompt" 2>/dev/null)

        response=$(curl -s "https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=$GEMINI_API_KEY" \
          -H "Content-Type: application/json" \
          -d "$json_payload")

        result=$(python3 -c "
import sys, json
try:
  d = json.loads(sys.argv[1])
  print(d['candidates'][0]['content']['parts'][0]['text'].strip())
except Exception:
  print('NONE')
" "$response" 2>/dev/null)
      fi

      # Bersihkan hasil, ambil digit saja kalau AI kasih tambahan teks
      result=$(echo "$result" | grep -oE '[0-9]+' | head -1)
      [ -n "$result" ] && prd_id="$result"
    else
      echo "ℹ️  API key untuk provider '$provider' belum di-set, fallback ke deteksi angka dari nama branch."
    fi

    # Fallback: kalau AI tidak tersedia / tidak ketemu, coba regex sederhana
    if [ -z "$prd_id" ]; then
      prd_id=$(echo "$branch_name" | grep -oE '[0-9]+' | tail -1)
    fi
  fi

  # Kalau masih belum ketemu, minta input manual
  if [ -z "$prd_id" ]; then
    echo "⚠️  ID PRD tidak ditemukan otomatis di nama branch."
    read "prd_id?Masukkan ID PRD manual: "
  fi

  if [ -z "$prd_id" ] || ! [[ "$prd_id" =~ ^[0-9]+$ ]]; then
    echo "❌ ID PRD tidak valid."
    return 1
  fi

  local story_link="${LARK_STORY_BASE_URL}${prd_id}"
  local issue_link="${LARK_ISSUE_BASE_URL}${prd_id}"

  # Tebak tipe ticket paling mungkin dari nama branch: "fix" → Issue duluan, selain itu → Story duluan
  local first_label="Story (feat)"
  local first_link="$story_link"
  local second_label="Issue (fix)"
  local second_link="$issue_link"

  if [[ "$branch_name" == *fix* ]]; then
    first_label="Issue (fix)"
    first_link="$issue_link"
    second_label="Story (feat)"
    second_link="$story_link"
  fi

  echo ""
  echo "🔗 Lark Link (paling mungkin duluan):"
  echo "  [1] $first_label  → $first_link"
  echo "  [2] $second_label → $second_link"
  echo ""

  read "copy?📋 Copy link mana ke clipboard? (1/2/N): "
  if [[ "$copy" == "1" ]]; then
    echo "$first_link" | pbcopy
    echo "✅ Sudah di-copy ke clipboard!"
  elif [[ "$copy" == "2" ]]; then
    echo "$second_link" | pbcopy
    echo "✅ Sudah di-copy ke clipboard!"
  fi
}

# Git Feature Branch Conflict Checker
# Cek apakah ada conflict antar branch tanpa benar-benar merge
#
# contoh:
# gfbconflict master kiki/feat/SP-829 kiki/feat/SP-927
# gfbconflict master kiki/fix/SP-960 kiki/feat/SP-829 kiki/feat/SP-927 kiki/feat/general-12-march
#
# output:
# ✅ kiki/feat/SP-829 → tidak ada conflict dengan master
# ⚠️  kiki/feat/SP-927 → conflict dengan kiki/feat/SP-829
gfbconflict() {
  if [ "$#" -lt 2 ]; then
    echo "❌ Gunakan: gfbconflict <base-branch> <branch1> <branch2> ..."
    echo "Contoh:"
    echo "  gfbconflict master kiki/feat/SP-829 kiki/feat/SP-927"
    return 1
  fi

  local base_branch="$1"
  shift
  local branches=("$@")

  # "." berarti merefer ke branch aktif saat ini (base maupun salah satu target)
  [ "$base_branch" = "." ] && base_branch=$(git rev-parse --abbrev-ref HEAD)
  local i
  for i in {1..${#branches[@]}}; do
    [[ "${branches[i]}" == "." ]] && branches[i]=$(git rev-parse --abbrev-ref HEAD)
  done

  local original_branch=$(git rev-parse --abbrev-ref HEAD)
  local temp_branch="__gfbconflict_temp__"

  # Pastikan working tree bersih
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "⚠️  Ada uncommitted changes. Stash atau commit dulu sebelum cek conflict."
    return 1
  fi

  echo ""
  echo "🔍 Base branch : $base_branch"
  echo "📋 Branch yang dicek: ${(j:, :)branches}"
  echo ""

  # Update base branch dulu
  echo "🔄 Pulling newest $base_branch..."
  git checkout "$base_branch" && git pull origin "$base_branch" --quiet || return 1
  echo ""

  # Buat temp branch dari base
  git checkout -b "$temp_branch" --quiet

  local -a clean_list
  local -a conflict_list

  for branch in "${branches[@]}"; do
    # Coba merge --no-commit --no-ff
    git merge --no-commit --no-ff "$branch" --quiet 2>/dev/null
    local merge_result=$?

    if [ $merge_result -ne 0 ]; then
      # Ada conflict
      local conflict_files=$(git diff --name-only --diff-filter=U)
      conflict_list+=("$branch")
      echo "  ⚠️  $branch → CONFLICT"
      echo "$conflict_files" | while read -r f; do
        [ -n "$f" ] && echo "       └─ $f"
      done
    else
      clean_list+=("$branch")
      echo "  ✅ $branch → aman"
    fi

    # Abort merge & reset ke base agar cek berikutnya fresh
    git merge --abort 2>/dev/null
    git reset --hard "$base_branch" --quiet
  done

  # Cleanup: hapus temp branch, balik ke semula
  git checkout "$original_branch" --quiet
  git branch -D "$temp_branch" --quiet

  echo ""
  echo "══════════════════════════════════════════"
  echo "  ✅ Aman    : ${#clean_list[@]} branch"
  echo "  ⚠️  Conflict: ${#conflict_list[@]} branch"
  echo "══════════════════════════════════════════"
  echo ""
}

# Git Feature Branch Delete
# Hapus branch di local dan remote sekaligus
# Aman: tidak bisa hapus branch penting (master, main, develop, staging, production)
# Bisa pilih branch dari list, atau langsung kasih nama
#
# contoh:
# gfbdel                          → tampilkan semua branch, pilih dari list
# gfbdel kiki/feat/SP-829         → langsung hapus branch spesifik
# gfbdel -f feature               → filter list branch sebelum pilih
# gfbdel -lo kiki/feat/SP-829     → hapus local only
# gfbdel -ro kiki/feat/SP-829     → hapus remote only
gfbdel() {
  local branch_input=""
  local filter=""
  local local_only=false
  local remote_only=false

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -f|--filter)
        filter="$2"
        shift
        ;;
      -lo|--local-only)  local_only=true ;;
      -ro|--remote-only) remote_only=true ;;
      *)
        if [ -z "$branch_input" ]; then
          branch_input="$1"
        fi
        ;;
    esac
    shift
  done

  # "." berarti merefer ke branch aktif saat ini
  [ "$branch_input" = "." ] && branch_input=$(git rev-parse --abbrev-ref HEAD)

  # Daftar branch yang dilindungi
  local protected_pattern='^(master|main|develop|staging|production)$'

  # Jika branch langsung diberikan, skip tampil list
  if [ -n "$branch_input" ]; then
    if [[ "$branch_input" =~ $protected_pattern ]]; then
      echo "🔒 Branch '$branch_input' dilindungi dan tidak bisa dihapus."
      return 1
    fi
    _gfbdel_execute "$branch_input" "$local_only" "$remote_only"
    return $?
  fi

  # Tidak ada input → tampilkan list branch untuk dipilih
  echo "🔄 Fetching origin..."
  git fetch --quiet 2>/dev/null

  local local_branches
  local_branches=$(git branch \
    | sed 's/^[* ]*//' \
    | grep -vE "$protected_pattern")

  if [ -n "$filter" ]; then
    local_branches=$(echo "$local_branches" | grep "$filter")
  fi

  if [ -z "$local_branches" ]; then
    echo "⚠️  Tidak ada branch yang bisa dihapus."
    return 0
  fi

  echo ""
  echo "🗑 Branch yang tersedia untuk dihapus:"
  local i=1
  declare -a branch_list
  while read -r branch; do
    [ -z "$branch" ] && continue
    echo "  [$i] $branch"
    branch_list[$i]="$branch"
    ((i++))
  done <<< "$local_branches"

  echo ""
  read "selection?Pilih nomor branch yang ingin dihapus: "

  if [ -z "$selection" ]; then
    echo "❌ Tidak ada yang dipilih. Dibatalkan."
    return 0
  fi

  local selected_branch="${branch_list[$selection]}"

  if [ -z "$selected_branch" ]; then
    echo "❌ Nomor tidak valid."
    return 1
  fi

  _gfbdel_execute "$selected_branch" "$local_only" "$remote_only"
}

# Helper internal untuk gfbdel: eksekusi hapus branch local dan/atau remote
_gfbdel_execute() {
  local branch="$1"
  local local_only="$2"
  local remote_only="$3"
  local current_branch=$(git rev-parse --abbrev-ref HEAD)

  # Cek apakah sedang di branch yang mau dihapus
  if [ "$current_branch" = "$branch" ]; then
    echo "⚠️  Kamu sedang berada di branch '$branch'."
    echo "Pindah dulu ke branch lain sebelum menghapus."
    return 1
  fi

  # Cek eksistensi di local dan remote
  local has_local=false
  local has_remote=false
  git show-ref --verify --quiet "refs/heads/$branch"          && has_local=true
  git show-ref --verify --quiet "refs/remotes/origin/$branch" && has_remote=true

  if ! $has_local && ! $has_remote; then
    echo "❌ Branch '$branch' tidak ditemukan (local maupun remote)."
    return 1
  fi

  echo ""
  echo "🗑 Branch yang akan dihapus: $branch"
  $has_local  && ! $remote_only && echo "  └─ local  : ✓"
  $has_remote && ! $local_only  && echo "  └─ remote : ✓"
  echo ""

  read "confirm?Lanjutkan hapus? (y/N): "
  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "❌ Dibatalkan."
    return 0
  fi

  # Hapus local
  if $has_local && ! $remote_only; then
    echo "➡️  Hapus local: $branch"
    git branch -d "$branch" 2>/dev/null || git branch -D "$branch"
  fi

  # Hapus remote
  if $has_remote && ! $local_only; then
    echo "➡️  Hapus remote: origin/$branch"
    git push origin --delete "$branch"
  fi

  echo "✅ Branch '$branch' berhasil dihapus."
}

# Git Feature Branch Range
# Menampilkan list commit dan file yang berubah di antara dua commit hash
# Mendukung short hash maupun full hash
#
# contoh:
# gfbrange abc1234 def5678
# gfbrange abc1234 def5678 -f src/services
gfbrange() {
  local hash1=""
  local hash2=""
  local filter=""

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -f|--filter)
        filter="$2"
        shift
        ;;
      *)
        if [ -z "$hash1" ]; then
          hash1="$1"
        elif [ -z "$hash2" ]; then
          hash2="$1"
        fi
        ;;
    esac
    shift
  done

  # Validasi input
  if [ -z "$hash1" ] || [ -z "$hash2" ]; then
    echo "❌ Gunakan: gfbrange <hash1> <hash2> [-f keyword]"
    echo "Contoh:"
    echo "  gfbrange abc1234 def5678"
    echo "  gfbrange abc1234 def5678 -f src/services"
    return 1
  fi

  # Validasi kedua commit hash exist
  if ! git cat-file -e "$hash1^{commit}" 2>/dev/null; then
    echo "❌ Commit '$hash1' tidak ditemukan di repo ini."
    return 1
  fi
  if ! git cat-file -e "$hash2^{commit}" 2>/dev/null; then
    echo "❌ Commit '$hash2' tidak ditemukan di repo ini."
    return 1
  fi

  local short1=$(git rev-parse --short "$hash1")
  local short2=$(git rev-parse --short "$hash2")

  # Ambil list commit antara hash1..hash2
  local commits
  commits=$(git log "$hash1".."$hash2" --oneline --no-decorate 2>/dev/null)

  echo ""
  echo "🔗 Range   : $short1 → $short2"

  if [ -z "$commits" ]; then
    # Coba balik urutan, mungkin hash1 lebih baru dari hash2
    commits=$(git log "$hash2".."$hash1" --oneline --no-decorate 2>/dev/null)
    if [ -n "$commits" ]; then
      echo "⚠️  Urutan dibalik: $short2 → $short1"
      # Tukar supaya diff file juga konsisten
      local tmp="$hash1"; hash1="$hash2"; hash2="$tmp"
      short1=$(git rev-parse --short "$hash1")
      short2=$(git rev-parse --short "$hash2")
    else
      echo "✅ Tidak ada commit di antara kedua hash tersebut."
      return 0
    fi
  fi

  local commit_count=$(echo "$commits" | wc -l | tr -d ' ')

  # ── Tampilkan commit list ──────────────────────────────────────
  echo ""
  echo "📋 Commits ($commit_count):"
  local i=1
  while read -r line; do
    echo "  [$i] $line"
    ((i++))
  done <<< "$commits"

  # ── Tampilkan file yang berubah ────────────────────────────────
  # --diff-filter: M=Modified A=Added D=Deleted R=Renamed C=Copied
  local changed_files
  changed_files=$(git diff --name-status "$hash1" "$hash2" 2>/dev/null)

  if [ -n "$filter" ]; then
    changed_files=$(echo "$changed_files" | grep "$filter")
  fi

  if [ -z "$changed_files" ]; then
    echo ""
    echo "📂 Tidak ada file yang berubah."
    return 0
  fi

  # Hitung per status
  local count_m=$(echo "$changed_files" | grep -c '^M' || true)
  local count_a=$(echo "$changed_files" | grep -c '^A' || true)
  local count_d=$(echo "$changed_files" | grep -c '^D' || true)
  local count_r=$(echo "$changed_files" | grep -c '^R' || true)
  local count_c=$(echo "$changed_files" | grep -c '^C' || true)
  local total_files=$(echo "$changed_files" | grep -c '.' || true)

  echo ""
  echo "📂 Files changed ($total_files):"

  # fstatus menggantikan status (reserved variable di zsh)
  while IFS=$'\t' read -r fstatus filepath rest; do
    [ -z "$fstatus" ] && continue
    case "${fstatus:0:1}" in
      M) echo "  \033[33m[M]\033[0m  $filepath" ;;  # Modified  → kuning
      A) echo "  \033[32m[A]\033[0m  $filepath" ;;  # Added     → hijau
      D) echo "  \033[31m[D]\033[0m  $filepath" ;;  # Deleted   → merah
      R) echo "  \033[34m[R]\033[0m  $filepath → $rest" ;;  # Renamed → biru
      C) echo "  \033[36m[C]\033[0m  $filepath → $rest" ;;  # Copied  → cyan
      *) echo "  [?]  $filepath" ;;
    esac
  done <<< "$changed_files"

  # Summary
  echo ""
  echo "──────────────────────────────────────────────────────"
  printf "  Total: %-4s" "$total_files"
  [ "$count_m" -gt 0 ] && printf "  \033[33mM:%-3s\033[0m" "$count_m"
  [ "$count_a" -gt 0 ] && printf "  \033[32mA:%-3s\033[0m" "$count_a"
  [ "$count_d" -gt 0 ] && printf "  \033[31mD:%-3s\033[0m" "$count_d"
  [ "$count_r" -gt 0 ] && printf "  \033[34mR:%-3s\033[0m" "$count_r"
  [ "$count_c" -gt 0 ] && printf "  \033[36mC:%-3s\033[0m" "$count_c"
  echo ""
  echo "──────────────────────────────────────────────────────"
  echo ""
}

# Git Feature Branch Compare
# Membandingkan dua branch secara menyeluruh:
# - Common ancestor (titik diverge)
# - Ahead/behind count di kedua arah
# - Commit yang ada di branch A tapi tidak di branch B (dan sebaliknya)
# - File yang berbeda antara kedua branch
#
# contoh:
# gfbcompare master feature/login
# gfbcompare master feature/login -f src/services
# gfbcompare develop kiki/feat/SP-829
gfbcompare() {
  local branch_a=""
  local branch_b=""
  local filter=""

  # Parsing argumen
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -f|--filter)
        filter="$2"
        shift
        ;;
      *)
        if [ -z "$branch_a" ]; then
          branch_a="$1"
        elif [ -z "$branch_b" ]; then
          branch_b="$1"
        fi
        ;;
    esac
    shift
  done

  # "." berarti merefer ke branch aktif saat ini
  [ "$branch_a" = "." ] && branch_a=$(git rev-parse --abbrev-ref HEAD)
  [ "$branch_b" = "." ] && branch_b=$(git rev-parse --abbrev-ref HEAD)

  # Validasi input
  if [ -z "$branch_a" ] || [ -z "$branch_b" ]; then
    echo "❌ Gunakan: gfbcompare <branch-a> <branch-b> [-f keyword]"
    echo "Contoh:"
    echo "  gfbcompare master feature/login"
    echo "  gfbcompare develop kiki/feat/SP-829 -f src/services"
    return 1
  fi

  # Validasi kedua branch exist
  if ! git rev-parse --verify "$branch_a" &>/dev/null; then
    echo "❌ Branch '$branch_a' tidak ditemukan."
    return 1
  fi
  if ! git rev-parse --verify "$branch_b" &>/dev/null; then
    echo "❌ Branch '$branch_b' tidak ditemukan."
    return 1
  fi

  # ── Header ────────────────────────────────────────────────────
  echo ""
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║               🔀 Branch Comparison                          ║"
  echo "╚══════════════════════════════════════════════════════════════╝"
  echo ""
  echo "  🅐  $branch_a"
  echo "  🅑  $branch_b"
  echo ""

  # ── Common ancestor ───────────────────────────────────────────
  local merge_base
  merge_base=$(git merge-base "$branch_a" "$branch_b" 2>/dev/null)

  if [ -n "$merge_base" ]; then
    local base_short=$(git rev-parse --short "$merge_base")
    local base_msg=$(git log -1 --pretty=format:"%s" "$merge_base")
    local base_date=$(git log -1 --pretty=format:"%cd" --date=format:"%Y-%m-%d" "$merge_base")
    echo "──────────────────────────────────────────────────────"
    echo "  🌱 Common Ancestor"
    echo "──────────────────────────────────────────────────────"
    echo "  Hash : $base_short"
    echo "  Pesan: $base_msg"
    echo "  Tanggal: $base_date"
    echo ""
  fi

  # ── Ahead / Behind ────────────────────────────────────────────
  local ahead_a=$(git rev-list --count "$branch_b".."$branch_a" 2>/dev/null)
  local ahead_b=$(git rev-list --count "$branch_a".."$branch_b" 2>/dev/null)

  echo "──────────────────────────────────────────────────────"
  echo "  📊 Ahead / Behind"
  echo "──────────────────────────────────────────────────────"
  echo "  🅐  $branch_a : \033[32m↑ $ahead_a commit\033[0m di depan 🅑"
  echo "  🅑  $branch_b : \033[33m↑ $ahead_b commit\033[0m di depan 🅐"
  echo ""

  # ── Commit eksklusif di A (tidak ada di B) ────────────────────
  local commits_only_a
  commits_only_a=$(git log "$branch_b".."$branch_a" --oneline --no-decorate 2>/dev/null)

  echo "──────────────────────────────────────────────────────"
  echo "  📋 Commit hanya di 🅐  $branch_a  ($ahead_a)"
  echo "──────────────────────────────────────────────────────"
  if [ -z "$commits_only_a" ]; then
    echo "  (tidak ada)"
  else
    local i=1
    while read -r line; do
      echo "  [$i] $line"
      ((i++))
    done <<< "$commits_only_a"
  fi
  echo ""

  # ── Commit eksklusif di B (tidak ada di A) ────────────────────
  local commits_only_b
  commits_only_b=$(git log "$branch_a".."$branch_b" --oneline --no-decorate 2>/dev/null)

  echo "──────────────────────────────────────────────────────"
  echo "  📋 Commit hanya di 🅑  $branch_b  ($ahead_b)"
  echo "──────────────────────────────────────────────────────"
  if [ -z "$commits_only_b" ]; then
    echo "  (tidak ada)"
  else
    local i=1
    while read -r line; do
      echo "  [$i] $line"
      ((i++))
    done <<< "$commits_only_b"
  fi
  echo ""

  # ── File yang berbeda antara kedua branch ─────────────────────
  local changed_files
  changed_files=$(git diff --name-status "$branch_a".."$branch_b" 2>/dev/null)

  if [ -n "$filter" ]; then
    changed_files=$(echo "$changed_files" | grep "$filter")
  fi

  echo "──────────────────────────────────────────────────────"
  echo "  📂 Files changed 🅐 → 🅑"
  echo "──────────────────────────────────────────────────────"

  if [ -z "$changed_files" ]; then
    echo "  (tidak ada perbedaan file)"
    echo ""
    return 0
  fi

  # Hitung per status
  local count_m=$(echo "$changed_files" | grep -c '^M' || true)
  local count_a=$(echo "$changed_files" | grep -c '^A' || true)
  local count_d=$(echo "$changed_files" | grep -c '^D' || true)
  local count_r=$(echo "$changed_files" | grep -c '^R' || true)
  local count_c=$(echo "$changed_files" | grep -c '^C' || true)
  local total_files=$(echo "$changed_files" | grep -c '.' || true)

  # fstatus menggantikan status (reserved variable di zsh)
  while IFS=$'\t' read -r fstatus filepath rest; do
    [ -z "$fstatus" ] && continue
    case "${fstatus:0:1}" in
      M) echo "  \033[33m[M]\033[0m  $filepath" ;;  # Modified  → kuning
      A) echo "  \033[32m[A]\033[0m  $filepath" ;;  # Added     → hijau
      D) echo "  \033[31m[D]\033[0m  $filepath" ;;  # Deleted   → merah
      R) echo "  \033[34m[R]\033[0m  $filepath → $rest" ;;  # Renamed → biru
      C) echo "  \033[36m[C]\033[0m  $filepath → $rest" ;;  # Copied  → cyan
      *) echo "  [?]  $filepath" ;;
    esac
  done <<< "$changed_files"

  # ── Summary ───────────────────────────────────────────────────
  echo ""
  echo "══════════════════════════════════════════════════════"
  printf "  Total file: %-4s" "$total_files"
  [ "$count_m" -gt 0 ] && printf "  \033[33mM:%-3s\033[0m" "$count_m"
  [ "$count_a" -gt 0 ] && printf "  \033[32mA:%-3s\033[0m" "$count_a"
  [ "$count_d" -gt 0 ] && printf "  \033[31mD:%-3s\033[0m" "$count_d"
  [ "$count_r" -gt 0 ] && printf "  \033[34mR:%-3s\033[0m" "$count_r"
  [ "$count_c" -gt 0 ] && printf "  \033[36mC:%-3s\033[0m" "$count_c"
  echo ""
  echo "══════════════════════════════════════════════════════"
  echo ""
}

