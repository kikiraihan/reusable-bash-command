_gfbstatus_usage() {
  _gfb_head "gfbstatus" "git status versi lengkap"
  _gfb_sec "Untuk apa"
  _gfb_text "git status versi lengkap: posisi branch vs upstream & base, file"
  _gfb_text "staged/changes/untracked, peringatan file sensitif/besar, stash,"
  _gfb_text "commit belum push/pull, dan saran langkah berikutnya."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbstatus [-b base] [-f] [-a] [-w [detik]] [-r [-p provider] [-m model]]"
  _gfb_sec "Opsi"
  _gfb_opt "-b, --base" "base pembanding (default: master, lalu main)"
  _gfb_opt "-f, --fetch" "git fetch dulu supaya ↑↓ akurat"
  _gfb_opt "-a, --all" "tampilkan semua file (default maks 20 per bagian)"
  _gfb_opt "-w, --watch [s]" "refresh otomatis (default 3 detik), Ctrl+C keluar"
  _gfb_opt "-r, --recap" "recap AI: sebelumnya mengerjakan apa & kapan"
  _gfb_opt "-p, -m" "provider (groq/gemini) & model untuk -r"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Isi"
  _gfb_note "branch & upstream (↑↓), posisi vs base, fetch terakhir, merge/rebase berjalan,"
  _gfb_note "conflict, staged, changes, untracked, ◐ sebagian di-stage, file sensitif/besar,"
  _gfb_note "stash, commit belum push/pull, dan saran langkah berikut."
  _gfb_sec "Contoh"
  _gfb_ex "gfbstatus -f" "fetch dulu"
  _gfb_ex "gfbstatus -w 5" "refresh tiap 5 detik"
  _gfb_ex "gfbstatus -r -p gemini" "status + recap via Gemini"
  print
}

gfbstatus() {
  local base_branch="" do_fetch=false limit=20 watch=0 recap=false provider="groq" model=""
  local large_mb=5  # file staged/untracked di atas ukuran ini diberi peringatan

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbstatus_usage; return 0 ;;
      -b|--base) base_branch="$2"; shift ;;
      -f|--fetch) do_fetch=true ;;
      -a|--all) limit=0 ;;
      -w|--watch)
        watch=3
        if [[ "$2" == <-> ]]; then watch=$2; shift; fi
        ;;
      -r|--recap) recap=true ;;
      -p|--provider) provider="$2"; shift ;;
      -m|--model) model="$2"; shift ;;
      *) _gfb_bad gfbstatus "Argumen tidak dikenal: $1"; return 1 ;;
    esac
    shift
  done

  _gfb_repo || return 1
  local B D N G R Y C M; _gfb_pal
  base_branch=$(_gfb_ref "$base_branch")

  if [ "$recap" = true ]; then
    if (( watch > 0 )); then
      _gfb_err "-r tidak bisa digabung dengan -w (setiap refresh akan memanggil AI)."
      return 1
    fi
    [ -z "$model" ] && { model=$(_gfb_ai_model "$provider") || return 1; }
  fi

  # Mode watch: jalankan ulang gfbstatus terus-menerus (fetch hanya di putaran pertama)
  if (( watch > 0 )); then
    local -a pass=()
    [ -n "$base_branch" ] && pass+=(-b "$base_branch")
    (( limit == 0 )) && pass+=(-a)
    local out first=true
    while true; do
      if [[ "$first" = true && "$do_fetch" = true ]]; then
        out=$(GFB_FORCE_COLOR=1 gfbstatus "${pass[@]}" -f 2>&1)
      else
        out=$(GFB_FORCE_COLOR=1 gfbstatus "${pass[@]}" 2>&1)
      fi
      clear
      print -r -- "$out"
      print -r -- "  ${D}↻ refresh tiap ${watch} detik · $(date +%H:%M:%S) · Ctrl+C untuk keluar${N}"
      first=false
      sleep $watch || break
    done
    return 0
  fi

  # Selalu baca dari root repo, walau dipanggil dari subfolder
  local __gfb_here=$PWD
  builtin cd -q "$(git rev-parse --show-toplevel)" || return 1

  local repo=${PWD:t}
  _gfb_head "gfbstatus" "$repo"

  if [ "$do_fetch" = true ]; then
    _gfb_step "Fetch origin"
    if git fetch --quiet --prune; then
      _gfb_unwait
    else
      _gfb_warn "Fetch gagal, data remote mungkin tidak terbaru."
    fi
  fi

  local branch=$(_gfb_cur)
  local upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)
  local -a hints=()

  # ── Header: branch & upstream ──
  if [ "$branch" = "HEAD" ]; then
    _gfb_kv "branch" "${R}detached HEAD${N} di $(git rev-parse --short HEAD)"
    hints+=("Detached HEAD → buat branch: git switch -c <nama-branch>")
  elif [ -n "$upstream" ]; then
    local lr=(${=$(git rev-list --left-right --count "$upstream"...HEAD 2>/dev/null)})
    local behind=${lr[1]:-0} ahead=${lr[2]:-0}
    local sync="${G}✓ sinkron${N}"
    (( ahead > 0 || behind > 0 )) && sync="${G}↑$ahead${N} ${R}↓$behind${N}"
    _gfb_kv "branch" "${B}$branch${N} ${D}→ $upstream${N}  $sync"
  else
    _gfb_kv "branch" "${B}$branch${N}  ${Y}belum ada upstream${N}"
    hints+=("Belum ada upstream → git push -u origin $branch")
  fi

  if git rev-parse --verify -q HEAD >/dev/null; then
    _gfb_kv "HEAD" "$(git log -1 --format="${Y}%h${N} %s ${D}· %cr · %an${N}")"
  else
    _gfb_kv "HEAD" "${D}belum ada commit${N}"
  fi

  # Posisi vs base branch (pakai origin/<base> kalau ada, lebih up to date)
  if [ -z "$base_branch" ]; then
    local cand
    for cand in master main; do
      if git rev-parse --verify -q "$cand" >/dev/null || git rev-parse --verify -q "origin/$cand" >/dev/null; then
        base_branch=$cand; break
      fi
    done
  fi
  local base_ref=""
  if [[ -n "$base_branch" && "$branch" != "$base_branch" ]]; then
    base_ref=$base_branch
    git rev-parse --verify -q "origin/$base_branch" >/dev/null && base_ref="origin/$base_branch"
    local blr=(${=$(git rev-list --left-right --count "$base_ref"...HEAD 2>/dev/null)})
    if (( ${#blr} == 2 )); then
      _gfb_kv "base" "$base_ref  ${G}$blr[2] di depan${N} ${D}·${N} ${R}$blr[1] di belakang${N}"
      (( blr[1] > 0 )) && hints+=("Tertinggal $blr[1] commit dari $base_ref → git merge $base_ref (atau rebase)")
    fi
  fi

  local fetch_head=$(git rev-parse --git-path FETCH_HEAD)
  if [ -f "$fetch_head" ]; then
    local since=$(( $(date +%s) - $(stat -f %m "$fetch_head") ))
    _gfb_kv "fetch" "$(_gfb_ago $since)"
    (( since > 86400 )) && hints+=("Fetch terakhir sudah lama → gfbstatus -f")
  else
    _gfb_kv "fetch" "${D}belum pernah${N}"
  fi

  # ── Operasi yang sedang berjalan ──
  local op=""
  if   [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
    op="REBASE";      hints+=("Rebase berjalan → git rebase --continue / --abort")
  elif [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
    op="MERGE";       hints+=("Merge berjalan → selesaikan lalu git commit, atau git merge --abort")
  elif [ -f "$(git rev-parse --git-path CHERRY_PICK_HEAD)" ]; then
    op="CHERRY-PICK"; hints+=("Cherry-pick berjalan → git cherry-pick --continue / --abort")
  elif [ -f "$(git rev-parse --git-path REVERT_HEAD)" ]; then
    op="REVERT";      hints+=("Revert berjalan → git revert --continue / --abort")
  elif [ -f "$(git rev-parse --git-path BISECT_LOG)" ]; then
    op="BISECT";      hints+=("Bisect berjalan → git bisect reset kalau sudah selesai")
  fi
  [ -n "$op" ] && { print; _gfb_warn "${R}${B}Sedang $op${N}"; }

  # ── File ──
  local conflicts=$(git diff --name-only --diff-filter=U 2>/dev/null)
  # File conflict hanya ditampilkan di bagian Conflict, bukan di Staged/Changes
  local -a skip=(":/")
  local cfile
  for cfile in ${(f)conflicts}; do skip+=(":(top,literal,exclude)$cfile"); done
  local staged_ns=$(git diff --cached --name-status -M --diff-filter=ACDMRTX -- "${skip[@]}" 2>/dev/null)
  local staged_num=$(git diff --cached --numstat -M --diff-filter=ACDMRTX -- "${skip[@]}" 2>/dev/null)
  local changes_ns=$(git diff --name-status --diff-filter=ACDMRTX -- "${skip[@]}" 2>/dev/null)
  local changes_num=$(git diff --numstat --diff-filter=ACDMRTX -- "${skip[@]}" 2>/dev/null)
  local untracked=$(git ls-files --others --exclude-standard)

  # File yang sebagian di-stage (ada di Staged sekaligus di Changes)
  local -a unstaged_names=(${(f)"$(git diff --name-only -- "${skip[@]}")"})
  local -a staged_names=(${(f)"$(git diff --cached --name-only -- "${skip[@]}")"})
  local partial=${(F)unstaged_names:*staged_names}

  if [ -n "$conflicts" ]; then
    local -a cf=(${(f)conflicts})
    _gfb_sec "${R}Conflict${N}" "${#cf} file"
    local f
    for f in "${cf[@]}"; do print -r -- "    ${R}U${N}  $f"; done
    hints+=("Selesaikan conflict → edit file, lalu git add <file>")
  fi

  if [[ -z "$conflicts" && -z "$staged_ns" && -z "$changes_ns" && -z "$untracked" ]]; then
    print
    _gfb_ok "Working tree bersih"
  else
    if [ -n "$staged_ns" ]; then
      local -a sl=(${(f)staged_ns})
      _gfb_sec "${G}Staged${N}" "${#sl} file · $(_gfb_status_sum "$staged_num") · akan masuk commit"
      _gfb_status_files $limit "$staged_ns" "$staged_num" "$partial"
      hints+=("Ada yang di-stage → gfbcm -c untuk generate message & commit")
    else
      _gfb_sec "${D}Staged${N}" "kosong"
    fi

    if [ -n "$changes_ns" ]; then
      local -a cl=(${(f)changes_ns})
      _gfb_sec "${Y}Changes${N}" "${#cl} file · $(_gfb_status_sum "$changes_num") · belum di-stage"
      _gfb_status_files $limit "$changes_ns" "$changes_num" "$partial"
      [ -n "$partial" ] && hints+=("◐ = sebagian di-stage → git add <file> kalau sisanya juga mau ikut commit")
    else
      _gfb_sec "${D}Changes${N}" "kosong"
    fi

    if [ -n "$untracked" ]; then
      local -a ul=(${(f)untracked})
      _gfb_sec "${C}Untracked${N}" "${#ul} file · file baru, belum di-track"
      local i
      for (( i = 1; i <= ${#ul}; i++ )); do
        if (( limit > 0 && i > limit )); then
          print -r -- "    ${D}… +$(( ${#ul} - limit )) file lainnya (pakai -a untuk semua)${N}"
          break
        fi
        print -r -- "    ${C}?${N}  ${ul[i]}"
      done
    fi
  fi

  if [[ -z "$staged_ns" && ( -n "$changes_ns" || -n "$untracked" ) ]]; then
    hints+=("Belum ada yang di-stage → git add <file> (atau git add -p untuk sebagian)")
  fi

  # ── Peringatan: file sensitif / besar di staged atau untracked ──
  local -a warns=()
  local wfile wbase wsize kind
  local -a staged_files=(${(f)"$(git diff --cached --name-only --diff-filter=ACMRT -- "${skip[@]}")"})
  for wfile in "${staged_files[@]}" ${(f)untracked}; do
    [ -z "$wfile" ] && continue
    kind="staged"
    (( ${staged_files[(Ie)$wfile]} )) || kind="untracked"
    wbase=${wfile:t}
    case $wbase in
      .env.example|.env.sample|.env.template|*.pub) ;;
      .env|.env.*|*.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|id_rsa*|id_ed25519*|id_ecdsa*|credentials*.json|service-account*.json|*.sqlite|*.sqlite3)
        warns+=("${R}secret${N}  $wfile ${D}($kind) — kemungkinan berisi secret${N}")
        ;;
    esac
    if [ -f "$wfile" ]; then
      wsize=$(stat -f %z "$wfile" 2>/dev/null)
      if (( wsize > large_mb * 1024 * 1024 )); then
        warns+=("${Y}besar${N}   $wfile ${D}($kind) — $(( wsize / 1024 / 1024 )) MB${N}")
      fi
    fi
  done
  if (( ${#warns} )); then
    _gfb_sec "${R}Perhatian${N}" "${#warns}"
    printf "    %s\n" "${warns[@]}"
    hints+=("File sensitif/besar → tambahkan ke .gitignore (kalau sudah staged: git restore --staged <file>)")
  fi

  # ── Stash ──
  local stash_count=$(git stash list 2>/dev/null | wc -l | tr -d ' ')
  if (( stash_count > 0 )); then
    _gfb_sec "Stash" "$stash_count"
    print -r -- "    ${D}terakhir:${N} $(git stash list -1 --format='%gs · %cr')"
  fi

  # ── Commit belum di-push / belum di-pull ──
  if [ -n "$upstream" ]; then
    local unpushed=$(git log --format="    ${Y}%h${N}  %s ${D}· %cr${N}" "$upstream"..HEAD 2>/dev/null)
    local unpulled=$(git log --format="    ${Y}%h${N}  %s ${D}· %cr · %an${N}" HEAD.."$upstream" 2>/dev/null)
    if [ -n "$unpushed" ]; then
      local -a up=(${(f)unpushed})
      _gfb_sec "${G}Belum di-push${N}" "${#up} commit"
      printf "%s\n" "${up[1,10]}"
      (( ${#up} > 10 )) && print -r -- "    ${D}… +$(( ${#up} - 10 )) commit lainnya${N}"
      hints+=("Ada commit belum di-push → git push")
    fi
    if [ -n "$unpulled" ]; then
      local -a dn=(${(f)unpulled})
      _gfb_sec "${R}Belum di-pull${N}" "${#dn} commit"
      printf "%s\n" "${dn[1,10]}"
      (( ${#dn} > 10 )) && print -r -- "    ${D}… +$(( ${#dn} - 10 )) commit lainnya${N}"
      hints+=("Ada commit baru di remote → git pull")
    fi
  fi

  builtin cd -q "$__gfb_here"

  # ── Saran ──
  if (( ${#hints} )); then
    _gfb_sec "Langkah berikut"
    local h
    for h in "${hints[@]}"; do _gfb_bullet "$h"; done
  else
    print
    _gfb_ok "${G}Bersih & sinkron, tidak ada yang perlu dilakukan.${N}"
  fi

  # ── Recap AI (opsional, -r) ──
  [ "$recap" = true ] && _gfb_status_recap "$provider" "$model" "$base_ref"
  print
}

# ════════════════════════════════════════════════════════════════════
# gfblarklink — link Lark (Story & Issue) dari ID di nama branch
# Satu ID bisa Story (feat) atau Issue (fix), jadi selalu tampil KEDUA link,
# diurutkan mana yang lebih mungkin (nama branch mengandung "fix" → Issue duluan).
# Deteksi ID: AI (Groq/Gemini) → fallback angka di nama branch → input manual.
#   gfblarklink                                  → dari branch aktif
#   gfblarklink kiki/feat/split-payment-23729368 → dari branch tertentu
#   gfblarklink -i 23687966                      → ID manual
#   gfblarklink @ -p gemini                      → pakai Gemini
# ════════════════════════════════════════════════════════════════════
_gfblarklink_usage() {
  _gfb_head "gfblarklink" "link Lark (Story & Issue) dari nama branch"
  _gfb_sec "Untuk apa"
  _gfb_text "Buat link ticket Lark (Story & Issue) dari ID yang ada di nama branch,"
  _gfb_text "lalu bisa di-copy ke clipboard."
  _gfb_sec "Pemakaian"
  _gfb_use "gfblarklink [branch] [-i id] [-p provider] [-m model]"
  _gfb_note "default: branch aktif, provider groq"
  _gfb_sec "Argumen"
  _gfb_opt "[branch]" "nama branch sumber ID, default branch aktif (@)"
  _gfb_sec "Opsi"
  _gfb_opt "-i, --id" "pakai ID manual, skip deteksi"
  _gfb_opt "-p, --provider" "groq (default) atau gemini, untuk deteksi ID"
  _gfb_opt "-m, --model" "pilih model manual"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfblarklink" "dari branch aktif"
  _gfb_ex "gfblarklink kiki/feat/split-payment-23729368" "dari branch tertentu"
  _gfb_ex "gfblarklink -i 23687966" "ID manual"
  _gfb_sec "Catatan"
  _gfb_note "Selalu tampil 2 link; nama branch mengandung 'fix' → Issue duluan."
  _gfb_note "Kalau ID tidak ketemu otomatis, kamu akan diminta input manual."
  print
}

gfblarklink() {
  # Base URL Lark, ubah di sini kalau formatnya berubah
  local LARK_STORY_BASE_URL="https://project.larksuite.com/spd/story/detail/"
  local LARK_ISSUE_BASE_URL="https://project.larksuite.com/spd/issue/detail/"

  local branch_name="" manual_id="" provider="groq" model=""

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfblarklink_usage; return 0 ;;
      -i|--id) manual_id="$2"; shift ;;
      -p|--provider) provider="$2"; shift ;;
      -m|--model) model="$2"; shift ;;
      -*) _gfb_bad gfblarklink "Flag tidak dikenal: $1"; return 1 ;;
      *) [ -z "$branch_name" ] && branch_name="$1" ;;
    esac
    shift
  done

  local B D N G R Y C M; _gfb_pal
  branch_name=$(_gfb_ref "${branch_name:-@}")

  _gfb_head "gfblarklink" "link Lark dari nama branch"
  _gfb_kv "branch" "$branch_name"

  local prd_id="$manual_id" id_source="manual (-i)"

  # Kalau user sudah kasih ID manual lewat -i, skip semua deteksi
  if [ -z "$prd_id" ]; then
    [ -z "$model" ] && { model=$(_gfb_ai_model "$provider") || return 1; }

    if _gfb_ai_key "$provider" quiet; then
      local prompt="Extract the numeric PRD/story ID from this git branch name. The ID is usually a sequence of digits (5 digits or more) embedded somewhere in the branch name. Return ONLY the number, nothing else, no explanation, no punctuation. If there is no clear numeric ID, return exactly: NONE
Branch name: $branch_name"
      _gfb_step "Deteksi ID via $provider…"
      local result
      result=$(_gfb_ai_generate "$provider" "$model" "$prompt" 0 2>/dev/null)
      _gfb_unwait
      # Ambil digit saja kalau AI kasih tambahan teks
      result=$(print -r -- "$result" | grep -oE '[0-9]+' | head -1)
      [ -n "$result" ] && { prd_id="$result"; id_source="AI ($provider)"; }
    else
      _gfb_info "API key $provider belum di-set, pakai angka dari nama branch."
    fi

    # Fallback: ambil angka terakhir di nama branch
    if [ -z "$prd_id" ]; then
      prd_id=$(print -r -- "$branch_name" | grep -oE '[0-9]+' | tail -1)
      [ -n "$prd_id" ] && id_source="angka di nama branch"
    fi
  fi

  # Kalau masih belum ketemu, minta input manual
  if [ -z "$prd_id" ]; then
    print
    _gfb_warn "ID PRD tidak ditemukan otomatis di nama branch."
    _gfb_ask prd_id "Masukkan ID PRD"
    id_source="input manual"
  fi

  if [ -z "$prd_id" ] || ! [[ "$prd_id" =~ ^[0-9]+$ ]]; then
    _gfb_err "ID PRD tidak valid."
    return 1
  fi

  _gfb_kv "ID" "${B}$prd_id${N}  ${D}($id_source)${N}"

  local story_link="${LARK_STORY_BASE_URL}${prd_id}"
  local issue_link="${LARK_ISSUE_BASE_URL}${prd_id}"

  # Tebak tipe ticket paling mungkin dari nama branch: "fix" → Issue duluan, selain itu → Story duluan
  local first_label="Story" first_link="$story_link" second_label="Issue" second_link="$issue_link"
  if [[ "$branch_name" == *fix* ]]; then
    first_label="Issue"; first_link="$issue_link"
    second_label="Story"; second_link="$story_link"
  fi

  _gfb_sec "Link" "paling mungkin di atas"
  _gfb_item 1 "${B}$first_label${N}  ${C}$first_link${N}"
  _gfb_item 2 "${B}$second_label${N}  ${C}$second_link${N}"

  local copy
  _gfb_ask copy "Copy link ke clipboard?" "(1 / 2, Enter = lewati)"
  case $copy in
    1) _gfb_copy "$first_link" ;;
    2) _gfb_copy "$second_link" ;;
  esac
  print
}

# ════════════════════════════════════════════════════════════════════
# gfblarkbranch — kebalikan gfblarklink: dari link/ID Lark → branch terkait
# Cari branch (lokal + origin) yang namanya memuat ID ticket. Di dalam
# workspace multi-repo (.gfbwt-ws) semua repo ikut dicari.
#   gfblarkbranch https://project.larksuite.com/spd/issue/detail/24947357
#   gfblarkbranch 24947357
#   gfblarkbranch -c 24947357   → + branch yang memuat commit ber-ID ini
#   gfblarkbranch -r 24947357   → repo ini saja (abaikan workspace)
#   gfblarkbranch -x 24947357   → tanpa fetch (offline / lebih cepat)
# ════════════════════════════════════════════════════════════════════
_gfblarkbranch_usage() {
  _gfb_head "gfblarkbranch" "branch terkait dari link/ID Lark"
  _gfb_sec "Untuk apa"
  _gfb_text "Kebalikan gfblarklink: tempel link ticket Lark (Story/Issue) atau ID-nya,"
  _gfb_text "lalu tampil branch yang namanya memuat ID itu — lokal & origin, worktree,"
  _gfb_text "dan apakah sudah merged ke base. Di workspace multi-repo, semua repo dicari."
  _gfb_sec "Pemakaian"
  _gfb_use "gfblarkbranch [-c] [-r] [-x] <link-lark | id>"
  _gfb_sec "Argumen"
  _gfb_opt "<link-lark | id>" "link .../story|issue/detail/<id>, atau ID angkanya"
  _gfb_sec "Opsi"
  _gfb_opt "-c, --commits" "+ branch yang memuat commit dengan ID di message-nya"
  _gfb_opt "-r, --repo" "repo ini saja, walau di dalam workspace"
  _gfb_opt "-x, --no-fetch" "tanpa fetch origin (lebih cepat, bisa kurang update)"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_note "flag pendek bisa digabung: -cx"
  _gfb_sec "Contoh"
  _gfb_ex "gfblarkbranch https://project.larksuite.com/spd/issue/detail/24947357"
  _gfb_ex "gfblarkbranch 24947357" "ID saja"
  _gfb_ex "gfblarkbranch -c 24947357" "+ develop/master yang sudah memuat commit-nya"
  _gfb_sec "Catatan"
  _gfb_note "ID dicocokkan utuh: 2494735 tidak ikut cocok dengan 24947357."
  _gfb_note "Base untuk status merged: kolom base di .gfbwt-ws, atau origin/HEAD."
  print
}

gfblarkbranch() {
  local LARK_STORY_BASE_URL="https://project.larksuite.com/spd/story/detail/"
  local LARK_ISSUE_BASE_URL="https://project.larksuite.com/spd/issue/detail/"

  local input="" only_repo=false do_fetch=true with_commits=false i c
  local -a extra_args=()
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfblarkbranch_usage; return 0 ;;
      --commits) with_commits=true ;;
      --repo) only_repo=true ;;
      --no-fetch) do_fetch=false ;;
      --*) _gfb_bad gfblarkbranch "Flag tidak dikenal: $1"; return 1 ;;
      -?*)
        for (( i = 2; i <= ${#1}; i++ )); do
          c=${1[i]}
          case $c in
            c) with_commits=true ;;
            r) only_repo=true ;;
            x) do_fetch=false ;;
            h) _gfblarkbranch_usage; return 0 ;;
            *) _gfb_bad gfblarkbranch "Flag tidak dikenal: -$c (dari $1)"; return 1 ;;
          esac
        done
        ;;
      *) if [ -z "$input" ]; then input="$1"; else extra_args+=("$1"); fi ;;
    esac
    shift
  done
  if (( ${#extra_args} )); then
    _gfb_bad gfblarkbranch "Argumen berlebih: ${extra_args[*]}"
    return 1
  fi
  if [ -z "$input" ]; then
    _gfb_bad gfblarkbranch "Link Lark atau ID wajib diisi."
    return 1
  fi

  local B D N G R Y C M; _gfb_pal

  # ── Ambil ID (+ tipe kalau dari link) ──
  local id="" kind=""
  if [[ "$input" =~ '/(story|issue)/detail/([0-9]+)' ]]; then
    kind=${match[1]} id=${match[2]}
  elif [[ "$input" == <-> ]]; then
    id=$input
  else
    id=$(print -r -- "$input" | grep -oE '[0-9]{5,}' | tail -1)
  fi
  if [ -z "$id" ]; then
    _gfb_err "ID tidak ditemukan di '$input'."
    _gfb_note "Contoh: ${LARK_ISSUE_BASE_URL}24947357 atau 24947357" >&2
    return 1
  fi

  # ── Repo yang dicari: semua repo workspace, atau repo ini ──
  local ws="" d
  local -a ws_alias ws_repo ws_base dirs labels aliases bases
  if ! $only_repo && ws=$(_gfbwt_ws_find); then
    _gfbwt_ws_conf "$ws"
    for (( i = 1; i <= ${#ws_repo}; i++ )); do
      d="$ws/${ws_repo[i]}"
      git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || continue
      dirs+=("$d") labels+=("${ws_repo[i]}") aliases+=("${ws_alias[i]}") bases+=("${ws_base[i]}")
    done
  fi
  if (( ${#dirs} == 0 )); then
    ws=""
    _gfb_repo || { _gfb_note "Atau jalankan dari dalam workspace multi-repo (.gfbwt-ws)." >&2; return 1; }
    d=$(git rev-parse --show-toplevel)
    dirs=("$d") labels=("${d:t}") aliases=("") bases=("")
  fi

  _gfb_head "gfblarkbranch" "branch terkait ticket Lark"
  _gfb_kv "ID" "${B}$id${N}${kind:+  ${D}($kind)${N}}"
  case $kind in
    story) _gfb_kv "link" "${C}${LARK_STORY_BASE_URL}$id${N}" ;;
    issue) _gfb_kv "link" "${C}${LARK_ISSUE_BASE_URL}$id${N}" ;;
  esac
  if [ -n "$ws" ]; then
    _gfb_kv "cari di" "${#dirs} repo workspace ${D}(${ws/#$HOME/~})${N}"
  else
    _gfb_kv "cari di" "${labels[1]}"
  fi

  # ── Fetch semua repo paralel ──
  if $do_fetch; then
    setopt localoptions nomonitor nonotify
    print
    _gfb_step "Fetch origin${ws:+ (${#dirs} repo)}"
    for d in "${dirs[@]}"; do git -C "$d" fetch -q --prune origin >/dev/null 2>&1 & done
    wait
    _gfb_unwait
  fi

  # ── Cari per repo ──
  local -a picks=() hit_aliases=()
  local total=0 r ref name base_ref loc wt_note merged_note when
  local -a wt_path wt_branch wt_head wt_flag order via_commit
  local -A has_local has_remote seen
  local sha
  for (( r = 1; r <= ${#dirs}; r++ )); do
    d=${dirs[r]}
    has_local=() has_remote=() order=() via_commit=() seen=()

    # Urut dari commit terbaru; ID harus utuh (tidak diapit angka lain)
    for ref in ${(f)"$(git -C "$d" for-each-ref --sort=-committerdate --format='%(refname)' refs/heads refs/remotes/origin)"}; do
      case $ref in
        refs/heads/*) name=${ref#refs/heads/} ;;
        refs/remotes/origin/HEAD) continue ;;
        *) name=${ref#refs/remotes/origin/} ;;
      esac
      [[ "$name" =~ "(^|[^0-9])${id}([^0-9]|\$)" ]] || continue
      (( ${+has_local[$name]} || ${+has_remote[$name]} )) || order+=("$name")
      if [[ $ref == refs/heads/* ]]; then has_local[$name]=1; else has_remote[$name]=1; fi
    done

    # -c: branch lain yang memuat commit dengan ID di message
    if $with_commits; then
      for name in "${order[@]}"; do seen[$name]=1; done
      for sha in ${(f)"$(git -C "$d" log --all --fixed-strings --grep="$id" --format=%H -n 30 2>/dev/null)"}; do
        for ref in ${(f)"$(git -C "$d" for-each-ref --contains "$sha" --format='%(refname)' refs/heads refs/remotes/origin)"}; do
          case $ref in
            refs/heads/*) name=${ref#refs/heads/} ;;
            refs/remotes/origin/HEAD) continue ;;
            *) name=${ref#refs/remotes/origin/} ;;
          esac
          (( ${+seen[$name]} )) && continue
          seen[$name]=1
          via_commit+=("$name")
        done
      done
    fi

    (( ${#order} + ${#via_commit} )) || continue

    # Base untuk status merged: kolom .gfbwt-ws → origin/HEAD
    base_ref=""
    if [ -n "${bases[r]}" ] && git -C "$d" rev-parse -q --verify "origin/${bases[r]}" >/dev/null; then
      base_ref="origin/${bases[r]}"
    else
      base_ref=$(git -C "$d" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)
    fi
    _gfbwt_load "$d"

    _gfb_sec "${labels[r]}" "${aliases[r]:+${aliases[r]} · }${#order} branch${base_ref:+ · base $base_ref}"
    [ -n "${aliases[r]}" ] && hit_aliases+=("${aliases[r]}")

    for name in "${order[@]}"; do
      ref=$name
      (( ${+has_local[$name]} )) || ref="origin/$name"
      if (( ${+has_local[$name]} && ${+has_remote[$name]} )); then loc="lokal + origin"
      elif (( ${+has_local[$name]} )); then loc="${Y}lokal saja${N}"
      else loc="origin saja"; fi
      when=$(git -C "$d" log -1 --format=%cr "$ref" 2>/dev/null)
      merged_note=""
      if [ -n "$base_ref" ] && git -C "$d" merge-base --is-ancestor "$ref" "$base_ref" 2>/dev/null; then
        merged_note="  ${G}✔ merged ke ${base_ref#origin/}${N}"
      fi
      wt_note=""
      i=${wt_branch[(Ie)$name]}
      (( i > 1 )) && wt_note="  ${C}⎇ ${wt_path[i]/#$HOME/~}${N}"
      (( i == 1 )) && wt_note="  ${C}⎇ repo utama${N}"
      (( total++ ))
      picks+=("$name")
      _gfb_item $total "${B}$name${N}  ${D}· $loc · $when${N}$merged_note$wt_note"
    done

    if (( ${#via_commit} )); then
      _gfb_note "memuat commit ticket ini: ${(j:, :)via_commit}"
    fi
  done

  if (( total == 0 )); then
    print
    _gfb_warn "Tidak ada branch dengan ID $id di namanya."
    $with_commits || _gfb_hint "gfblarkbranch -c $id" "cari juga dari message commit"
    print
    return 1
  fi

  _gfb_sec "Langkah berikut"
  if [ -n "$ws" ] && (( ${#hit_aliases} )); then
    _gfb_hint "gfbwt ws add <branch> ${hit_aliases[*]}" "buka di workspace"
  else
    _gfb_hint "gfbwt add <branch>" "buka sebagai worktree"
  fi
  _gfb_hint "git switch <branch>" "atau checkout biasa"

  local pick
  _gfb_ask pick "Copy nama branch ke clipboard?" "(nomor, Enter = lewati)"
  if [[ "$pick" == <-> ]] && (( pick >= 1 && pick <= total )); then
    _gfb_copy "${picks[pick]}"
  elif [ -n "$pick" ]; then
    _gfb_warn "Nomor tidak valid: $pick"
  fi
  print
}
_gfblarkbranch() {
  _arguments -s \
    '-c[+ branch dari message commit]' '-r[repo ini saja]' '-x[tanpa fetch]' '-h[bantuan]' \
    '1:link Lark atau ID:'
}
(( $+functions[compdef] )) && compdef _gfblarkbranch gfblarkbranch

# ════════════════════════════════════════════════════════════════════
# gfbconflict — cek conflict antar branch tanpa benar-benar merge
#   gfbconflict master kiki/feat/SP-829 kiki/feat/SP-927
# ════════════════════════════════════════════════════════════════════
_gfbconflict_usage() {
  _gfb_head "gfbconflict" "cek conflict tanpa merge sungguhan"
  _gfb_sec "Untuk apa"
  _gfb_text "Cek apakah beberapa branch akan conflict kalau di-merge ke base, tanpa"
  _gfb_text "benar-benar merge. Aman: dicoba di branch sementara lalu dibatalkan."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbconflict <base-branch> <branch1> [branch2 ...]"
  _gfb_note "tiap branch dicoba merge ke base (di branch sementara), lalu dibatalkan"
  _gfb_sec "Argumen"
  _gfb_opt "<base-branch>" "branch tujuan merge, di-pull dulu (@ = branch aktif)"
  _gfb_opt "<branch...>" "satu atau lebih branch yang dicek"
  _gfb_sec "Contoh"
  _gfb_ex "gfbconflict master kiki/feat/SP-829 kiki/feat/SP-927"
  _gfb_ex "gfbconflict dev_sprint_9a @" "branch aktif vs dev_sprint_9a"
  print
}

gfbconflict() {
  [[ "$1" == -h || "$1" == --help ]] && { _gfbconflict_usage; return 0; }
  if [ "$#" -lt 2 ]; then
    _gfb_bad gfbconflict "Butuh base branch dan minimal 1 branch yang dicek."
    return 1
  fi
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local base_branch=$(_gfb_ref "$1"); shift
  local -a branches=()
  local b
  for b in "$@"; do branches+=("$(_gfb_ref "$b")"); done

  local original_branch=$(_gfb_cur)
  local temp_branch="__gfbconflict_temp__"

  if ! git diff --quiet || ! git diff --cached --quiet; then
    _gfb_err "Ada uncommitted changes. Stash atau commit dulu sebelum cek conflict."
    return 1
  fi

  _gfb_head "gfbconflict" "cek conflict tanpa merge sungguhan"
  _gfb_kv "base" "$base_branch"
  _gfb_kv "cek" "${#branches} branch"
  print

  _gfb_step "Pull $base_branch"
  if ! { git checkout -q "$base_branch" && git pull -q origin "$base_branch"; }; then
    _gfb_err "Gagal update $base_branch."
    git checkout -q "$original_branch"
    return 1
  fi

  # Branch sementara dari base (hapus sisa run sebelumnya kalau ada)
  git branch -q -D "$temp_branch" 2>/dev/null
  git checkout -q -b "$temp_branch"

  local w=0
  for b in "${branches[@]}"; do (( ${#b} > w )) && w=${#b}; done

  _gfb_sec "Hasil"
  local -a clean_list=() conflict_list=() missing_list=()
  for b in "${branches[@]}"; do
    if ! git rev-parse --verify -q "$b^{commit}" >/dev/null; then
      missing_list+=("$b")
      print -r -- "    ${Y}?${N} ${(r:w:)b}  ${Y}tidak ditemukan${N}"
      continue
    fi

    if git merge --no-commit --no-ff -q "$b" >/dev/null 2>&1; then
      clean_list+=("$b")
      print -r -- "    ${G}✔${N} ${(r:w:)b}  ${G}aman${N}"
    else
      local -a fl=(${(f)"$(git diff --name-only --diff-filter=U)"})
      conflict_list+=("$b")
      print -r -- "    ${R}✖${N} ${(r:w:)b}  ${R}conflict${N} ${D}· ${#fl} file${N}"
      local f
      for f in "${fl[@]}"; do print -r -- "        ${D}└${N} $f"; done
    fi

    # Abort merge & reset ke base agar cek berikutnya fresh
    git merge --abort 2>/dev/null
    git reset -q --hard "$base_branch"
  done

  git checkout -q "$original_branch"
  git branch -q -D "$temp_branch"

  print
  _gfb_rule
  local summary="  ${G}✔ ${#clean_list} aman${N}    ${R}✖ ${#conflict_list} conflict${N}"
  (( ${#missing_list} )) && summary+="    ${Y}? ${#missing_list} tidak ditemukan${N}"
  print -r -- "$summary"
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbdel — hapus branch di lokal dan origin sekaligus
# Aman: branch penting (master, main, develop, staging, production) tidak bisa dihapus
#   gfbdel                       → pilih dari list
#   gfbdel kiki/feat/SP-829      → langsung
#   gfbdel -f feature            → filter list
#   gfbdel -lo kiki/feat/SP-829  → lokal saja
#   gfbdel -ro kiki/feat/SP-829  → origin saja
# ════════════════════════════════════════════════════════════════════
_gfbdel_usage() {
  _gfb_head "gfbdel" "hapus branch lokal + origin"
  _gfb_sec "Untuk apa"
  _gfb_text "Hapus satu branch di lokal dan origin sekaligus,"
  _gfb_text "pilih dari daftar atau langsung sebut namanya."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbdel [branch] [-f keyword] [-lo | -ro]"
  _gfb_note "tanpa branch → pilih dari daftar"
  _gfb_sec "Argumen"
  _gfb_opt "[branch]" "branch yang dihapus; kosong = pilih dari daftar"
  _gfb_sec "Opsi"
  _gfb_opt "-f, --filter" "filter daftar branch"
  _gfb_opt "-lo, --local-only" "hapus lokal saja"
  _gfb_opt "-ro, --remote-only" "hapus origin saja"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfbdel" "pilih dari daftar"
  _gfb_ex "gfbdel kiki/feat/SP-829" "langsung hapus"
  _gfb_ex "gfbdel -f feature" "filter daftar"
  _gfb_ex "gfbdel -lo kiki/feat/SP-829" "lokal saja"
  _gfb_sec "Proteksi"
  _gfb_note "master, main, develop, staging, production & branch aktif tidak bisa dihapus."
  print
}

gfbdel() {
  local branch_input="" filter="" local_only=false remote_only=false

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbdel_usage; return 0 ;;
      -f|--filter) filter="$2"; shift ;;
      -lo|--local-only)  local_only=true ;;
      -ro|--remote-only) remote_only=true ;;
      -*) _gfb_bad gfbdel "Flag tidak dikenal: $1"; return 1 ;;
      *) [ -z "$branch_input" ] && branch_input="$1" ;;
    esac
    shift
  done
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  branch_input=$(_gfb_ref "$branch_input")

  _gfb_head "gfbdel" "hapus branch lokal + origin"

  # Branch langsung diberikan → skip daftar
  if [ -n "$branch_input" ]; then
    if [[ "$branch_input" =~ $GFB_PROTECTED ]]; then
      _gfb_err "Branch '$branch_input' dilindungi, tidak bisa dihapus."
      return 1
    fi
    _gfbdel_execute "$branch_input" "$local_only" "$remote_only"
    return $?
  fi

  _gfb_step "Fetch origin"
  git fetch --quiet --prune 2>/dev/null
  _gfb_unwait

  local current_branch=$(_gfb_cur)
  local branches
  branches=$(git branch --format='%(refname:short)' | grep -vE "$GFB_PROTECTED")
  [ -n "$filter" ] && branches=$(print -r -- "$branches" | grep -- "$filter")

  if [ -z "$branches" ]; then
    _gfb_warn "Tidak ada branch${filter:+ yang cocok dengan '$filter'} yang bisa dihapus."
    print
    return 0
  fi

  local -a branch_list=(${(f)branches})
  _gfb_sec "Branch lokal" "${#branch_list}"
  local i extra
  for (( i = 1; i <= ${#branch_list}; i++ )); do
    extra="${D}· $(git log -1 --format=%cr "${branch_list[i]}")${N}"
    [ "${branch_list[i]}" = "$current_branch" ] && extra="${G}● aktif${N}"
    _gfb_item $i "${branch_list[i]}  $extra"
  done

  local selection
  _gfb_ask selection "Pilih nomor branch" "(Enter = batal)"

  if [ -z "$selection" ]; then
    _gfb_info "Tidak ada yang dipilih. Dibatalkan."
    print
    return 0
  fi
  if ! [[ "$selection" == <-> ]] || (( selection < 1 || selection > ${#branch_list} )); then
    _gfb_err "Nomor tidak valid: $selection"
    return 1
  fi

  _gfbdel_execute "${branch_list[selection]}" "$local_only" "$remote_only"
}

# Helper internal untuk gfbdel: eksekusi hapus branch lokal dan/atau origin
_gfbdel_execute() {
  local branch="$1" local_only="$2" remote_only="$3"
  local B D N G R Y C M; _gfb_pal

  if [ "$(_gfb_cur)" = "$branch" ]; then
    _gfb_err "Kamu sedang berada di branch '$branch'."
    _gfb_hint "git switch <branch-lain>" "pindah dulu sebelum menghapus"
    return 1
  fi

  # Branch terbuka di worktree lain → git tidak bisa menghapus branch lokalnya
  local wt_at
  if [ "$remote_only" != true ] && wt_at=$(_gfbwt_path_of "$branch"); then
    _gfb_err "Branch '$branch' sedang terbuka di worktree:"
    _gfb_note "${wt_at/#$HOME/~}" >&2
    _gfb_hint "gfbwt rm -b $branch" "hapus worktree + branch sekaligus"
    return 1
  fi

  local has_local=false has_remote=false
  git show-ref --verify --quiet "refs/heads/$branch"          && has_local=true
  git show-ref --verify --quiet "refs/remotes/origin/$branch" && has_remote=true

  if ! $has_local && ! $has_remote; then
    _gfb_err "Branch '$branch' tidak ditemukan (lokal maupun origin)."
    return 1
  fi

  local do_local=false do_remote=false
  $has_local  && ! $remote_only && do_local=true
  $has_remote && ! $local_only  && do_remote=true

  local local_label origin_label
  if $do_local; then local_label="${R}hapus${N}"
  elif $has_local; then local_label="${D}dilewati (-ro)${N}"
  else local_label="${D}tidak ada${N}"; fi
  if $do_remote; then origin_label="${R}hapus${N}"
  elif $has_remote; then origin_label="${D}dilewati (-lo)${N}"
  else origin_label="${D}tidak ada${N}"; fi

  _gfb_sec "Akan dihapus"
  _gfb_kv "branch" "${B}$branch${N}"
  _gfb_kv "lokal" "$local_label"
  _gfb_kv "origin" "$origin_label"

  if ! $do_local && ! $do_remote; then
    print
    _gfb_warn "Tidak ada yang bisa dihapus dengan opsi ini."
    print
    return 1
  fi

  if ! _gfb_confirm "Lanjut hapus?" n; then
    _gfb_info "Dibatalkan."
    print
    return 0
  fi

  print
  if $do_local; then
    _gfb_step "Hapus lokal"
    git branch -q -d "$branch" 2>/dev/null || git branch -q -D "$branch" || { _gfb_err "Gagal hapus lokal."; return 1; }
  fi
  if $do_remote; then
    _gfb_step "Hapus origin"
    git push -q origin --delete "$branch" || { _gfb_err "Gagal hapus di origin."; return 1; }
  fi

  print
  _gfb_ok "Branch ${B}$branch${N} dihapus."
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbrenew — perbarui branch dengan base terbaru (default master)
# Branch di-backup jadi <branch>-old-<YYYYMMDD>[-N], dibuat ulang dari
# origin/<base>, lalu backup di-merge ke branch baru. Backup dihapus paling
# akhir (opsional), jadi kalau ada masalah tidak ada pekerjaan yang hilang.
#   gfbrenew                 → branch aktif, base master, tanya hapus backup
#   gfbrenew kiki/feat/SP-1  → branch lain, tanpa checkout (merge di memori)
#   gfbrenew -b develop      → base develop
#   gfbrenew -d / -k         → hapus / simpan backup tanpa tanya
#   gfbrenew -p              → push branch baru (fast-forward, tanpa force)
#   gfbrenew -n              → dry-run (sekalian prediksi conflict)
# ════════════════════════════════════════════════════════════════════
_gfbrenew_usage() {
  _gfb_head "gfbrenew" "perbarui branch dengan base terbaru"
  _gfb_sec "Untuk apa"
  _gfb_text "Branch di-backup jadi <branch>-old-<tanggal>, dibuat ulang dari"
  _gfb_text "origin/<base> terbaru dengan nama yang sama, lalu backup di-merge ke sana."
  _gfb_text "Backup baru dihapus paling akhir (opsional) supaya tidak ada kerjaan hilang."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbrenew [-b base] [-d | -k] [-p] [-y] [-n] [branch]"
  _gfb_sec "Argumen"
  _gfb_opt "[branch]" "branch yang diperbarui; kosong / @ = branch aktif"
  _gfb_sec "Opsi"
  _gfb_opt "-b, --base <base>" "base branch (default: master)"
  _gfb_opt "-d, --delete-old" "hapus backup di akhir tanpa tanya"
  _gfb_opt "-k, --keep-old" "simpan backup tanpa tanya"
  _gfb_opt "-p, --push" "push branch baru ke origin (fast-forward, tanpa force)"
  _gfb_opt "-y, --yes" "tanpa konfirmasi awal"
  _gfb_opt "-n, --dry-run" "hanya tampilkan rencana + prediksi conflict"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_note "flag pendek bisa digabung: -dp, -kpy"
  _gfb_sec "Branch aktif vs branch lain"
  _gfb_note "aktif     → checkout + merge biasa; conflict bisa diselesaikan di tempat"
  _gfb_note "lain      → tanpa checkout, merge di memori; kerjaan & uncommitted changes"
  _gfb_note "            di branch aktif tidak tersentuh. Kalau akan conflict, dibatalkan"
  _gfb_note "            sebelum ada yang berubah."
  _gfb_note "worktree  → branch yang terbuka di worktree lain: jalankan dari worktree itu"
  _gfb_sec "Dibatalkan otomatis kalau"
  _gfb_note "tidak ada commit baru dari base, ada uncommitted changes (branch aktif),"
  _gfb_note "branch lokal tertinggal dari origin, atau branch lain yang akan conflict."
  _gfb_sec "Nama backup"
  _gfb_note "<branch>-old-YYYYMMDD; kalau sudah ada → -2, -3, ... (hanya lokal, tidak di-push)"
  _gfb_sec "Contoh"
  _gfb_ex "gfbrenew" "split-payment → split-payment-old-20261111"
  _gfb_ex "gfbrenew kiki/feat/SP-829" "branch lain, tanpa pindah branch"
  _gfb_ex "gfbrenew -b develop @" "branch aktif, base develop"
  _gfb_ex "gfbrenew -dp" "hapus backup + push"
  _gfb_ex "gfbrenew -n kiki/feat/SP-829" "rencana + prediksi conflict"
  _gfb_sec "Kalau conflict (branch aktif)"
  _gfb_note "Proses berhenti di tengah merge; backup tetap aman. Selesaikan lalu commit,"
  _gfb_note "atau batalkan & kembalikan seperti semula dengan perintah yang ditampilkan."
  print
}

gfbrenew() {
  local base="master" delete_old="" push_to_origin=false assume_yes=false dry_run=false
  local branch="" i c
  local -a extra_args=()

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbrenew_usage; return 0 ;;
      -b|--base)
        [ -z "$2" ] && { _gfb_bad gfbrenew "$1 butuh nama base branch."; return 1; }
        base="$2"; shift ;;
      --delete-old) delete_old=yes ;;
      --keep-old) delete_old=no ;;
      --push) push_to_origin=true ;;
      --yes) assume_yes=true ;;
      --dry-run) dry_run=true ;;
      --*) _gfb_bad gfbrenew "Flag tidak dikenal: $1"; return 1 ;;
      -?*)
        for (( i = 2; i <= ${#1}; i++ )); do
          c=${1[i]}
          case $c in
            d) delete_old=yes ;;
            k) delete_old=no ;;
            p) push_to_origin=true ;;
            y) assume_yes=true ;;
            n) dry_run=true ;;
            h) _gfbrenew_usage; return 0 ;;
            *) _gfb_bad gfbrenew "Flag tidak dikenal: -$c (dari $1)"; return 1 ;;
          esac
        done
        ;;
      *) if [ -z "$branch" ]; then branch="$1"; else extra_args+=("$1"); fi ;;
    esac
    shift
  done
  if (( ${#extra_args} )); then
    _gfb_bad gfbrenew "Argumen berlebih: ${extra_args[*]} (hanya 1 branch)"
    return 1
  fi
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local current=$(_gfb_cur)
  [ -z "$branch" ] && branch="@"
  branch=$(_gfb_ref "$branch")
  base=$(_gfb_ref "$base")
  local is_current=false
  [ "$branch" = "$current" ] && is_current=true

  if [ "$branch" = "HEAD" ]; then
    _gfb_err "Sedang detached HEAD. Sebut nama branch-nya: gfbrenew <branch>"
    return 1
  fi
  if [[ "$branch" =~ $GFB_PROTECTED || "$branch" = "$base" ]]; then
    _gfb_err "Branch '$branch' adalah branch utama/base, tidak bisa di-renew."
    return 1
  fi
  if ! git show-ref --verify --quiet "refs/heads/$branch"; then
    _gfb_err "Branch lokal '$branch' tidak ditemukan."
    git show-ref --verify --quiet "refs/remotes/origin/$branch" \
      && _gfb_hint "git branch $branch origin/$branch" "ambil dulu dari origin"
    return 1
  fi

  if $is_current; then
    if [ -n "$(git ls-files -u)" ] || git rev-parse -q --verify MERGE_HEAD >/dev/null; then
      _gfb_err "Masih ada merge yang belum selesai. Selesaikan atau git merge --abort dulu."
      return 1
    fi
    if ! git diff --quiet || ! git diff --cached --quiet; then
      _gfb_err "Ada uncommitted changes di '$branch'. Commit atau stash dulu."
      return 1
    fi
  else
    # Branch yang terbuka di worktree lain tidak boleh digeser dari sini
    local wt_at
    if wt_at=$(_gfbwt_path_of "$branch"); then
      _gfb_err "Branch '$branch' sedang terbuka di worktree:"
      _gfb_note "${wt_at/#$HOME/~}" >&2
      _gfb_hint "cd ${(q)wt_at} && gfbrenew" "jalankan dari worktree itu"
      return 1
    fi
  fi

  # ── Ambil base terbaru (tanpa checkout base, jadi aman di worktree) ──
  local has_origin=false base_ref
  git remote get-url origin >/dev/null 2>&1 && has_origin=true

  _gfb_step "Fetch origin"
  if $has_origin; then
    if ! git fetch -q origin "$base" 2>/dev/null; then
      _gfb_unwait
      _gfb_err "Gagal fetch origin/$base. Cek nama base atau koneksi."
      return 1
    fi
    # Branch ini mungkin juga ada di origin → perlu tahu apakah lokal tertinggal
    git fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null
    base_ref="origin/$base"
  else
    base_ref="$base"
  fi
  _gfb_unwait
  if ! git rev-parse -q --verify "$base_ref^{commit}" >/dev/null; then
    _gfb_err "Base '$base_ref' tidak ditemukan."
    return 1
  fi

  local has_remote=false behind=0 ahead_base
  if $has_origin && git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    has_remote=true
    behind=$(git rev-list --count "$branch..origin/$branch")
  fi
  if (( behind > 0 )); then
    _gfb_err "Branch lokal '$branch' tertinggal $behind commit dari origin/$branch."
    if $is_current; then
      _gfb_hint "git pull origin $branch" "pull dulu supaya commit di origin ikut ter-backup"
    else
      _gfb_hint "git fetch origin $branch:$branch" "update dulu (tanpa checkout)"
    fi
    return 1
  fi
  ahead_base=$(git rev-list --count "$branch..$base_ref")
  # Tidak ada commit baru dari base → tidak ada yang perlu diperbarui
  if (( ahead_base == 0 )); then
    print
    _gfb_ok "${B}$branch${N} sudah memuat semua commit $base_ref."
    _gfb_note "Tidak ada commit baru dari $base — dibatalkan, tidak ada yang diubah."
    print
    return 0
  fi

  # ── Nama backup: <branch>-old-YYYYMMDD[-N] ──
  local stamp=$(date +%Y%m%d) old_name n=1
  old_name="$branch-old-$stamp"
  while git show-ref --verify --quiet "refs/heads/$old_name" \
     || git show-ref --verify --quiet "refs/remotes/origin/$old_name"; do
    (( n++ ))
    old_name="$branch-old-$stamp-$n"
  done

  # ── Prediksi merge di memori (tidak menyentuh working tree) ──
  local -a conflict_files=()
  local merge_ok=true mt_out
  if ! mt_out=$(git merge-tree --write-tree --name-only --no-messages "$base_ref" "$branch" 2>/dev/null); then
    merge_ok=false
    conflict_files=(${${(f)mt_out}[2,-1]})
  fi

  # ── Rencana ──
  local del_desc
  case $delete_old in
    yes) del_desc="${R}ya${N} ${D}(-d)${N}" ;;
    no)  del_desc="${D}tidak (-k)${N}" ;;
    *)   del_desc="${D}ditanya di akhir (default: tidak)${N}" ;;
  esac

  _gfb_head "gfbrenew" "perbarui branch dengan $base terbaru"
  _gfb_kv "branch" "${B}$branch${N}  ${D}· $(git log -1 --format='%h %s · %cr' "$branch")${N}"
  $is_current || _gfb_kv "mode" "${D}branch lain — tanpa checkout, kamu tetap di $current${N}"
  _gfb_kv "base" "$base_ref  ${D}· $ahead_base commit baru belum ada di $branch${N}"
  _gfb_kv "backup" "${Y}$old_name${N}  ${D}(lokal)${N}"
  if $merge_ok; then
    _gfb_kv "conflict" "${G}tidak${N}"
  else
    _gfb_kv "conflict" "${R}ya · ${#conflict_files} file${N}"
    local f
    for f in "${conflict_files[@]}"; do _gfb_note "    └ $f"; done
  fi
  _gfb_kv "push" "$($push_to_origin && echo "ya ${D}(fast-forward, tanpa force)${N}" || echo "${D}tidak — tambah -p untuk push${N}")"
  _gfb_kv "hapus" "$del_desc"

  _gfb_sec "Langkah"
  _gfb_item 1 "buat backup $old_name dari $branch"
  _gfb_item 2 "hapus branch lokal $branch"
  _gfb_item 3 "buat ulang $branch dari $base_ref"
  _gfb_item 4 "merge $old_name → $branch"
  $push_to_origin && _gfb_item 5 "push $branch ke origin"

  # Branch lain + akan conflict → tidak bisa diselesaikan tanpa checkout
  if ! $is_current && ! $merge_ok; then
    print
    _gfb_warn "Akan conflict. Untuk branch lain, conflict tidak bisa diselesaikan tanpa checkout."
    _gfb_hint "git switch $branch && gfbrenew" "jalankan dari branch itu untuk resolve"
    _gfb_note "Tidak ada yang diubah."
    print
    $dry_run && return 0
    return 1
  fi

  if $dry_run; then
    print
    _gfb_info "Dry-run — tidak ada yang dijalankan."
    print
    return 0
  fi

  if ! $assume_yes && ! _gfb_confirm "Lanjut?" y; then
    _gfb_info "Dibatalkan."
    print
    return 1
  fi

  # Upstream lama disimpan untuk dipasang lagi ke branch baru
  local upstream_remote upstream_merge
  upstream_remote=$(git config --get "branch.$branch.remote")
  upstream_merge=$(git config --get "branch.$branch.merge")

  print
  if $is_current; then
    _gfb_step "Buat backup ${Y}$old_name${N}"
    if ! git checkout -q -b "$old_name"; then
      _gfb_err "Gagal membuat backup. Tidak ada yang berubah."
      return 1
    fi

    _gfb_step "Hapus branch lokal $branch"
    if ! git branch -q -D "$branch"; then
      _gfb_err "Gagal menghapus $branch. Kamu sekarang di backup $old_name."
      _gfb_hint "git switch $branch && git branch -D $old_name" "kembali seperti semula"
      return 1
    fi

    _gfb_step "Buat ulang $branch dari $base_ref"
    if ! git checkout -q --no-track -b "$branch" "$base_ref"; then
      _gfb_err "Gagal membuat ulang $branch. Kerjaan aman di $old_name."
      _gfb_hint "git branch -m $old_name $branch" "kembalikan nama branch semula"
      return 1
    fi
    if [[ -n "$upstream_remote" && -n "$upstream_merge" ]]; then
      git config "branch.$branch.remote" "$upstream_remote"
      git config "branch.$branch.merge" "$upstream_merge"
    fi

    _gfb_step "Merge $old_name → $branch"
    if ! git merge --no-edit "$old_name"; then
      print
      _gfb_warn "Ada conflict. Backup ${B}$old_name${N} tetap aman."
      _gfb_note "Selesaikan conflict, git add, lalu git commit."
      $push_to_origin && _gfb_hint "git push -u origin $branch" "push setelah selesai"
      _gfb_hint "gfbdel -lo $old_name" "hapus backup kalau sudah yakin"
      _gfb_sec "Batal & kembalikan seperti semula"
      _gfb_use "git merge --abort && git switch $old_name && git branch -D $branch && git branch -m $branch"
      print
      return 1
    fi
  else
    # Tanpa checkout: merge di memori → commit → pindahkan ref branch
    local tree new_commit
    _gfb_step "Buat backup ${Y}$old_name${N}"
    if ! git branch -q --no-track "$old_name" "$branch"; then
      _gfb_err "Gagal membuat backup. Tidak ada yang berubah."
      return 1
    fi

    _gfb_step "Hapus branch lokal $branch"
    if ! git branch -q -D "$branch"; then
      _gfb_err "Gagal menghapus $branch. Backup $old_name tetap ada."
      return 1
    fi

    _gfb_step "Buat ulang $branch dari $base_ref + merge $old_name"
    if ! tree=$(git merge-tree --write-tree --no-messages "$base_ref" "$old_name" 2>/dev/null) \
       || ! new_commit=$(git commit-tree "${tree%%$'\n'*}" -p "$base_ref" -p "$old_name" \
            -m "Merge branch '$old_name' into $branch") \
       || ! git branch -q --no-track "$branch" "$new_commit"; then
      _gfb_err "Gagal membuat ulang $branch. Kerjaan aman di $old_name."
      _gfb_hint "git branch -m $old_name $branch" "kembalikan nama branch semula"
      return 1
    fi
    if [[ -n "$upstream_remote" && -n "$upstream_merge" ]]; then
      git config "branch.$branch.remote" "$upstream_remote"
      git config "branch.$branch.merge" "$upstream_merge"
    fi
  fi

  if $push_to_origin; then
    _gfb_step "Push ke origin"
    if ! git push -q -u origin "$branch"; then
      _gfb_err "Push gagal. Branch lokal sudah diperbarui, backup $old_name tetap ada."
      _gfb_hint "git push -u origin $branch" "coba lagi"
      return 1
    fi
  fi

  print
  _gfb_ok "Branch ${B}$branch${N} sudah memuat $base_ref terbaru."
  $push_to_origin || { $has_remote && _gfb_hint "git push origin $branch" "untuk push (fast-forward, tanpa force)"; }

  # ── Hapus backup paling akhir ──
  if [ -z "$delete_old" ]; then
    if _gfb_confirm "Hapus backup $old_name?" n; then delete_old=yes; else delete_old=no; fi
  fi
  if [ "$delete_old" = yes ]; then
    print
    _gfb_step "Hapus backup $old_name"
    # -D: backup pasti sudah ada di $branch (parent merge), -d bisa menolak kalau bukan HEAD
    if git merge-base --is-ancestor "$old_name" "$branch" && git branch -q -D "$old_name"; then
      _gfb_ok "Backup ${Y}$old_name${N} dihapus."
    else
      _gfb_err "Gagal menghapus backup $old_name."
      return 1
    fi
  else
    _gfb_info "Backup ${Y}$old_name${N} disimpan."
    _gfb_hint "gfbdel -lo $old_name" "hapus nanti kalau sudah yakin"
  fi
  print
}
_gfbrenew() {
  _arguments -s \
    '(-b --base)'{-b,--base}'[base branch]:base branch:_gfb_branches' \
    '(-d -k)-d[hapus backup]' '(-d -k)-k[simpan backup]' \
    '-p[push ke origin]' '-y[tanpa konfirmasi]' '-n[dry-run]' '-h[bantuan]' \
    '1:branch (kosong/@ = aktif):_gfb_branches'
}
(( $+functions[compdef] )) && compdef _gfbrenew gfbrenew

# ════════════════════════════════════════════════════════════════════
# gfbrange — commit dan file yang berubah di antara dua commit hash
#   gfbrange abc1234 def5678
#   gfbrange abc1234 def5678 -f src/services
# ════════════════════════════════════════════════════════════════════
_gfbrange_usage() {
  _gfb_head "gfbrange" "commit & file berubah antar dua hash"
  _gfb_sec "Untuk apa"
  _gfb_text "Lihat commit dan file yang berubah di antara dua commit,"
  _gfb_text "mis. untuk cek isi deploy dari versi A ke versi B."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbrange <hash-lama> <hash-baru> [-f keyword]"
  _gfb_note "urutan terbalik otomatis dibetulkan"
  _gfb_sec "Argumen"
  _gfb_opt "<hash-lama>" "commit awal (tidak ikut dihitung)"
  _gfb_opt "<hash-baru>" "commit akhir"
  _gfb_sec "Opsi"
  _gfb_opt "-f, --filter" "filter path file"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Contoh"
  _gfb_ex "gfbrange abc1234 def5678" "semua file"
  _gfb_ex "gfbrange abc1234 def5678 -f services" "path mengandung 'services'"
  print
}

gfbrange() {
  local hash1="" hash2="" filter=""

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbrange_usage; return 0 ;;
      -f|--filter) filter="$2"; shift ;;
      -*) _gfb_bad gfbrange "Flag tidak dikenal: $1"; return 1 ;;
      *)
        if [ -z "$hash1" ]; then hash1="$1"
        elif [ -z "$hash2" ]; then hash2="$1"
        fi
        ;;
    esac
    shift
  done

  if [ -z "$hash1" ] || [ -z "$hash2" ]; then
    _gfb_bad gfbrange "Butuh dua commit hash."
    return 1
  fi
  _gfb_repo || return 1
  local h
  for h in "$hash1" "$hash2"; do
    if ! git cat-file -e "$h^{commit}" 2>/dev/null; then
      _gfb_err "Commit '$h' tidak ditemukan di repo ini."
      return 1
    fi
  done

  local B D N G R Y C M; _gfb_pal
  local reversed=false
  local count=$(git rev-list --count "$hash1..$hash2" 2>/dev/null)
  if (( count == 0 )); then
    # Mungkin hash1 lebih baru dari hash2 → tukar
    local rcount=$(git rev-list --count "$hash2..$hash1" 2>/dev/null)
    if (( rcount > 0 )); then
      local tmp="$hash1"; hash1="$hash2"; hash2="$tmp"
      count=$rcount
      reversed=true
    fi
  fi

  local short1=$(git rev-parse --short "$hash1") short2=$(git rev-parse --short "$hash2")

  _gfb_head "gfbrange" "commit & file berubah antar dua hash"
  _gfb_kv "dari" "$(git log -1 --format="${Y}%h${N} %s ${D}· %cd${N}" --date=format:'%Y-%m-%d' "$hash1")"
  _gfb_kv "sampai" "$(git log -1 --format="${Y}%h${N} %s ${D}· %cd${N}" --date=format:'%Y-%m-%d' "$hash2")"
  [ -n "$filter" ] && _gfb_kv "filter" "$filter"
  [ "$reversed" = true ] && { print; _gfb_info "Urutan dibalik otomatis: $short1 → $short2"; }

  if (( count == 0 )); then
    print
    _gfb_ok "Tidak ada commit di antara kedua hash tersebut."
    print
    return 0
  fi

  _gfb_sec "Commit" "$count"
  _gfb_commits "$hash1..$hash2"

  local changed_files=$(git diff --name-status "$hash1" "$hash2" 2>/dev/null)
  [ -n "$filter" ] && changed_files=$(print -r -- "$changed_files" | grep -- "$filter")

  if [ -z "$changed_files" ]; then
    _gfb_sec "File berubah" "tidak ada${filter:+ yang cocok}"
  else
    _gfb_sec "File berubah" "$short1 → $short2"
    _gfb_ns_list "$changed_files"
  fi
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbcompare — bandingkan dua branch: common ancestor, ahead/behind,
# commit eksklusif masing-masing, dan file yang berbeda
#   gfbcompare master feature/login
#   gfbcompare develop kiki/feat/SP-829 -f src/services
# ════════════════════════════════════════════════════════════════════
_gfbcompare_usage() {
  _gfb_head "gfbcompare" "bandingkan dua branch"
  _gfb_sec "Untuk apa"
  _gfb_text "Bandingkan dua branch secara menyeluruh: titik diverge, ahead/behind,"
  _gfb_text "commit yang hanya ada di masing-masing, dan file yang berbeda."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbcompare <branch-a> <branch-b> [-f keyword]"
  _gfb_sec "Argumen"
  _gfb_opt "<branch-a>" "branch pertama (@ = branch aktif)"
  _gfb_opt "<branch-b>" "branch kedua (@ = branch aktif)"
  _gfb_sec "Opsi"
  _gfb_opt "-f, --filter" "filter path file"
  _gfb_opt "-h, --help" "bantuan ini"
  _gfb_sec "Isi"
  _gfb_note "common ancestor, ahead/behind, commit eksklusif A & B, file yang berbeda."
  _gfb_sec "Contoh"
  _gfb_ex "gfbcompare master feature/login"
  _gfb_ex "gfbcompare develop @ -f src/services" "develop vs branch aktif"
  print
}

gfbcompare() {
  local branch_a="" branch_b="" filter=""

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbcompare_usage; return 0 ;;
      -f|--filter) filter="$2"; shift ;;
      -*) _gfb_bad gfbcompare "Flag tidak dikenal: $1"; return 1 ;;
      *)
        if [ -z "$branch_a" ]; then branch_a="$1"
        elif [ -z "$branch_b" ]; then branch_b="$1"
        fi
        ;;
    esac
    shift
  done

  if [ -z "$branch_a" ] || [ -z "$branch_b" ]; then
    _gfb_bad gfbcompare "Butuh dua branch."
    return 1
  fi
  _gfb_repo || return 1
  branch_a=$(_gfb_ref "$branch_a")
  branch_b=$(_gfb_ref "$branch_b")
  local ref
  for ref in "$branch_a" "$branch_b"; do
    if ! git rev-parse --verify -q "$ref^{commit}" >/dev/null; then
      _gfb_err "Branch '$ref' tidak ditemukan."
      return 1
    fi
  done

  local B D N G R Y C M; _gfb_pal

  _gfb_head "gfbcompare" "bandingkan dua branch"
  _gfb_kv "A" "${B}$branch_a${N}"
  _gfb_kv "B" "${B}$branch_b${N}"
  [ -n "$filter" ] && _gfb_kv "filter" "$filter"

  # ── Common ancestor ──
  local merge_base=$(git merge-base "$branch_a" "$branch_b" 2>/dev/null)
  if [ -n "$merge_base" ]; then
    _gfb_sec "Common ancestor" "titik diverge"
    git log -1 --format="    ${Y}%h${N}  %s ${D}· %cd${N}" --date=format:'%Y-%m-%d' "$merge_base"
  fi

  # ── Ahead / behind ──
  local ahead_a=$(git rev-list --count "$branch_b..$branch_a" 2>/dev/null)
  local ahead_b=$(git rev-list --count "$branch_a..$branch_b" 2>/dev/null)

  _gfb_sec "Hanya di A" "$ahead_a commit · $branch_a"
  if (( ahead_a == 0 )); then _gfb_note "(tidak ada)"; else _gfb_commits "$branch_b..$branch_a"; fi

  _gfb_sec "Hanya di B" "$ahead_b commit · $branch_b"
  if (( ahead_b == 0 )); then _gfb_note "(tidak ada)"; else _gfb_commits "$branch_a..$branch_b"; fi

  # ── File yang berbeda ──
  local changed_files=$(git diff --name-status "$branch_a" "$branch_b" 2>/dev/null)
  [ -n "$filter" ] && changed_files=$(print -r -- "$changed_files" | grep -- "$filter")

  if [ -z "$changed_files" ]; then
    _gfb_sec "File berbeda" "tidak ada${filter:+ yang cocok}"
  else
    _gfb_sec "File berbeda" "A → B"
    _gfb_ns_list "$changed_files"
  fi
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbwt — kelola git worktree: 1 branch = 1 folder, tanpa stash/checkout
#   gfbwt                                → daftar worktree
#   gfbwt add kiki/feat/SP-900 develop   → worktree branch baru dari develop
#   gfbwt go 900                         → cd ke worktree yang cocok
#   gfbwt main                           → kembali ke repo utama
#   gfbwt rm -b kiki/feat/SP-900         → hapus worktree + branch
#   gfbwt clean develop                  → hapus worktree yang sudah merged
#   gfbwt ws add kiki/feat/SP-900 pg mono → worktree multi-repo (lihat gfbwt ws)
# Lokasi: ../<repo>.wt/<branch-slug>  (atau $GFB_WT_DIR/<repo>/<branch-slug>)
#   induk repo punya .gfbwt-ws → <induk>/.wt/<branch-slug>/<repo>  (workspace multi-repo)
# Setelah add: .env* di-copy, vendor/node_modules di-clone (APFS copy-on-write),
# lalu .gfbwt-setup dijalankan kalau ada.
# ════════════════════════════════════════════════════════════════════
_gfbwt_usage() {
  _gfb_head "gfbwt" "kelola git worktree"
  _gfb_sec "Untuk apa"
  _gfb_text "Kerjakan beberapa branch sekaligus, masing-masing di folder sendiri."
  _gfb_text "Tidak perlu stash/checkout bolak-balik; repo utama tetap di branch-nya."
  _gfb_sec "Pemakaian"
  _gfb_use "gfbwt [ls] [keyword]"
  _gfb_use "gfbwt add [-p] [-i | -x] [-n] <branch> [base-branch]"
  _gfb_use "gfbwt go [keyword]"
  _gfb_use "gfbwt main"
  _gfb_use "gfbwt rm [-b] [-f] [branch | keyword]"
  _gfb_use "gfbwt clean [base-branch] [-b]"
  _gfb_use "gfbwt ws [ls|add|go|rm|migrate] ...   (multi-repo, lihat bawah)"
  _gfb_sec "Subcommand"
  _gfb_opt "ls" "daftar worktree: status file, sinkron origin, commit terakhir"
  _gfb_opt "add" "buat worktree; branch sudah ada → dipakai, belum → dari base"
  _gfb_opt "go" "cd ke worktree (1 yang cocok → langsung, lebih → pilih)"
  _gfb_opt "main" "cd kembali ke repo utama"
  _gfb_opt "rm" "hapus worktree (perubahan belum commit → ditanya dulu)"
  _gfb_opt "clean" "prune worktree yang foldernya hilang + yang sudah merged"
  _gfb_sec "Opsi add"
  _gfb_opt "-p" "push branch ke origin + set upstream"
  _gfb_opt "-i" "composer install / npm ci, bukan clone dari repo utama"
  _gfb_opt "-x" "tanpa vendor/node_modules sama sekali"
  _gfb_opt "-n" "dry-run, hanya tampilkan rencana"
  _gfb_note "flag bisa digabung: -pi, -pn"
  _gfb_sec "Opsi rm / clean"
  _gfb_opt "-b" "branch ikut dihapus (lokal + origin)"
  _gfb_opt "-f" "rm: tanpa konfirmasi, buang perubahan yang belum di-commit"
  _gfb_opt "-h" "bantuan ini"
  _gfb_sec "Placeholder"
  _gfb_opt "@" "add: base @ = branch aktif, nama prefix/@ = prefix/<branch-aktif>"
  _gfb_opt "" "rm: @ = worktree tempat kamu berada sekarang"
  _gfb_sec "Contoh"
  _gfb_ex "gfbwt" "daftar worktree"
  _gfb_ex "gfbwt add kiki/feat/SP-900 develop" "branch baru dari origin/develop"
  _gfb_ex "gfbwt add kiki/feat/SP-829" "branch yang sudah ada (lokal/origin)"
  _gfb_ex "gfbwt add -i fix/@ @" "fix/<aktif> dari branch aktif, deps di-install"
  _gfb_ex "gfbwt go 829" "pindah ke worktree yang mengandung '829'"
  _gfb_ex "gfbwt rm -b @" "hapus worktree ini + branch-nya"
  _gfb_ex "gfbwt clean develop -b" "worktree merged ke develop + branch-nya"
  _gfb_ex "gfb -pw develop kiki/feat/SP-901" "gfb versi worktree (lihat gfb -h)"
  _gfb_sec "Lokasi folder"
  _gfb_note "../<repo>.wt/<branch-dengan-/-jadi-->"
  _gfb_note "set GFB_WT_DIR untuk memindah → \$GFB_WT_DIR/<repo>/<branch>"
  _gfb_note "induk repo punya .gfbwt-ws → <induk>/.wt/<branch>/<repo> (berlaku juga untuk add)"
  _gfb_sec "Workspace multi-repo" "gfbwt ws — 1 branch = 1 folder berisi beberapa repo"
  _gfb_text "Repo dengan branch yang sama ditaruh sejajar di <induk>/.wt/<branch>/."
  _gfb_text "Aktif kalau folder induk repo punya .gfbwt-ws, isi per baris:"
  _gfb_note "<alias> <folder-repo> [base-default]     mis. pg singa-payment-gateway develop"
  _gfb_use "gfbwt ws [ls] [keyword]"
  _gfb_use "gfbwt ws add [-p] [-i | -x] [-n] <branch | @> <repo[:base]>... | all"
  _gfb_use "gfbwt ws go [keyword | @] [repo]"
  _gfb_use "gfbwt ws rm [-b] [-f] [keyword | @]"
  _gfb_use "gfbwt ws migrate [keyword]"
  _gfb_opt "ws ls" "daftar workspace + status tiap repo + worktree di lokasi lama"
  _gfb_opt "ws add" "buat/tambah repo ke workspace branch itu (semua dicek dulu)"
  _gfb_opt "" "branch sudah punya worktree di lokasi lama → ditawari pindah"
  _gfb_opt "ws go" "cd ke workspace; + repo → langsung ke repo itu"
  _gfb_opt "ws rm" "hapus semua worktree di workspace (pakai gfbwt rm per repo)"
  _gfb_opt "ws migrate" "pindahkan worktree <repo>.wt/... ke .wt/<branch>/<repo>"
  _gfb_opt "@" "ws add: branch aktif / branch workspace tempat kamu berada"
  _gfb_ex "gfbwt ws add kiki/feat/SP-900 pg mono" "worktree PG + BOSS sekaligus"
  _gfb_ex "gfbwt ws add @ mono" "lagi kerja di PG, tambah BOSS di sebelahnya"
  _gfb_ex "gfbwt ws add kiki/feat/SP-900 mono:master" "base khusus untuk repo itu"
  _gfb_ex "gfbwt ws go mono" "dari dalam workspace → pindah ke repo mono"
  _gfb_ex "gfbwt ws rm -b @" "hapus workspace ini + branch-nya di semua repo"
  _gfb_sec "Setup otomatis setelah add"
  _gfb_bullet ".env dan .env.* yang tidak ada di worktree di-copy dari repo utama"
  _gfb_bullet "vendor/ & node_modules/ di-clone (APFS copy-on-write: cepat, hemat disk)"
  _gfb_bullet "file .gfbwt-setup (di worktree / repo utama) dijalankan kalau ada"
  _gfb_note "env di hook: \$GFBWT_MAIN (repo utama), \$GFBWT_PATH (worktree baru)"
  _gfb_note "vendor tidak di-symlink: __DIR__ PHP mengikuti symlink, jadi autoload"
  _gfb_note "Composer akan memuat kode App\\ dari repo utama, bukan dari worktree."
  _gfb_note "composer.lock beda dengan repo utama? pakai -i."
  print
}

# Root repo utama (worktree pertama), path absolut
_gfbwt_main() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  print -r -- "${common:h}"
}

# Folder induk semua worktree buatan gfbwt untuk repo ini
_gfbwt_root() {
  local main
  main=$(_gfbwt_main) || return 1
  if [ -n "$GFB_WT_DIR" ]; then
    print -r -- "${GFB_WT_DIR%/}/${main:t}"
  else
    print -r -- "${main:h}/${main:t}.wt"
  fi
}

# Nama branch → nama folder: kiki/feat/SP-1 → kiki-feat-SP-1
_gfbwt_slug() { local s=${1//\//-}; print -r -- "${s//[^A-Za-z0-9._-]/-}"; }

# Folder induk repo utama kalau ia workspace multi-repo (punya .gfbwt-ws)
_gfbwt_wsroot() {
  local main
  main=$(_gfbwt_main) || return 1
  [ -f "${main:h}/.gfbwt-ws" ] || return 1
  print -r -- "${main:h}"
}

# Path worktree baru untuk branch di repo ini
#   workspace multi-repo → <induk>/.wt/<branch-slug>/<repo>
#   selain itu           → $(_gfbwt_root)/<branch-slug>
_gfbwt_dir() {
  local main ws slug=$(_gfbwt_slug "$1")
  main=$(_gfbwt_main) || return 1
  if ws=$(_gfbwt_wsroot); then
    print -r -- "$ws/.wt/$slug/${main:t}"
  else
    print -r -- "$(_gfbwt_root)/$slug"
  fi
}

# Isi array milik pemanggil dari "git worktree list --porcelain"
#   pemanggil: local -a wt_path wt_branch wt_head wt_flag; _gfbwt_load [repo-dir]
#   index 1 = repo utama; wt_branch kosong = detached; wt_flag: prunable/locked/""
_gfbwt_load() {
  wt_path=() wt_branch=() wt_head=() wt_flag=()
  local line p="" b="" h="" f=""
  while IFS= read -r line; do
    case $line in
      "worktree "*) p=${line#worktree } b="" h="" f="" ;;
      "HEAD "*)     h=${line#HEAD } ;;
      "branch "*)   b=${line#branch refs/heads/} ;;
      prunable*)    f=prunable ;;
      locked*)      [ -z "$f" ] && f=locked ;;
      "")
        if [ -n "$p" ]; then
          wt_path+=("$p") wt_branch+=("$b") wt_head+=("$h") wt_flag+=("$f")
        fi
        p="" ;;
    esac
  done < <(git ${1:+-C} ${1:+"$1"} worktree list --porcelain 2>/dev/null; print)
}

# Path worktree yang memegang branch (return 1 kalau tidak ada)
_gfbwt_path_of() {
  local -a wt_path wt_branch wt_head wt_flag; _gfbwt_load
  local i
  for (( i = 1; i <= ${#wt_path}; i++ )); do
    if [ "${wt_branch[i]}" = "$1" ]; then
      print -r -- "${wt_path[i]}"
      return 0
    fi
  done
  return 1
}

# Isi wt_pick (milik pemanggil) dengan index worktree yang cocok keyword
#   _gfbwt_filter <keyword> [skip-main]
_gfbwt_filter() {
  local keyword=$1 skip_main=$2 i
  wt_pick=()
  for (( i = 1; i <= ${#wt_path}; i++ )); do
    [[ -n "$skip_main" && $i -eq 1 ]] && continue
    [[ -n "$keyword" && "${wt_branch[i]}"$'\n'"${wt_path[i]}" != *"$keyword"* ]] && continue
    wt_pick+=($i)
  done
  (( ${#wt_pick} ))
}

# Cetak daftar bernomor dari wt_pick: branch, status file, sinkron, commit terakhir, path
_gfbwt_table() {
  local B D N G R Y C M; _gfb_pal
  local here i k=0 name_w=0 n p mark st st_c sync when lr dirty behind ahead tag
  here=$(git rev-parse --show-toplevel 2>/dev/null) && here=${here:A}
  local -a names=()
  for i in $wt_pick; do
    n=${wt_branch[i]:-"(detached ${wt_head[i][1,7]})"}
    names+=("$n")
    (( ${#n} > name_w )) && name_w=${#n}
  done
  (( name_w > 50 )) && name_w=50

  print
  for i in $wt_pick; do
    (( k++ ))
    p=${wt_path[i]} sync="" when="" tag=""
    mark=" "
    [[ -n "$here" && "${p:A}" == "$here" ]] && mark="${G}●${N}"
    if [ "${wt_flag[i]}" = prunable ]; then
      st="▲ hilang" st_c=$R
    else
      dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      if (( dirty )); then st="✎ $dirty file" st_c=$Y; else st="✓ bersih" st_c=$G; fi
      lr=$(git -C "$p" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null)
      if [ -n "$lr" ]; then
        behind=${lr%%[[:space:]]*} ahead=${lr##*[[:space:]]}
        (( ahead > 0 ))  && sync+="↑$ahead "
        (( behind > 0 )) && sync+="↓$behind"
        [ -z "$sync" ] && sync="sinkron"
      elif [ -n "${wt_branch[i]}" ]; then
        sync="lokal saja"
      fi
      when=$(git -C "$p" log -1 --format=%cr 2>/dev/null)
    fi
    (( i == 1 )) && tag="  · repo utama"
    [ "${wt_flag[i]}" = locked ] && tag+="  · locked"
    printf "    ${D}%3d${N} %s %-${name_w}s  %s  ${D}%-10s  %s${N}\n" \
      $k "$mark" "${names[k]}" "${st_c}${(r:10:)st}${N}" "${sync% }" "$when"
    print -r -- "          ${D}${p/#$HOME/~}${tag}${N}"
  done
}

# cd ke worktree + konfirmasi singkat
_gfbwt_cd() {
  local B D N G R Y C M; _gfb_pal
  if [ ! -d "$1" ]; then
    _gfb_err "Folder worktree tidak ada: ${1/#$HOME/~}"
    _gfb_hint "gfbwt clean" "bersihkan worktree yang foldernya hilang"
    return 1
  fi
  cd "$1" || return 1
  _gfb_ok "Di ${B}$(_gfb_cur)${N}  ${D}${1/#$HOME/~}${N}"
}

# Siapkan worktree baru: .env*, vendor/node_modules, hook .gfbwt-setup
#   _gfbwt_setup <repo-utama> <worktree> <clone|install|none>
_gfbwt_setup() {
  local main=$1 wt=$2 deps=$3 f d n=0 hook=""
  local B D N G R Y C M; _gfb_pal

  # hanya yang di-gitignore, supaya worktree baru tidak langsung "kotor"
  for f in "$main"/.env(N) "$main"/.env.*(N); do
    [[ -f "$f" && ! -e "$wt/${f:t}" ]] || continue
    git -C "$main" check-ignore -q "${f:t}" || continue
    cp -p "$f" "$wt/" && (( n++ ))
  done
  (( n )) && _gfb_step "Copy $n file .env ${D}dari repo utama${N}"

  case $deps in
    clone)
      for d in vendor node_modules; do
        [[ -d "$main/$d" && ! -e "$wt/$d" ]] || continue
        _gfb_step "Clone $d ${D}(copy-on-write)${N}"
        if ! cp -Rc "$main/$d" "$wt/$d" 2>/dev/null; then
          rm -rf "$wt/$d"
          cp -R "$main/$d" "$wt/$d" || _gfb_warn "Gagal copy $d."
        fi
      done
      ;;
    install)
      if [ -f "$wt/composer.json" ]; then
        if (( $+commands[composer] )); then
          _gfb_step "composer install"
          (cd "$wt" && composer install -q --no-interaction) || _gfb_warn "composer install gagal."
        else
          _gfb_warn "composer tidak ditemukan, vendor dilewati."
        fi
      fi
      if [ -f "$wt/package.json" ]; then
        if (( $+commands[npm] )); then
          _gfb_step "npm install"
          if [ -f "$wt/package-lock.json" ]; then
            (cd "$wt" && npm ci --silent) || _gfb_warn "npm ci gagal."
          else
            (cd "$wt" && npm install --silent) || _gfb_warn "npm install gagal."
          fi
        else
          _gfb_warn "npm tidak ditemukan, node_modules dilewati."
        fi
      fi
      ;;
  esac

  if [ -f "$wt/.gfbwt-setup" ]; then
    hook="$wt/.gfbwt-setup"
  elif [ -f "$main/.gfbwt-setup" ]; then
    hook="$main/.gfbwt-setup"
  fi
  if [ -n "$hook" ]; then
    _gfb_step "Jalankan .gfbwt-setup ${D}(${hook:h:t})${N}"
    (cd "$wt" && GFBWT_MAIN="$main" GFBWT_PATH="$wt" zsh "$hook") || _gfb_warn ".gfbwt-setup gagal."
  fi
}

gfbwt() {
  local sub=${1:-ls}
  (( $# )) && shift
  case $sub in
    -h|--help|help) _gfbwt_usage ;;
    ls|list)        _gfbwt_ls "$@" ;;
    add|new)        _gfbwt_add "$@" ;;
    go|cd)          _gfbwt_go "$@" ;;
    main)           _gfb_repo && _gfbwt_cd "$(_gfbwt_main)" ;;
    rm|remove)      _gfbwt_rm "$@" ;;
    clean)          _gfbwt_clean "$@" ;;
    ws|workspace)   _gfbwt_ws "$@" ;;
    *) _gfb_bad gfbwt "Subcommand tidak dikenal: $sub"; return 1 ;;
  esac
}

_gfbwt_ls() {
  local keyword=""
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      -*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      *) keyword=$1 ;;
    esac
    shift
  done
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local -a wt_path wt_branch wt_head wt_flag wt_pick; _gfbwt_load
  local main=$(_gfbwt_main)

  _gfb_head "gfbwt" "worktree ${main:t}"
  _gfb_kv "total" "${#wt_path} ${D}(termasuk repo utama)${N}"
  local ws_root
  if ws_root=$(_gfbwt_wsroot); then
    _gfb_kv "lokasi" "${ws_root/#$HOME/~}/.wt/<branch>/${main:t} ${D}(workspace multi-repo — gfbwt ws)${N}"
  else
    _gfb_kv "lokasi" "$(_gfbwt_root | sed "s|^$HOME|~|") ${D}(untuk worktree baru)${N}"
  fi
  [ -n "$keyword" ] && _gfb_kv "keyword" "$keyword"

  if ! _gfbwt_filter "$keyword"; then
    print
    _gfb_warn "Tidak ada worktree yang cocok dengan '$keyword'."
    print
    return 0
  fi
  _gfbwt_table

  print
  _gfb_note "● di sini   ✎ belum di-commit   ↑ belum di-push   ↓ belum di-pull"
  if (( ${wt_flag[(I)prunable]} )); then
    _gfb_hint "gfbwt clean" "bersihkan worktree yang foldernya hilang"
  elif (( ${#wt_path} == 1 )); then
    _gfb_hint "gfbwt add <branch> [base]" "buat worktree pertama"
  fi
  print
}

_gfbwt_add() {
  local push=false deps=clone dry_run=false branch="" base="" i c
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      --push) push=true ;;
      --install) deps=install ;;
      --no-deps) deps=none ;;
      --dry-run) dry_run=true ;;
      --*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      -?*)
        for (( i = 2; i <= ${#1}; i++ )); do
          c=${1[i]}
          case $c in
            p) push=true ;;
            i) deps=install ;;
            x) deps=none ;;
            n) dry_run=true ;;
            h) _gfbwt_usage; return 0 ;;
            *) _gfb_bad gfbwt "Flag tidak dikenal: -$c (dari $1)"; return 1 ;;
          esac
        done
        ;;
      *)
        if [ -z "$branch" ]; then branch=$1
        elif [ -z "$base" ]; then base=$1
        else _gfb_bad gfbwt "Argumen berlebih: $1"; return 1
        fi
        ;;
    esac
    shift
  done
  if [ -z "$branch" ]; then
    _gfb_bad gfbwt "Nama branch wajib diisi."
    return 1
  fi
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local current=$(_gfb_cur)

  # Placeholder @
  if [[ "$branch" == */@ || "$base" == @ ]] && [ "$current" = HEAD ]; then
    _gfb_err "Sedang detached HEAD, placeholder @ tidak bisa dipakai."
    return 1
  fi
  case $branch in
    @) _gfb_err "Branch aktif sudah terbuka di sini, tidak bisa dibuat worktree kedua."
       _gfb_note "Untuk branch turunan pakai prefix/@, mis. gfbwt add fix/@ @" >&2
       return 1 ;;
    */@) branch="${branch%@}$current" ;;
  esac
  base=$(_gfb_ref "$base")
  if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    _gfb_err "Nama branch tidak valid: $branch"
    return 1
  fi

  # Branch sudah punya worktree → langsung ke sana
  local existing
  if existing=$(_gfbwt_path_of "$branch"); then
    print
    _gfb_info "Branch ${B}$branch${N} sudah punya worktree."
    [ "$dry_run" = true ] && { _gfb_note "${existing/#$HOME/~}"; print; return 0; }
    _gfbwt_cd "$existing"
    print
    return
  fi

  _gfb_head "gfbwt add" "buat worktree"
  _gfb_step "Fetch origin"
  git fetch -q origin 2>/dev/null
  _gfb_unwait

  local mode start
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    mode=local start=$branch
  elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    mode=remote start="origin/$branch"
  else
    mode=new
    if [ -z "$base" ]; then
      _gfb_err "Branch '$branch' belum ada (lokal maupun origin)."
      _gfb_hint "gfbwt add $branch <base-branch>" "buat baru dari base"
      print
      return 1
    fi
    if git show-ref --verify --quiet "refs/remotes/origin/$base"; then
      start="origin/$base"
    elif git show-ref --verify --quiet "refs/heads/$base"; then
      start=$base
    else
      _gfb_err "Base branch '$base' tidak ditemukan (lokal maupun origin)."
      print
      return 1
    fi
  fi

  local main=$(_gfbwt_main)
  local wt_dir=$(_gfbwt_dir "$branch")
  local deps_desc
  case $deps in
    clone)   deps_desc="clone vendor/node_modules dari repo utama ${D}(-i install, -x tanpa)${N}" ;;
    install) deps_desc="composer install / npm ci" ;;
    none)    deps_desc="${D}tidak${N}" ;;
  esac

  _gfb_kv "branch" "${B}$branch${N}"
  case $mode in
    local)  _gfb_kv "sumber" "branch lokal yang sudah ada" ;;
    remote) _gfb_kv "sumber" "origin/$branch ${D}(tracking)${N}" ;;
    new)    _gfb_kv "sumber" "branch baru dari $start" ;;
  esac
  [[ $mode != new && -n "$base" ]] && _gfb_note "base '$base' diabaikan karena branch sudah ada"
  _gfb_kv "folder" "${wt_dir/#$HOME/~}"
  _gfb_kv "deps" "$deps_desc"
  _gfb_kv "push" "$([ "$push" = true ] && echo "ya" || echo "${D}tidak — tambah -p untuk push${N}")"

  if [ -e "$wt_dir" ]; then
    print
    _gfb_err "Folder sudah ada: ${wt_dir/#$HOME/~}"
    _gfb_note "Hapus/pindahkan folder itu dulu, atau cek: gfbwt ls" >&2
    print
    return 1
  fi
  if [ "$dry_run" = true ]; then
    print
    _gfb_info "Dry-run — tidak ada yang dijalankan."
    print
    return 0
  fi

  print
  _gfb_step "Buat worktree"
  mkdir -p "${wt_dir:h}" || return 1
  case $mode in
    local)  git worktree add -q "$wt_dir" "$branch" ;;
    remote) git worktree add -q --track -b "$branch" "$wt_dir" "origin/$branch" ;;
    new)    git worktree add -q --no-track -b "$branch" "$wt_dir" "$start" ;;
  esac || { _gfb_err "Gagal membuat worktree."; return 1; }

  _gfbwt_setup "$main" "$wt_dir" "$deps"

  if [ "$push" = true ]; then
    _gfb_step "Push ke origin"
    git -C "$wt_dir" push -q -u origin "$branch" || _gfb_warn "Push gagal — coba lagi: git push -u origin $branch"
  fi

  print
  _gfbwt_cd "$wt_dir"
  _gfb_hint "gfbwt main" "kembali ke repo utama"
  print
}

_gfbwt_go() {
  local keyword=""
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      -*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      *) keyword=$1 ;;
    esac
    shift
  done
  _gfb_repo || return 1

  local -a wt_path wt_branch wt_head wt_flag wt_pick; _gfbwt_load
  local i sel
  # Nama branch persis → langsung
  for (( i = 1; i <= ${#wt_branch}; i++ )); do
    [[ -n "$keyword" && "${wt_branch[i]}" == "$keyword" ]] && { _gfbwt_cd "${wt_path[i]}"; return; }
  done

  if ! _gfbwt_filter "$keyword"; then
    _gfb_err "Tidak ada worktree yang cocok dengan '$keyword'."
    _gfb_hint "gfbwt add $keyword" "buat worktree-nya"
    return 1
  fi
  if [[ -n "$keyword" && ${#wt_pick} -eq 1 ]]; then
    _gfbwt_cd "${wt_path[wt_pick[1]]}"
    return
  fi

  _gfb_head "gfbwt go" "pindah ke worktree"
  _gfbwt_table
  _gfb_ask sel "Pilih nomor worktree" "(Enter = batal)"
  if [ -z "$sel" ]; then
    _gfb_info "Dibatalkan."
    print
    return 0
  fi
  if ! [[ "$sel" == <-> ]] || (( sel < 1 || sel > ${#wt_pick} )); then
    _gfb_err "Nomor tidak valid: $sel"
    return 1
  fi
  print
  _gfbwt_cd "${wt_path[wt_pick[sel]]}"
  print
}

_gfbwt_rm() {
  local keyword="" del_branch=false force=false
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      -b|--branch) del_branch=true ;;
      -f|--force) force=true ;;
      -bf|-fb) del_branch=true force=true ;;
      -*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      *) keyword=$1 ;;
    esac
    shift
  done
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local -a wt_path wt_branch wt_head wt_flag wt_pick; _gfbwt_load
  local main=$(_gfbwt_main) idx="" i sel
  keyword=$(_gfb_ref "$keyword")

  _gfb_head "gfbwt rm" "hapus worktree"

  if (( ${#wt_path} < 2 )); then
    _gfb_info "Belum ada worktree selain repo utama."
    print
    return 0
  fi
  if [[ -n "$keyword" && "${wt_branch[1]}" == "$keyword" ]]; then
    _gfb_err "Branch '$keyword' ada di repo utama — repo utama tidak bisa dihapus."
    return 1
  fi
  for (( i = 2; i <= ${#wt_path}; i++ )); do
    [[ -n "$keyword" && "${wt_branch[i]}" == "$keyword" ]] && idx=$i
  done
  if [ -z "$idx" ]; then
    if ! _gfbwt_filter "$keyword" 1; then
      _gfb_warn "Tidak ada worktree yang cocok dengan '$keyword'."
      print
      return 1
    fi
    _gfbwt_table
    _gfb_ask sel "Pilih nomor worktree yang dihapus" "(Enter = batal)"
    if [ -z "$sel" ]; then
      _gfb_info "Dibatalkan."
      print
      return 0
    fi
    if ! [[ "$sel" == <-> ]] || (( sel < 1 || sel > ${#wt_pick} )); then
      _gfb_err "Nomor tidak valid: $sel"
      return 1
    fi
    idx=${wt_pick[sel]}
    print
  fi

  local wt_dir=${wt_path[idx]} br=${wt_branch[idx]} missing=false changes=""
  [ "${wt_flag[idx]}" = prunable ] && missing=true
  if [[ "$del_branch" = true && -z "$br" ]]; then
    _gfb_warn "Worktree detached HEAD — tidak ada branch untuk dihapus, -b diabaikan."
    del_branch=false
  fi
  if [[ "$del_branch" = true && "$br" =~ $GFB_PROTECTED ]]; then
    _gfb_err "Branch '$br' dilindungi — hapus tanpa -b."
    return 1
  fi

  _gfb_sec "Akan dihapus"
  _gfb_kv "folder" "${wt_dir/#$HOME/~}$($missing && echo " ${D}(sudah hilang)${N}")"
  if [ -n "$br" ]; then
    if [ "$del_branch" = true ]; then
      _gfb_kv "branch" "$br ${R}ikut dihapus${N} ${D}(lokal + origin, dikonfirmasi lagi)${N}"
    else
      _gfb_kv "branch" "$br ${D}tetap ada — tambah -b untuk ikut hapus${N}"
    fi
  fi

  if ! $missing; then
    changes=$(git -C "$wt_dir" status --porcelain 2>/dev/null)
    if [ -n "$changes" ]; then
      local -a ch=(${(f)changes})
      print
      _gfb_warn "${#ch} perubahan belum di-commit — akan ${B}HILANG${N}:"
      for i in "${(@)ch[1,10]}"; do _gfb_note "$i"; done
      (( ${#ch} > 10 )) && _gfb_note "… dan $(( ${#ch} - 10 )) lainnya"
    fi
    if [ -n "$br" ]; then
      local unpushed
      unpushed=$(git -C "$wt_dir" rev-list --count '@{u}..HEAD' 2>/dev/null)
      (( unpushed > 0 )) && _gfb_warn "$unpushed commit belum di-push ${D}(tetap aman di branch selama branch tidak dihapus)${N}"
    fi
  fi

  if [ "$force" != true ]; then
    local def=y
    [ -n "$changes" ] && def=n
    if ! _gfb_confirm "Hapus worktree ini?" $def; then
      _gfb_info "Dibatalkan."
      print
      return 0
    fi
  fi

  # Sedang berada di dalam worktree yang dihapus → pindah ke repo utama dulu
  if [[ "${PWD:A}/" == "${wt_dir:A}/"* ]]; then
    cd "$main" || return 1
    _gfb_step "Pindah ke repo utama"
  fi

  print
  _gfb_step "Hapus worktree"
  if $missing; then
    git worktree prune || { _gfb_err "Gagal prune worktree."; return 1; }
  else
    git worktree remove ${changes:+--force} "$wt_dir" || { _gfb_err "Gagal menghapus worktree."; return 1; }
  fi
  rmdir "${wt_dir:h}" 2>/dev/null   # folder <repo>.wt / .wt/<branch> yang kosong ikut dibersihkan
  _gfb_ok "Worktree dihapus."

  if [ "$del_branch" = true ]; then
    print
    _gfbdel_execute "$br" false false
    return
  fi
  print
}

_gfbwt_clean() {
  local base="" del_branch=false
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      -b|--branch) del_branch=true ;;
      -*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      *) base=$1 ;;
    esac
    shift
  done
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal
  local -a wt_path wt_branch wt_head wt_flag wt_pick; _gfbwt_load
  local main=$(_gfbwt_main) i b n_missing=0
  base=$(_gfb_ref "$base")

  _gfb_head "gfbwt clean" "${base:+worktree yang sudah merged ke $base}"

  for (( i = 2; i <= ${#wt_path}; i++ )); do
    [ "${wt_flag[i]}" = prunable ] && (( n_missing++ ))
  done
  if (( n_missing )); then
    _gfb_step "Prune $n_missing worktree yang foldernya hilang"
    git worktree prune && _gfb_ok "$n_missing worktree hilang dibersihkan."
    _gfbwt_load
  else
    _gfb_ok "Tidak ada worktree yang foldernya hilang."
  fi

  if [ -z "$base" ]; then
    _gfb_hint "gfbwt clean <base-branch> [-b]" "cari worktree yang sudah merged"
    print
    return 0
  fi

  _gfb_step "Fetch $base"
  git fetch -q origin "$base" 2>/dev/null
  _gfb_unwait
  local ref
  if git show-ref --verify --quiet "refs/remotes/origin/$base"; then ref="origin/$base"
  elif git show-ref --verify --quiet "refs/heads/$base"; then ref=$base
  else _gfb_err "Base branch '$base' tidak ditemukan."; return 1; fi

  wt_pick=()
  for (( i = 2; i <= ${#wt_path}; i++ )); do
    b=${wt_branch[i]}
    [[ -z "$b" || "$b" == "$base" || "$b" =~ $GFB_PROTECTED ]] && continue
    git merge-base --is-ancestor "refs/heads/$b" "$ref" 2>/dev/null && wt_pick+=($i)
  done
  if (( ${#wt_pick} == 0 )); then
    _gfb_ok "Tidak ada worktree yang sudah merged ke $ref."
    print
    return 0
  fi

  _gfb_sec "Sudah merged ke $ref" "${#wt_pick} worktree"
  _gfbwt_table
  _gfb_note "branch baru tanpa commit juga terhitung merged — cek dulu sebelum pilih"

  local selection
  _gfb_ask selection "Pilih nomor" "(1 3 / 1,3 / all, Enter = batal)"
  local -a chosen=() nums=()
  local num
  if [[ "$selection" == all ]]; then
    chosen=("${wt_pick[@]}")
  else
    nums=(${=${selection//,/ }})
    for num in "${nums[@]}"; do
      if [[ "$num" == <-> ]] && (( num >= 1 && num <= ${#wt_pick} )); then
        chosen+=(${wt_pick[num]})
      else
        _gfb_warn "Nomor '$num' tidak valid, dilewati."
      fi
    done
  fi
  if (( ${#chosen} == 0 )); then
    _gfb_info "Tidak ada yang dipilih. Dibatalkan."
    print
    return 0
  fi

  local what="${#chosen} worktree"
  $del_branch && what+=" + branch (lokal + origin)"
  _gfb_sec "Akan dihapus" "$what"
  for i in $chosen; do _gfb_bullet "${wt_branch[i]}"; done
  $del_branch || _gfb_note "branch tetap ada — tambah -b untuk ikut hapus"
  if ! _gfb_confirm "Lanjut?" n; then
    _gfb_info "Dibatalkan."
    print
    return 0
  fi

  print
  local done_count=0 p
  for i in $chosen; do
    p=${wt_path[i]} b=${wt_branch[i]}
    if [ -n "$(git -C "$p" status --porcelain 2>/dev/null)" ]; then
      _gfb_warn "$b ${D}— ada perubahan belum di-commit, dilewati (pakai gfbwt rm)${N}"
      continue
    fi
    [[ "${PWD:A}/" == "${p:A}/"* ]] && cd "$main"
    if ! git worktree remove "$p" 2>/dev/null; then
      _gfb_warn "$b ${D}— gagal hapus worktree${N}"
      continue
    fi
    rmdir "${p:h}" 2>/dev/null
    if $del_branch; then
      if ! git branch -q -d "$b" 2>/dev/null; then
        _gfb_warn "$b ${D}— worktree terhapus, branch lokal gagal (pakai gfbdel)${N}"
        continue
      fi
      if git show-ref --verify --quiet "refs/remotes/origin/$b" && ! git push -q origin --delete "$b" 2>/dev/null; then
        _gfb_warn "$b ${D}— worktree + lokal terhapus, origin gagal${N}"
        continue
      fi
    fi
    _gfb_ok "$b"
    (( done_count++ ))
  done
  print
  _gfb_ok "${B}$done_count dari ${#chosen} worktree dihapus.${N}"
  print
}

# Dipakai gfb -w: buat branch baru langsung sebagai worktree
#   _gfbwt_from_gfb <base> <branch> <branch-aktif> <merge:true|false> <push:true|false>
_gfbwt_from_gfb() {
  local base=$1 branch=$2 current=$3 merge=$4 push=$5
  local B D N G R Y C M; _gfb_pal
  local main=$(_gfbwt_main) start
  local wt_dir=$(_gfbwt_dir "$branch")

  _gfb_step "Fetch $base"
  if ! git fetch -q origin "$base"; then
    _gfb_err "Gagal fetch $base dari origin."
    return 1
  fi
  start="origin/$base"
  git show-ref --verify --quiet "refs/remotes/origin/$base" || start=$base

  _gfb_step "Buat worktree $branch ${D}dari $start${N}"
  mkdir -p "${wt_dir:h}" || return 1
  if ! git worktree add -q --no-track -b "$branch" "$wt_dir" "$start"; then
    _gfb_err "Gagal membuat worktree."
    return 1
  fi
  _gfbwt_setup "$main" "$wt_dir" clone

  if [ "$merge" = true ]; then
    _gfb_step "Merge $current"
    if ! git -C "$wt_dir" merge "$current"; then
      print
      _gfb_warn "Ada conflict saat merge. Selesaikan manual di worktree lalu commit."
      [ "$push" = true ] && _gfb_hint "git push -u origin $branch" "push setelah selesai"
      cd "$wt_dir"
      print
      return 1
    fi
  fi

  if [ "$push" = true ]; then
    _gfb_step "Push ke origin"
    if ! git -C "$wt_dir" push -q -u origin "$branch"; then
      _gfb_err "Push gagal."
      _gfb_hint "git push -u origin $branch" "coba lagi"
      cd "$wt_dir"
      return 1
    fi
  fi

  print
  _gfb_ok "Branch ${B}$branch${N} siap di worktree$([ "$push" = true ] && echo " dan sudah di-push")."
  _gfbwt_cd "$wt_dir"
  _gfb_hint "gfbwt main" "kembali ke repo utama"
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbwt ws — workspace multi-repo: 1 branch = 1 folder berisi beberapa repo
#   Aktif kalau folder induk repo punya file .gfbwt-ws (daftar alias repo).
#   Lokasi worktree: <induk>/.wt/<branch-slug>/<repo> — juga untuk gfbwt add
#   biasa, jadi repo lain dengan branch yang sama selalu ada di folder sebelah.
# ════════════════════════════════════════════════════════════════════

# Folder workspace (yang punya .gfbwt-ws), dicari dari PWD ke atas
_gfbwt_ws_find() {
  local d=${PWD:A}
  while true; do
    [ -f "$d/.gfbwt-ws" ] && { print -r -- "$d"; return 0; }
    [ "$d" = / ] && return 1
    d=${d:h}
  done
}

# Isi ws_alias/ws_repo/ws_base milik pemanggil dari <ws>/.gfbwt-ws
#   format per baris: <alias> <folder-repo> [base-default]   (# = komentar)
_gfbwt_ws_conf() {
  ws_alias=() ws_repo=() ws_base=()
  local line
  local -a f
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%\#*}
    f=(${=line})
    (( ${#f} >= 2 )) || continue
    ws_alias+=("${f[1]}") ws_repo+=("${f[2]}") ws_base+=("${f[3]}")
  done < "$1/.gfbwt-ws"
}

# Set ws + ws_alias/ws_repo/ws_base milik pemanggil; error kalau bukan workspace
_gfbwt_ws_need() {
  if ! ws=$(_gfbwt_ws_find); then
    _gfb_err "Bukan di dalam workspace multi-repo (file .gfbwt-ws tidak ditemukan)."
    _gfb_note "Buat <folder-induk-repo>/.gfbwt-ws, per baris: <alias> <folder-repo> [base-default]" >&2
    return 1
  fi
  _gfbwt_ws_conf "$ws"
  if (( ${#ws_alias} == 0 )); then
    _gfb_err "${ws/#$HOME/~}/.gfbwt-ws belum berisi repo."
    return 1
  fi
}

# Index repo dari alias atau nama folder (return 1 kalau tidak dikenal)
_gfbwt_ws_idx() {
  local i
  for (( i = 1; i <= ${#ws_alias}; i++ )); do
    [[ "$1" == "${ws_alias[i]}" || "$1" == "${ws_repo[i]}" ]] && { print $i; return 0; }
  done
  return 1
}

# Slug workspace tempat PWD berada (pakai $ws milik pemanggil)
_gfbwt_ws_here() {
  local here="${PWD:A}/" rel
  [[ "$here" == "$ws/.wt/"?*/* ]] || return 1
  rel=${here#"$ws/.wt/"}
  print -r -- "${rel%%/*}"
}

# Branch untuk placeholder @: branch repo saat ini, atau — kalau berada di
# folder workspace (bukan di dalam repo) — branch salah satu repo di dalamnya
_gfbwt_ws_cur() {
  local cur slug d
  cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  [[ -n "$cur" && "$cur" != HEAD ]] && { print -r -- "$cur"; return 0; }
  slug=$(_gfbwt_ws_here) || return 1
  for d in "$ws/.wt/$slug"/*(N/); do
    cur=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)
    [[ -n "$cur" && "$cur" != HEAD ]] && { print -r -- "$cur"; return 0; }
  done
  return 1
}

# Baris status satu worktree: _gfbwt_ws_row <label> <path>
_gfbwt_ws_row() {
  local B D N G R Y C M; _gfb_pal
  local label=$1 p=$2 br dirty st st_c lr behind ahead sync="" when
  br=$(git -C "$p" rev-parse --abbrev-ref HEAD 2>/dev/null)
  if [ -z "$br" ]; then
    printf "        ${C}%-6s${N} ${R}%s${N}  ${D}%s${N}\n" "$label" "bukan worktree git" "${p/#$HOME/~}"
    return
  fi
  dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if (( dirty )); then st="✎ $dirty file" st_c=$Y; else st="✓ bersih" st_c=$G; fi
  lr=$(git -C "$p" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null)
  if [ -n "$lr" ]; then
    behind=${lr%%[[:space:]]*} ahead=${lr##*[[:space:]]}
    (( ahead > 0 ))  && sync+="↑$ahead "
    (( behind > 0 )) && sync+="↓$behind"
    [ -z "$sync" ] && sync="sinkron"
  else
    sync="lokal saja"
  fi
  when=$(git -C "$p" log -1 --format=%cr 2>/dev/null)
  printf "        ${C}%-6s${N} %s  ${D}%-10s  %s${N}\n" \
    "$label" "${st_c}${(r:10:)st}${N}" "${sync% }" "$when"
}

# Cetak satu workspace + repo di dalamnya: _gfbwt_ws_print <nomor> <folder>
_gfbwt_ws_print() {
  local B D N G R Y C M; _gfb_pal
  local d=$2 r i label mark=" " br="" here="${PWD:A}/"
  local -a rs=("$d"/*(N/))
  [[ "$here" == "${d:A}/"* ]] && mark="${G}●${N}"
  for r in $rs; do
    br=$(git -C "$r" rev-parse --abbrev-ref HEAD 2>/dev/null) && [ "$br" != HEAD ] && break
    br=""
  done
  printf "    ${D}%3d${N} %s ${B}%s${N}\n" "$1" "$mark" "${br:-${d:t}}"
  for r in $rs; do
    if i=$(_gfbwt_ws_idx "${r:t}"); then label=${ws_alias[i]}; else label=${r:t}; fi
    _gfbwt_ws_row "$label" "$r"
  done
  (( ${#rs} )) || print -r -- "        ${D}(kosong)${N}"
}

# Worktree repo terdaftar yang masih di luar <ws>/.wt (lokasi lama)
#   cetak per baris: <index-repo>\t<branch>\t<path>
_gfbwt_ws_old() {
  local i k main
  local -a wt_path wt_branch wt_head wt_flag
  for (( i = 1; i <= ${#ws_repo}; i++ )); do
    main="$ws/${ws_repo[i]}"
    git -C "$main" rev-parse --git-dir >/dev/null 2>&1 || continue
    _gfbwt_load "$main"
    for (( k = 2; k <= ${#wt_path}; k++ )); do
      [ "${wt_flag[k]}" = prunable ] && continue
      [[ "${wt_path[k]:A}/" == "$ws/.wt/"* ]] && continue
      print -r -- "$i"$'\t'"${wt_branch[k]}"$'\t'"${wt_path[k]}"
    done
  done
}

# Pilih folder workspace → set pick (milik pemanggil)
#   _gfbwt_ws_pick <keyword> <judul>   keyword @ = workspace tempat kamu berada
_gfbwt_ws_pick() {
  local keyword=$1 d sel k=0
  local -a dirs=()
  pick=""
  if [ "$keyword" = @ ]; then
    local s
    if ! s=$(_gfbwt_ws_here); then
      _gfb_err "Tidak sedang berada di dalam folder workspace (.wt/<branch>)."
      return 1
    fi
    pick="$ws/.wt/$s"
    return 0
  fi
  if [ -n "$keyword" ] && [ -d "$ws/.wt/$(_gfbwt_slug "$keyword")" ]; then
    pick="$ws/.wt/$(_gfbwt_slug "$keyword")"
    return 0
  fi
  for d in "$ws/.wt"/*(N/); do
    [[ -n "$keyword" && "${d:t}" != *"$(_gfbwt_slug "$keyword")"* ]] && continue
    dirs+=("$d")
  done
  if (( ${#dirs} == 0 )); then
    _gfb_err "Tidak ada workspace${keyword:+ yang cocok dengan '$keyword'}."
    _gfb_hint "gfbwt ws" "lihat daftar workspace" >&2
    return 1
  fi
  if [[ -n "$keyword" && ${#dirs} -eq 1 ]]; then
    pick=${dirs[1]}
    return 0
  fi
  _gfb_head "gfbwt ws $2" "pilih workspace"
  for d in $dirs; do (( k++ )); _gfbwt_ws_print $k "$d"; done
  _gfb_ask sel "Pilih nomor workspace" "(Enter = batal)"
  [ -z "$sel" ] && return 2
  if ! [[ "$sel" == <-> ]] || (( sel < 1 || sel > ${#dirs} )); then
    _gfb_err "Nomor tidak valid: $sel"
    return 1
  fi
  pick=${dirs[sel]}
}

_gfbwt_ws() {
  local sub=${1:-ls}
  (( $# )) && shift
  case $sub in
    -h|--help|help) _gfbwt_usage ;;
    ls|list)        _gfbwt_ws_ls "$@" ;;
    add|new)        _gfbwt_ws_add "$@" ;;
    go|cd)          _gfbwt_ws_go "$@" ;;
    rm|remove)      _gfbwt_ws_rm "$@" ;;
    migrate)        _gfbwt_ws_migrate "$@" ;;
    *) _gfb_bad gfbwt "Subcommand ws tidak dikenal: $sub"; return 1 ;;
  esac
}

_gfbwt_ws_ls() {
  local keyword=""
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      -*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      *) keyword=$1 ;;
    esac
    shift
  done
  local B D N G R Y C M; _gfb_pal
  local ws; local -a ws_alias ws_repo ws_base; _gfbwt_ws_need || return 1
  local d i n=0 line cfg=""
  for (( i = 1; i <= ${#ws_alias}; i++ )); do
    cfg+="${ws_alias[i]}=${ws_repo[i]}${ws_base[i]:+ ${D}(${ws_base[i]})${N}}  "
  done

  _gfb_head "gfbwt ws" "workspace multi-repo ${ws:t}"
  _gfb_kv "lokasi" "${ws/#$HOME/~}/.wt/<branch>/<repo>"
  _gfb_kv "repo" "$cfg"
  [ -n "$keyword" ] && _gfb_kv "keyword" "$keyword"
  print
  for d in "$ws/.wt"/*(N/); do
    [[ -n "$keyword" && "${d:t}" != *"$(_gfbwt_slug "$keyword")"* ]] && continue
    (( n++ ))
    _gfbwt_ws_print $n "$d"
  done
  (( n )) || _gfb_info "Belum ada workspace${keyword:+ yang cocok dengan '$keyword'}."

  local -a old=(${(f)"$(_gfbwt_ws_old)"}) f
  if (( ${#old} )); then
    _gfb_sec "Masih di lokasi lama" "${#old} worktree"
    for line in $old; do
      f=("${(@ps:\t:)line}")
      _gfb_bullet "${C}${ws_alias[f[1]]}${N}  ${f[2]:-(detached)}  ${D}${f[3]/#$HOME/~}${N}"
    done
    _gfb_hint "gfbwt ws migrate" "pindahkan ke .wt/<branch>/<repo>"
  fi

  print
  _gfb_note "● di sini   ✎ belum di-commit   ↑ belum di-push   ↓ belum di-pull"
  (( n )) || _gfb_hint "gfbwt ws add <branch> <repo...>" "buat workspace pertama"
  print
}

_gfbwt_ws_add() {
  local push=false deps=clone dry_run=false branch="" i c t
  local -a tokens=()
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      --push) push=true ;;
      --install) deps=install ;;
      --no-deps) deps=none ;;
      --dry-run) dry_run=true ;;
      --*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      -?*)
        for (( i = 2; i <= ${#1}; i++ )); do
          c=${1[i]}
          case $c in
            p) push=true ;;
            i) deps=install ;;
            x) deps=none ;;
            n) dry_run=true ;;
            h) _gfbwt_usage; return 0 ;;
            *) _gfb_bad gfbwt "Flag tidak dikenal: -$c (dari $1)"; return 1 ;;
          esac
        done
        ;;
      *) if [ -z "$branch" ]; then branch=$1; else tokens+=("$1"); fi ;;
    esac
    shift
  done
  if [[ -z "$branch" || ${#tokens} -eq 0 ]]; then
    _gfb_bad gfbwt "Pemakaian: gfbwt ws add <branch|@> <repo[:base]>... (atau all)"
    return 1
  fi

  local B D N G R Y C M; _gfb_pal
  local ws; local -a ws_alias ws_repo ws_base; _gfbwt_ws_need || return 1

  if [ "$branch" = @ ] && ! branch=$(_gfbwt_ws_cur); then
    _gfb_err "Placeholder @ butuh branch aktif — jalankan dari dalam repo atau folder workspace."
    return 1
  fi
  if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
    _gfb_err "Nama branch tidak valid: $branch"
    return 1
  fi

  # Repo yang dipilih + base masing-masing (repo:base > base default .gfbwt-ws)
  local -a sel=() sel_base=()
  local name b
  for t in $tokens; do
    if [ "$t" = all ]; then
      for (( i = 1; i <= ${#ws_alias}; i++ )); do
        (( ${sel[(Ie)$i]} )) || { sel+=($i); sel_base+=("${ws_base[i]}"); }
      done
      continue
    fi
    name=${t%%:*} b=""
    [[ "$t" == *:* ]] && b=${t#*:}
    if ! i=$(_gfbwt_ws_idx "$name"); then
      _gfb_err "Repo tidak dikenal: $name"
      _gfb_note "Terdaftar di .gfbwt-ws: ${ws_alias[*]}" >&2
      return 1
    fi
    (( ${sel[(Ie)$i]} )) && continue
    sel+=($i) sel_base+=("${b:-${ws_base[i]}}")
  done

  local slug=$(_gfbwt_slug "$branch")
  local wsdir="$ws/.wt/$slug"
  local deps_desc
  case $deps in
    clone)   deps_desc="clone vendor/node_modules dari repo utama ${D}(-i install, -x tanpa)${N}" ;;
    install) deps_desc="composer install / npm ci" ;;
    none)    deps_desc="${D}tidak${N}" ;;
  esac

  _gfb_head "gfbwt ws add" "worktree multi-repo"
  _gfb_kv "branch" "${B}$branch${N}"
  _gfb_kv "folder" "${wsdir/#$HOME/~}/"
  _gfb_kv "deps" "$deps_desc"
  _gfb_kv "push" "$([ "$push" = true ] && echo "ya" || echo "${D}tidak — tambah -p untuk push${N}")"
  print
  _gfb_step "Fetch origin ${D}(${#sel} repo)${N}"
  for i in $sel; do git -C "$ws/${ws_repo[i]}" fetch -q origin 2>/dev/null; done
  _gfb_unwait

  # ── Rencana per repo (semua dicek dulu; ada yang gagal → tidak ada yang dibuat) ──
  _gfb_sec "Rencana"
  local -a p_mode=() p_start=() p_old=() wt_path wt_branch wt_head wt_flag
  local k main dir base mode start old msg fail=0 n_move=0 n_todo=0
  for (( k = 1; k <= ${#sel}; k++ )); do
    i=${sel[k]} base=${sel_base[k]}
    main="$ws/${ws_repo[i]}" dir="$wsdir/${ws_repo[i]}"
    mode="" start="" old=""
    if ! git -C "$main" rev-parse --git-dir >/dev/null 2>&1; then
      mode=err start="bukan git repo: ${main/#$HOME/~}"
    else
      _gfbwt_load "$main"
      for (( c = 1; c <= ${#wt_path}; c++ )); do
        [ "${wt_branch[c]}" = "$branch" ] && { old=${wt_path[c]}; break; }
      done
      if [ -n "$old" ]; then
        if [ "${old:A}" = "${dir:A}" ]; then
          mode=skip
        elif (( c == 1 )); then
          mode=err start="sedang di-checkout di repo utama — pindahkan repo utama ke branch lain dulu"
        elif [ "${wt_flag[c]}" = prunable ]; then
          mode=err start="worktree lamanya hilang — jalankan gfbwt clean di ${ws_repo[i]}"
        else
          mode=move
        fi
      elif git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
        mode=local
      elif git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        mode=remote start="origin/$branch"
      elif [ -z "$base" ]; then
        mode=err start="branch belum ada & base default tidak diset — pakai ${ws_alias[i]}:<base>"
      elif git -C "$main" show-ref --verify --quiet "refs/remotes/origin/$base"; then
        mode=new start="origin/$base"
      elif git -C "$main" show-ref --verify --quiet "refs/heads/$base"; then
        mode=new start=$base
      else
        mode=err start="base '$base' tidak ditemukan (lokal maupun origin)"
      fi
      if [[ $mode == (local|remote|new|move) && -e "$dir" ]]; then
        mode=err start="folder sudah ada: ${dir/#$HOME/~}"
      fi
    fi
    p_mode+=($mode) p_start+=("$start") p_old+=("$old")
    case $mode in
      skip)   msg="${D}sudah ada di workspace, dilewati${N}" ;;
      move)   msg="${Y}pindahkan${N} worktree lama ${D}${old/#$HOME/~}${N}"; (( n_move++, n_todo++ )) ;;
      local)  msg="branch lokal yang sudah ada"; (( n_todo++ )) ;;
      remote) msg="$start ${D}(tracking)${N}"; (( n_todo++ )) ;;
      new)    msg="branch baru dari $start"; (( n_todo++ )) ;;
      err)    msg="${R}✖ $start${N}"; (( fail++ )) ;;
    esac
    printf "    ${C}%-6s${N} %s\n" "${ws_alias[i]}" "$msg"
  done

  if (( fail )); then
    print
    _gfb_err "Tidak ada yang dijalankan — perbaiki yang ✖ dulu."
    print
    return 1
  fi
  if (( n_todo == 0 )); then
    print
    _gfb_ok "Semua repo sudah ada di workspace."
    [ "$dry_run" = true ] || { [[ "${PWD:A}/" == "${wsdir:A}/"* ]] || cd "$wsdir"; }
    print
    return 0
  fi
  if [ "$dry_run" = true ]; then
    print
    _gfb_info "Dry-run — tidak ada yang dijalankan."
    print
    return 0
  fi
  if (( n_move )); then
    print
    _gfb_note "dipindah dengan git worktree move — perubahan yang belum di-commit ikut pindah"
    _gfb_note "tutup dulu IDE / proses (artisan serve, npm run dev, dll.) yang jalan di path lama"
    if ! _gfb_confirm "Pindahkan $n_move worktree lama ke workspace?" y; then
      _gfb_info "Dibatalkan."
      print
      return 0
    fi
  fi

  # ── Eksekusi ──
  print
  mkdir -p "$wsdir" || return 1
  local n_ok=0 n_bad=0 back=""
  for (( k = 1; k <= ${#sel}; k++ )); do
    i=${sel[k]} mode=${p_mode[k]} start=${p_start[k]} old=${p_old[k]}
    main="$ws/${ws_repo[i]}" dir="$wsdir/${ws_repo[i]}"
    case $mode in
      skip) continue ;;
      move)
        _gfb_step "${ws_alias[i]}: pindahkan worktree"
        # sedang berada di dalam worktree yang dipindah → keluar dulu, masuk lagi setelahnya
        if [[ "${PWD:A}/" == "${old:A}/"* ]]; then
          back="$dir${${PWD:A}#${old:A}}"
          cd -q "$ws"
        fi
        if git -C "$main" worktree move "$old" "$dir"; then
          rmdir "${old:h}" 2>/dev/null   # folder <repo>.wt yang kosong ikut dibersihkan
          (( n_ok++ ))
        else
          _gfb_warn "${ws_alias[i]}: gagal memindah worktree."
          (( n_bad++ ))
        fi
        ;;
      *)
        _gfb_step "${ws_alias[i]}: buat worktree"
        case $mode in
          local)  git -C "$main" worktree add -q "$dir" "$branch" ;;
          remote) git -C "$main" worktree add -q --track -b "$branch" "$dir" "origin/$branch" ;;
          new)    git -C "$main" worktree add -q --no-track -b "$branch" "$dir" "$start" ;;
        esac || { _gfb_warn "${ws_alias[i]}: gagal membuat worktree."; (( n_bad++ )); continue; }
        _gfbwt_setup "$main" "$dir" "$deps"
        if [ "$push" = true ]; then
          _gfb_step "${ws_alias[i]}: push ke origin"
          git -C "$dir" push -q -u origin "$branch" || _gfb_warn "Push gagal — coba lagi: git push -u origin $branch"
        fi
        (( n_ok++ ))
        ;;
    esac
  done

  print
  if (( n_bad )); then
    _gfb_warn "$n_ok repo berhasil, $n_bad gagal — lihat pesan di atas."
  else
    _gfb_ok "Workspace ${B}$branch${N} siap."
  fi
  _gfbwt_ws_print 1 "$wsdir"
  if [[ -n "$back" && -d "$back" ]]; then
    cd "$back"
  elif [[ "${PWD:A}/" != "${wsdir:A}/"* ]]; then
    cd "$wsdir"
  fi
  print
  _gfb_note "di ${PWD/#$HOME/~}"
  _gfb_hint "gfbwt ws go @ <repo>" "pindah ke repo lain di workspace ini"
  print
}

_gfbwt_ws_go() {
  local keyword="" repo="" i
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      -*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      *)
        if [ -z "$keyword" ]; then keyword=$1
        elif [ -z "$repo" ]; then repo=$1
        else _gfb_bad gfbwt "Argumen berlebih: $1"; return 1
        fi
        ;;
    esac
    shift
  done
  local B D N G R Y C M; _gfb_pal
  local ws; local -a ws_alias ws_repo ws_base; _gfbwt_ws_need || return 1

  # "gfbwt ws go mono" dari dalam workspace → repo mono di workspace ini
  if [[ -n "$keyword" && -z "$repo" ]] && _gfbwt_ws_idx "$keyword" >/dev/null && _gfbwt_ws_here >/dev/null; then
    repo=$keyword keyword=@
  fi

  local pick rc
  _gfbwt_ws_pick "$keyword" go; rc=$?
  (( rc == 2 )) && { _gfb_info "Dibatalkan."; print; return 0; }
  (( rc )) && return 1

  local target=$pick
  if [ -n "$repo" ]; then
    if ! i=$(_gfbwt_ws_idx "$repo"); then
      _gfb_err "Repo tidak dikenal: $repo"
      _gfb_note "Terdaftar di .gfbwt-ws: ${ws_alias[*]}" >&2
      return 1
    fi
    target="$pick/${ws_repo[i]}"
    if [ ! -d "$target" ]; then
      _gfb_err "Repo ${ws_alias[i]} belum ada di workspace ${pick:t}."
      _gfb_hint "gfbwt ws add @ ${ws_alias[i]}" "tambahkan (jalankan dari workspace itu)" >&2
      return 1
    fi
  fi
  cd "$target" || return 1
  _gfb_ok "Di ${B}${pick:t}${N}${repo:+ / $repo}  ${D}${target/#$HOME/~}${N}"
}

_gfbwt_ws_rm() {
  local keyword="" del_branch=false force=false
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      -b|--branch) del_branch=true ;;
      -f|--force) force=true ;;
      -bf|-fb) del_branch=true force=true ;;
      -*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      *) keyword=$1 ;;
    esac
    shift
  done
  local B D N G R Y C M; _gfb_pal
  local ws; local -a ws_alias ws_repo ws_base; _gfbwt_ws_need || return 1

  local pick rc
  _gfbwt_ws_pick "$keyword" rm; rc=$?
  (( rc == 2 )) && { _gfb_info "Dibatalkan."; print; return 0; }
  (( rc )) && return 1

  local -a repos=("$pick"/*(N/)) fl=()
  local r br main
  if (( ${#repos} == 0 )); then
    rmdir "$pick" 2>/dev/null && _gfb_ok "Folder workspace kosong dihapus: ${pick/#$HOME/~}"
    return 0
  fi

  _gfb_head "gfbwt ws rm" "${#repos} repo di workspace ${pick:t}"
  _gfbwt_ws_print 1 "$pick"
  [ "$force" = true ] || _gfb_note "tiap repo dikonfirmasi satu per satu"

  # sedang berada di dalam workspace yang dihapus → keluar dulu
  if [[ "${PWD:A}/" == "${pick:A}/"* ]]; then
    cd -q "$ws" || return 1
    _gfb_step "Pindah ke ${ws/#$HOME/~}"
  fi
  [ "$del_branch" = true ] && fl+=(-b)
  [ "$force" = true ] && fl+=(-f)

  for r in $repos; do
    br=$(git -C "$r" rev-parse --abbrev-ref HEAD 2>/dev/null)
    main=$(git -C "$r" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
    if [[ -z "$br" || "$br" == HEAD || -z "$main" ]]; then
      _gfb_warn "${r:t} ${D}— bukan worktree / detached, dilewati (hapus manual)${N}"
      continue
    fi
    ( cd -q "${main:h}" && _gfbwt_rm $fl "$br" )
  done

  rmdir "$pick" 2>/dev/null
  if [ -d "$pick" ]; then
    _gfb_warn "Folder workspace masih berisi: ${D}${pick/#$HOME/~}${N}"
  else
    _gfb_ok "Workspace ${B}${pick:t}${N} dihapus."
  fi
  print
}

_gfbwt_ws_migrate() {
  local keyword=""
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbwt_usage; return 0 ;;
      -*) _gfb_bad gfbwt "Flag tidak dikenal: $1"; return 1 ;;
      *) keyword=$1 ;;
    esac
    shift
  done
  local B D N G R Y C M; _gfb_pal
  local ws; local -a ws_alias ws_repo ws_base; _gfbwt_ws_need || return 1

  local -a old=(${(f)"$(_gfbwt_ws_old)"}) todo_i=() todo_old=() todo_new=() f
  local line i br p dir
  _gfb_head "gfbwt ws migrate" "pindahkan worktree lama ke .wt/<branch>/<repo>"
  for line in $old; do
    f=("${(@ps:\t:)line}")
    i=${f[1]} br=${f[2]} p=${f[3]}
    [[ -n "$keyword" && "$br"$'\n'"$p" != *"$keyword"* ]] && continue
    if [ -z "$br" ]; then
      _gfb_warn "${ws_alias[i]} ${D}${p/#$HOME/~} — detached HEAD, dilewati${N}"
      continue
    fi
    dir="$ws/.wt/$(_gfbwt_slug "$br")/${ws_repo[i]}"
    if [ -e "$dir" ]; then
      _gfb_warn "${ws_alias[i]} $br ${D}— tujuan sudah ada, dilewati: ${dir/#$HOME/~}${N}"
      continue
    fi
    todo_i+=($i) todo_old+=("$p") todo_new+=("$dir")
    printf "    ${C}%-6s${N} %s\n" "${ws_alias[i]}" "${B}$br${N}"
    print -r -- "           ${D}${p/#$HOME/~}${N}"
    print -r -- "         → ${dir/#$HOME/~}"
  done
  if (( ${#todo_i} == 0 )); then
    _gfb_ok "Tidak ada worktree yang perlu dipindah."
    print
    return 0
  fi

  print
  _gfb_note "perubahan yang belum di-commit ikut pindah (git worktree move)"
  _gfb_note "tutup dulu IDE / proses (artisan serve, npm run dev, dll.) yang jalan di path lama"
  _gfb_note "repo dengan nama branch berbeda tetap masuk folder workspace yang berbeda"
  if ! _gfb_confirm "Pindahkan ${#todo_i} worktree?" y; then
    _gfb_info "Dibatalkan."
    print
    return 0
  fi

  print
  local k n_ok=0 back=""
  for (( k = 1; k <= ${#todo_i}; k++ )); do
    i=${todo_i[k]} p=${todo_old[k]} dir=${todo_new[k]}
    if [[ "${PWD:A}/" == "${p:A}/"* ]]; then
      back="$dir${${PWD:A}#${p:A}}"
      cd -q "$ws"
    fi
    mkdir -p "${dir:h}" || continue
    if git -C "$ws/${ws_repo[i]}" worktree move "$p" "$dir"; then
      rmdir "${p:h}" 2>/dev/null
      _gfb_ok "${ws_alias[i]}  ${D}${dir/#$HOME/~}${N}"
      (( n_ok++ ))
    else
      rmdir "${dir:h}" 2>/dev/null
      _gfb_warn "${ws_alias[i]} ${D}— gagal pindah ${p/#$HOME/~}${N}"
    fi
  done
  [[ -n "$back" && -d "$back" ]] && cd "$back"
  print
  _gfb_ok "${B}$n_ok dari ${#todo_i} worktree dipindah.${N}"
  _gfb_hint "gfbwt ws" "lihat workspace"
  print
}

# Tab completion
_gfbwt_wt_branches() {
  local -a wt_path wt_branch wt_head wt_flag; _gfbwt_load
  local -a brs=(${wt_branch[2,-1]:#})
  _describe 'worktree' brs
}
_gfbwt() {
  if (( CURRENT == 2 )); then
    local -a subs=(
      'ls:daftar worktree' 'add:buat worktree' 'go:pindah ke worktree'
      'main:kembali ke repo utama' 'rm:hapus worktree' 'clean:hapus worktree yang sudah merged'
      'ws:workspace multi-repo'
    )
    _describe 'subcommand' subs
    return
  fi
  if [[ $words[2] == ws ]]; then
    if (( CURRENT == 3 )); then
      local -a wsubs=(
        'ls:daftar workspace' 'add:buat/tambah repo ke workspace' 'go:pindah ke workspace'
        'rm:hapus workspace' 'migrate:pindahkan worktree lama ke workspace'
      )
      _describe 'ws subcommand' wsubs
      return
    fi
    local ws; local -a ws_alias ws_repo ws_base
    ws=$(_gfbwt_ws_find) || return
    _gfbwt_ws_conf "$ws"
    case $words[3] in
      add)
        if (( CURRENT == 4 )); then _gfb_branches
        else local -a al=(all $ws_alias); _describe 'repo' al
        fi ;;
      go|rm)
        local -a sl=("$ws/.wt"/*(N/:t))
        if [[ $words[3] == go && CURRENT -eq 5 ]]; then _describe 'repo' ws_alias
        else _describe 'workspace' sl
        fi ;;
    esac
    return
  fi
  case $words[2] in
    add)   _gfb_branches ;;
    go|rm) _gfbwt_wt_branches ;;
    clean) _gfb_branches ;;
  esac
}
(( $+functions[compdef] )) && compdef _gfbwt gfbwt

# ════════════════════════════════════════════════════════════════════
# gfbmain — ringkasan semua perintah GFB
#   gfbmain                   → ringkasan
#   gfbmain help gfbstatus    → bantuan detail (juga: gfbmain help status, gfbmain gfbstatus)
# ════════════════════════════════════════════════════════════════════
gfbmain() {
  # gfbmain help <cmd> / gfbmain --help <cmd> / gfbmain <cmd>  → bantuan detail
  [[ "$1" == help || "$1" == --help || "$1" == -h ]] && shift
  if [ -n "$1" ]; then
    local cmd=$1
    [[ "$cmd" == gfb* ]] || cmd="gfb$cmd"   # "status" → "gfbstatus"
    if [[ "$cmd" != gfbmain ]] && (( $+functions[$cmd] )); then
      "$cmd" -h
      return 0
    fi
    _gfb_err "Perintah tidak dikenal: $1"
    _gfb_note "Lihat daftar perintah: gfbmain" >&2
    return 1
  fi

  local B D N G R Y C M; _gfb_pal

  _gfb_head "GFB" "Git Feature Branch toolkit"

  _gfb_sec "Branch"
  _gfb_opt "gfb"          "buat branch baru dari base (opsional merge + push)"
  _gfb_opt "gfbls"        "daftar branch, urut terakhir dipakai"
  _gfb_opt "gfbdel"       "hapus branch lokal + origin"
  _gfb_opt "gfbrenew"     "perbarui branch dengan master terbaru (backup + merge)"
  _gfb_opt "gfbclean"     "hapus branch yang sudah merged"
  _gfb_opt "gfbcheck"     "branch yang belum merged"

  _gfb_sec "Worktree" "1 branch = 1 folder, tanpa stash/checkout"
  _gfb_opt "gfbwt"        "daftar worktree + status file & sinkron"
  _gfb_opt "gfbwt add"    "buat worktree (+ .env, vendor, node_modules)"
  _gfb_opt "gfbwt go"     "pindah (cd) ke worktree"
  _gfb_opt "gfbwt main"   "kembali ke repo utama"
  _gfb_opt "gfbwt rm"     "hapus worktree (-b: + branch-nya)"
  _gfb_opt "gfbwt clean"  "hapus worktree hilang / sudah merged"
  _gfb_opt "gfb -w"       "buat branch baru langsung sebagai worktree"
  _gfb_opt "gfbwt ws"     "workspace multi-repo: 1 branch, beberapa repo sejajar"

  _gfb_sec "Inspeksi"
  _gfb_opt "gfbstatus"    "git status versi lengkap (+ recap AI)"
  _gfb_opt "gfblog"       "commit yang belum ada di base"
  _gfb_opt "gfbcompare"   "bandingkan dua branch"
  _gfb_opt "gfbrange"     "commit & file di antara dua hash"
  _gfb_opt "gfbfind"      "commit ada di branch mana saja"
  _gfb_opt "gfbconflict"  "cek conflict antar branch tanpa merge"

  _gfb_sec "AI & tools"
  _gfb_opt "gfbcm"        "generate commit message (-a/-c langsung commit)"
  _gfb_opt "gfbpr"        "generate judul & deskripsi PR"
  _gfb_opt "gfblarklink"  "link Lark (Story & Issue) dari nama branch"
  _gfb_opt "gfblarkbranch" "branch terkait dari link/ID Lark (semua repo workspace)"

  _gfb_sec "Konvensi"
  _gfb_opt "@"            "nama branch aktif (\".\" cara lama juga masih jalan)"
  _gfb_opt "gfbmain help <cmd>" "bantuan detail: untuk apa, argumen, opsi, contoh"
  _gfb_opt "<cmd> -h" "sama, langsung dari perintahnya (mis. gfbstatus -h)"
  print
}

