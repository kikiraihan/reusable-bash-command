gfbcm() {
  local provider="groq" model="" max_diff_chars=12000

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -h|--help) _gfbcm_usage; return 0 ;;
      -p|--provider) provider="$2"; shift ;;
      -m|--model) model="$2"; shift ;;
      *) _gfb_bad gfbcm "Argumen tidak dikenal: $1"; return 1 ;;
    esac
    shift
  done

  [ -z "$model" ] && { model=$(_gfb_ai_model "$provider") || return 1; }
  _gfb_ai_key "$provider" || return 1
  _gfb_repo || return 1

  local B D N G R Y C M; _gfb_pal

  # Lock file & file minified tetap muncul di daftar file, tapi isi diff-nya di-skip
  local -a noisy=(':(top,exclude)*.lock' ':(top,exclude)*package-lock.json' ':(top,exclude)*pnpm-lock.yaml'
                  ':(top,exclude)*.min.js' ':(top,exclude)*.min.css')

  # Selalu baca perubahan dari root repo, walau dipanggil dari subfolder
  local __gfb_here=$PWD
  builtin cd -q "$(git rev-parse --show-toplevel)" || return 1

  local source_label files diff
  local -a untracked=()
  if ! git diff --cached --quiet; then
    source_label="staged"
    files=$(git diff --cached --name-status)
    diff=$(git diff --cached --no-color -- ":/" "${noisy[@]}")
  else
    source_label="changes ${D}(unstaged + untracked)${N}"
    untracked=(${(f)"$(git ls-files --others --exclude-standard)"})
    files=$(git diff --name-status)
    local f
    for f in "${untracked[@]}"; do files+=$'\n'"A	$f (untracked)"; done
    files=${files#$'\n'}
    diff=$(git diff --no-color -- ":/" "${noisy[@]}")
    # Isi file baru (hanya file teks, maksimal 80 baris per file)
    for f in "${untracked[@]}"; do
      [[ -f "$f" ]] && grep -Iq . "$f" 2>/dev/null || continue
      diff+=$'\n'"--- /dev/null"$'\n'"+++ b/$f"$'\n'"$(head -n 80 "$f" | sed 's/^/+/')"
    done
  fi
  builtin cd -q "$__gfb_here"

  if [ -z "$files" ]; then
    print
    _gfb_ok "Tidak ada perubahan (staged maupun unstaged)."
    print
    return 0
  fi

  local truncated=false
  if (( ${#diff} > max_diff_chars )); then
    diff="${diff[1,$max_diff_chars]}"$'\n'"... (diff dipotong)"
    truncated=true
  fi

  local branch=$(_gfb_cur)
  local recent_commits=$(git log -10 --pretty=format:%s 2>/dev/null)
  local file_count=$(echo "$files" | wc -l | tr -d ' ')

  _gfb_head "gfbcm" "generate commit message"
  _gfb_kv "branch" "$branch"
  _gfb_kv "sumber" "$source_label"
  _gfb_kv "file" "$file_count$([ "$truncated" = true ] && echo "  ${D}(diff dipotong ke $max_diff_chars karakter)${N}")"
  _gfb_kv "AI" "$provider · $model"

  local prompt="You are an assistant that writes git commit messages, like GitHub Copilot's commit message generator.
Analyze the diff below and write ONE commit message describing these changes.
Rules:
- Use Conventional Commits: <type>(<optional scope>): <subject>. Types: feat, fix, refactor, chore, docs, test, style, perf, build, ci.
- Subject line: imperative mood, lowercase after the colon, no trailing period, max 72 characters.
- If the changes contain more than one meaningful change, add a blank line followed by a short body of bullet points (\"- ...\"), one per meaningful change, each max 72 characters.
- If it is a single small change, output only the subject line.
- Describe WHAT changed and WHY when it can be inferred; do not list every file.
- Match the language and style of the recent commits if they are consistent.
- Output ONLY the commit message. No explanation, no quotes, no code fences.

Branch name (may contain a ticket ID or hint of intent): $branch

Recent commits on this branch (for style reference):
$recent_commits

Changed files:
$files

Diff:
$diff"

  print
  _gfb_step "Generating commit message…"
  local result
  result=$(_gfb_ai_generate "$provider" "$model" "$prompt") || return 1
  _gfb_unwait

  _gfb_rule
  print -r -- "$result" | sed 's/^/    /'
  _gfb_rule

  if _gfb_confirm "Copy ke clipboard?" n; then
    _gfb_copy "$result"
  fi
  print
}

# ════════════════════════════════════════════════════════════════════
# gfbstatus — git status versi lengkap:
#   - branch, upstream (ahead/behind), posisi vs base branch, fetch terakhir
#   - operasi yang sedang berjalan (merge/rebase/cherry-pick/revert/bisect)
#   - staged / changes / untracked / conflict + jumlah baris (+/-)
#   - tanda ◐ untuk file yang sebagian di-stage
#   - peringatan file sensitif (.env, *.pem, key, …) / besar di staged & untracked
#   - stash, commit belum di-push / belum di-pull, saran langkah berikutnya
#   gfbstatus              → base otomatis (master, lalu main)
#   gfbstatus -b develop   → bandingkan dengan develop
#   gfbstatus -f           → git fetch dulu
#   gfbstatus -a           → semua file (tanpa dipotong)
#   gfbstatus -w [detik]   → mode watch
#   gfbstatus -r           → + recap AI (groq), -p gemini untuk Gemini
# ════════════════════════════════════════════════════════════════════

# Cetak daftar file dari "git diff --name-status" + "--numstat" (urutannya sama)
# File yang ada di <partial> (daftar path, per baris) ditandai "◐ sebagian"
# _gfb_status_files <limit> <name-status> <numstat> [partial]
_gfb_status_files() {
  local B D N G R Y C M; _gfb_pal
  local limit=$1
  local -a ns=(${(f)2}) nums=(${(f)3}) partial=(${(f)4})
  local i st file add del counts color

  for (( i = 1; i <= ${#ns}; i++ )); do
    if (( limit > 0 && i > limit )); then
      print -r -- "    ${D}… +$(( ${#ns} - limit )) file lainnya (pakai -a untuk semua)${N}"
      break
    fi
    st=${ns[i]%%$'\t'*}
    file=${ns[i]#*$'\t'}
    file=${file//$'\t'/ → }
    case ${st[1]} in
      A) color=$G ;; D) color=$R ;; R|C) color=$C ;; *) color=$Y ;;
    esac
    add=${${nums[i]}%%$'\t'*}
    del=${${nums[i]#*$'\t'}%%$'\t'*}
    if [[ "$add" == "-" ]]; then
      counts="${D}binary${N}"
    else
      counts=""
      (( add > 0 )) && counts+="${G}+$add${N} "
      (( del > 0 )) && counts+="${R}-$del${N}"
    fi
    (( ${partial[(Ie)${ns[i]##*$'\t'}]} )) && counts+=" ${Y}◐ sebagian${N}"
    printf "    %s%s%s  %-52s %s\n" "$color" "${st[1]}" "$N" "$file" "$counts"
  done
}

# Total +/- dari numstat, hasil: "+X -Y"
_gfb_status_sum() {
  echo "$1" | awk -F'\t' '$1 != "-" { a += $1; d += $2 } END { printf "+%d -%d", a, d }'
}

# Recap via AI: "sebelumnya saya mengerjakan apa, dan kapan"
# Konteks: commit di branch ini, perubahan yang belum di-commit, kapan file terakhir diedit,
# riwayat checkout (reflog), dan stash.
# _gfb_status_recap <provider> <model> [base-ref]
_gfb_status_recap() {
  local provider="$1" model="$2" base_ref="$3"
  local max_diff_chars=8000
  local now=$(date +%s)

  _gfb_sec "Recap AI" "$provider · $model"
  if ! _gfb_ai_key "$provider" quiet; then
    _gfb_warn "API key untuk $provider belum di-set, recap dilewati."
    return 1
  fi

  local __gfb_here=$PWD
  builtin cd -q "$(git rev-parse --show-toplevel)" || return 1

  local branch=$(_gfb_cur)
  local fmt='%h | %ad | %an | %s'
  local datefmt='--date=format:%Y-%m-%d %H:%M'

  # Commit milik branch ini (vs base); kalau tidak ada, 15 commit terakhir
  local commits=""
  if [ -n "$base_ref" ]; then
    commits=$(git log "$base_ref"..HEAD -n 20 --format="$fmt" "$datefmt" --shortstat 2>/dev/null | sed '/^$/d')
  fi
  local commits_label="Commits on this branch that are not in $base_ref (newest first)"
  if [ -z "$commits" ]; then
    commits=$(git log -n 15 --format="$fmt" "$datefmt" --shortstat 2>/dev/null | sed '/^$/d')
    commits_label="Latest commits on HEAD (newest first)"
  fi

  # Perubahan yang belum di-commit (staged + unstaged dibanding HEAD)
  local -a noisy=(':(top,exclude)*.lock' ':(top,exclude)*package-lock.json' ':(top,exclude)*pnpm-lock.yaml'
                  ':(top,exclude)*.min.js' ':(top,exclude)*.min.css')
  local staged_files=$(git diff --cached --name-status)
  local unstaged_files=$(git diff --name-status)
  local untracked=$(git ls-files --others --exclude-standard | head -n 30)
  local diff=$(git diff HEAD --no-color -- ":/" "${noisy[@]}" 2>/dev/null)
  (( ${#diff} > max_diff_chars )) && diff="${diff[1,$max_diff_chars]}"$'\n'"... (diff truncated)"

  # Kapan terakhir file diedit (dari mtime file yang berubah/untracked)
  local last_edit="no uncommitted file changes"
  local -a touched=(${(f)"$(git diff HEAD --name-only --diff-filter=ACMRT 2>/dev/null)"} ${(f)untracked})
  if (( ${#touched} )); then
    local newest=$(stat -f '%m %N' "${touched[@]}" 2>/dev/null | sort -n | tail -1)
    if [ -n "$newest" ]; then
      local ts=${newest%% *}
      last_edit="$(date -r $ts '+%Y-%m-%d %H:%M') ($(_gfb_ago $(( now - ts )))) on file ${newest#* }"
    fi
  fi

  # Kapan terakhir commit & kapan pindah ke branch ini
  local last_commit=""
  if git rev-parse --verify -q HEAD >/dev/null; then
    local cts=$(git log -1 --format=%ct)
    last_commit="$(date -r $cts '+%Y-%m-%d %H:%M') ($(_gfb_ago $(( now - cts ))))"
  fi
  local reflog=$(git reflog -n 15 --date=format:'%Y-%m-%d %H:%M' --format='%gd | %gs' 2>/dev/null)
  local stashes=$(git stash list -n 5 --format='%gd | %cd | %gs' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null)

  builtin cd -q "$__gfb_here"

  local prompt="You help a developer who forgot what they were working on in this git repository.
Using the context below, write a short recap IN INDONESIAN (casual but clear) so they can resume quickly.

Format exactly like this (plain text, no markdown headers, no code fences):
